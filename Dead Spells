local getMoved, resetMoved = makeDraggableFloat(dashFloatBtn, "DashFloatPos")

local lastDash = 0

performDash = function()
    local now = tick()
    if now - lastDash < 0.25 then return end
    lastDash = now

    if dashFloatStroke then
        setFloatStrokeActive(dashFloatStroke, true)
        task.delay(0.15, function()
            if dashFloatStroke then
                setFloatStrokeActive(dashFloatStroke, false)
            end
        end)
    end

    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local look = Camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local dir = flat.Magnitude > 0.01 and flat.Unit or hrp.CFrame.LookVector
    local power = tonumber(Config.DashPower) or 80

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = dir * power
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.P = 9e9
    bv.Parent = hrp

    pcall(function()
        hrp.AssemblyLinearVelocity = dir * power
        hrp.Velocity = dir * power
    end)

    task.delay(0.15, function()
        if bv and bv.Parent then bv:Destroy() end
    end)
end

dashFloatBtn.MouseButton1Click:Connect(function()
    if getMoved() then resetMoved() return end
    performDash()
end)

local isHealing = false
local function checkAndHeal(humanoid, char)
    if not Config.AutoHealEnabled or isHealing then return end
    if not humanoid or humanoid.Health <= 0 then return end
    
    local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
    if hpPercent <= Config.AutoHealThreshold then
        local potion = LocalPlayer.Backpack:FindFirstChild("HealingPotion") or char:FindFirstChild("HealingPotion") or LocalPlayer.Backpack:FindFirstChild("GreaterHealthPotion") or char:FindFirstChild("GreaterHealthPotion")
        if potion then
            isHealing = true
            if potion.Parent ~= char then
                humanoid:EquipTool(potion)
                task.wait(0.1)
            end
            potion:Activate()
            task.wait(1.5)
            isHealing = false
        end
    end
end

local function setupAutoHealForCharacter(char)
    local humanoid = char:WaitForChild("Humanoid")
    humanoid.HealthChanged:Connect(function()
        checkAndHeal(humanoid, char)
    end)
end

if LocalPlayer.Character then
    setupAutoHealForCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupAutoHealForCharacter)

