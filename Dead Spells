local function getItemColor(itemModel)
    local rarity = "Common"
    local priceValue = 0
    for _, child in pairs(itemModel:GetDescendants()) do
        if child:IsA("StringValue") then
            local valLower = string.lower(child.Value)
            if valLower == "common" or valLower == "uncommon" or valLower == "rare"
            or valLower == "epic" or valLower == "legendary" or valLower == "mythic" then
                rarity = child.Value
                break
            end
        elseif child:IsA("IntValue") or child:IsA("NumberValue") then
            if string.find(string.lower(child.Name), "value")
            or string.find(string.lower(child.Name), "price")
            or child.Name == "Gold" then
                priceValue = child.Value
            end
        end
    end
    local attrRarity = itemModel:GetAttribute("Rarity") or itemModel:GetAttribute("Tier")
    if attrRarity then rarity = tostring(attrRarity) end
    local attrValue = itemModel:GetAttribute("Value") or itemModel:GetAttribute("Price")
    if attrValue and type(attrValue) == "number" then priceValue = attrValue end
    local rarityLower = string.lower(rarity)
    if string.find(rarityLower, "uncommon")  then return Color3.fromRGB(50, 225, 50)
    elseif string.find(rarityLower, "rare")  then return Color3.fromRGB(0, 162, 255)
    elseif string.find(rarityLower, "epic")  then return Color3.fromRGB(162, 0, 255)
    elseif string.find(rarityLower, "legendary") then return Color3.fromRGB(255, 145, 0)
    elseif string.find(rarityLower, "mythic") then return Color3.fromRGB(255, 0, 50)
    end
    if priceValue > 0 then
        if priceValue >= 1000 then return Color3.fromRGB(255, 0, 50)
        elseif priceValue >= 500 then return Color3.fromRGB(255, 145, 0)
        elseif priceValue >= 100 then return Color3.fromRGB(162, 0, 255)
        elseif priceValue >= 50  then return Color3.fromRGB(0, 162, 255)
        end
    end
    local nameLower = string.lower(itemModel.Name)
    if string.find(nameLower, "gold") or string.find(nameLower, "coin") then
        return Color3.fromRGB(255, 215, 0)
    elseif string.find(nameLower, "magic") or string.find(nameLower, "potion") then
        return Color3.fromRGB(0, 255, 255)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function getItemRarity(itemModel)
    local rarity = "Common"
    for _, child in pairs(itemModel:GetDescendants()) do
        if child:IsA("StringValue") then
            local v = string.lower(child.Value)
            if v == "common" or v == "uncommon" or v == "rare"
            or v == "epic" or v == "legendary" or v == "mythic"
            or v == "mythical" or v == "transcended" then
                rarity = child.Value
                break
            end
        end
    end
    local attr = itemModel:GetAttribute("Rarity") or itemModel:GetAttribute("Tier")
    if attr then rarity = tostring(attr) end
    local r = string.lower(rarity)
    if string.find(r, "transcend") then return "Transcended"
    elseif string.find(r, "mythic")   then return "Mythical"
    elseif string.find(r, "legend")   then return "Legendary"
    elseif string.find(r, "epic")     then return "Epic"
    elseif string.find(r, "rare")     then return "Rare"
    elseif string.find(r, "uncommon") then return "Uncommon"
    end
    return "Common"
end

local function isItemEquipped(obj)
    local ancestor = obj.Parent
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function hasItemData(obj)
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("StringValue") then
            local valLower = string.lower(child.Value)
            if valLower == "common" or valLower == "uncommon" or valLower == "rare"
            or valLower == "epic" or valLower == "legendary" or valLower == "mythic"
            or valLower == "mythical" or valLower == "transcended"
            or valLower == "sellable" or valLower == "usable" or valLower == "valuable"
            or valLower == "fuel" or valLower == "tool" or valLower == "junk"
            or valLower == "potion" or valLower == "weapon" or valLower == "armor" then
                return true
            end
        elseif child:IsA("IntValue") or child:IsA("NumberValue") then
            local nLower = string.lower(child.Name)
            if string.find(nLower, "price") or string.find(nLower, "value") or child.Name == "Gold" or child.Name == "Mana" then
                if child.Value > 0 then return true end
            end
        end
    end
    if obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or obj:GetAttribute("Price") or obj:GetAttribute("Value") then
        return true
    end
    return false
end

local function isValidDroppedItem(obj)
    if not (obj:IsA("Model") or obj:IsA("Tool")) then return false end
    if not obj.Parent then return false end
    if isItemEquipped(obj) then return false end
    if targetItems[obj.Name] then return false end
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder and obj:IsDescendantOf(mapFolder) then return false end
    if obj:FindFirstChildOfClass("Humanoid") then return false end

    if hasItemData(obj) then
        local size = obj:IsA("Model") and obj:GetExtentsSize() or (obj:IsA("BasePart") and obj.Size) or Vector3.new(2, 2, 2)
        if size.X < 35 and size.Y < 35 and size.Z < 35 then
