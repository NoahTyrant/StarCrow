local function getDashKey()
    local k = Config.DashKeybind or "Q"
    if typeof(k) == "EnumItem" then return k end
    local name = tostring(k):gsub("Enum%.KeyCode%.", "")
    return Enum.KeyCode[name] or Enum.KeyCode.Q
end

