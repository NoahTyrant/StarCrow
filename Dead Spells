    if n:find("gold")        then return Color3.fromRGB(255, 215, 0)
    elseif n:find("meteor")  then return Color3.fromRGB(255, 80, 20)
    elseif n:find("mythril") then return Color3.fromRGB(160, 80, 255)
    elseif n:find("copper")  then return Color3.fromRGB(205, 127, 50)
    elseif n:find("iron")    then return Color3.fromRGB(230, 230, 255)
    elseif n:find("silver")  then return Color3.fromRGB(210, 210, 255)
    elseif n:find("mana")    then return Color3.fromRGB(80, 80, 255)
    elseif n:find("yellow")  then return Color3.fromRGB(255, 230, 0)
    elseif n:find("red")     then return Color3.fromRGB(255, 60, 60)
    elseif n:find("green")   then return Color3.fromRGB(0, 220, 80)
    elseif n:find("blue")    then return Color3.fromRGB(0, 150, 255)
    elseif n:find("purple")  then return Color3.fromRGB(180, 0, 255)
    elseif n:find("crystal") then return Color3.fromRGB(100, 200, 255)
