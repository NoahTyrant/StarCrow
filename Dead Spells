local function bringItemToPlayer(item, targetCFrame, camPos)
    local targetPart = (item:IsA("Model") or item:IsA("Tool")) and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
    if targetPart and (camPos - targetPart.Position).Magnitude <= 1000 then
        if item:IsA("Model") or item:IsA("Tool") then
            item:PivotTo(targetCFrame)
            for _, p in ipairs(item:GetChildren()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end
            end
        elseif item:IsA("BasePart") then
            item.CFrame = targetCFrame
            item.CanCollide = false
            item.AssemblyLinearVelocity = Vector3.zero
            item.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

