local function getPartCountdown()
    local altar = workspace:FindFirstChild("AltarAndForcefield", true)
    if altar then
        for _, desc in ipairs(altar:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                local txt = desc.Text
                local m, s = string.match(txt, "(%d+)%s*:%s*(%d+)")
                if m and s then
                    return tonumber(m) * 60 + tonumber(s)
                end
                local m2 = string.match(txt, "(%d+)%s*min")
                local s2 = string.match(txt, "(%d+)%s*s")
                if m2 or s2 then
                    return (tonumber(m2) or 0) * 60 + (tonumber(s2) or 0)
                end
            end
        end
    end
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            for _, lbl in ipairs(desc:GetDescendants()) do
                if lbl:IsA("TextLabel") and lbl.Text ~= "" then
                    local m, s = string.match(lbl.Text, "(%d+)%s*:%s*(%d+)")
                    if m and s then
                        local sec = tonumber(m) * 60 + tonumber(s)
                        if sec <= 300 and sec > 0 then
                            return sec
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function findNocturneCastellan()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") then
            local clean = string.gsub(string.lower(v.Name), "%s+", "")
            if clean == "nocturnecastellan" then
                local hum = v:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    return v
                end
            end
        end
    end
    return nil
end

local function killBossIfAlive(boss, restoreStatus)
    if not boss then return end
    statusText = "NocturneCastellan"
    while isPlayerAlive() and boss.Parent do
        if tpWinWaitStartTick and (tpWinWaitStartTick + Config.TpWinMinutes * 60) - tick() <= 0 then
            break
        end
        local hum = boss:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            break
        end
        bringBoss(boss, CFrame.new(0, -35, 0))
        task.wait(0.05)
    end
    statusText = restoreStatus
end

task.spawn(function()
    while not isPlayerAlive() or not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) do
        task.wait(0.1)
    end
    statusText = "Teleporting..."
    local initialCF = CFrame.new(1.50, 127.61, 46969.94, 1.00, 0.00, 0.03, -0.00, 1.00, -0.07, -0.03, 0.07, 1.00)
    requestStreamTeleport(initialCF)
    currentHoverCFrame = initialCF
    statusText = "Safe Zone"
    task.wait(1.5)

    statusText = "Waiting Forcefield"
    local forcePart = nil
    while not forcePart do
        if not isPlayerAlive() then return end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "Forcefield" and obj:IsA("BasePart") then
                forcePart = obj
                break
            end
            if obj:IsA("ProximityPrompt") and string.find(string.lower(obj.ActionText), "break") then
                forcePart = obj.Parent
                break
            end
        end
        task.wait(0.4)
    end

    statusText = "Break & Activate"
    currentHoverCFrame = CFrame.new(0.0, 4.0, 47077.1)
    task.wait(0.5)

    for i = 1, 2 do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local act = string.lower(obj.ActionText)
                local ob = string.lower(obj.ObjectText)
                if string.find(act, "break") or string.find(ob, "force") or string.find(act, "activate") or string.find(ob, "relic") then
                    triggerPrompt(obj)
                end
            end
        end
        task.wait(0.5)
    end

    statusText = "Safe Zone"
    local safeZoneCFrame = CFrame.new(1.50, 127.61, 46969.94, 1.00, 0.00, 0.03, -0.00, 1.00, -0.07, -0.03, 0.07, 1.00)
    currentHoverCFrame = safeZoneCFrame

    local targetCountdown = 180
    local timerStart = tick()
    while true do
        if not isPlayerAlive() then return end
        local partTime = getPartCountdown()
        if partTime then
            targetCountdown = partTime
            timerStart = tick()
        else
            local elapsed = tick() - timerStart
            targetCountdown = math.max(0, targetCountdown - elapsed)
            timerStart = tick()
        end

        if targetCountdown <= 0 then
            break
        end

        killBossIfAlive(findNocturneCastellan(), "Safe Zone")
        task.wait(0.2)
    end

    if Config.TpWinMinutes > 0 then
        tpWinWaitStartTick = tick()
        statusText = "Waiting TP Win"
        while isPlayerAlive() do
            if (tpWinWaitStartTick + Config.TpWinMinutes * 60) - tick() <= 0 then
                break
            end
            killBossIfAlive(findNocturneCastellan(), "Waiting TP Win")
            task.wait(0.2)
        end
        tpWinWaitStartTick = nil
        if not isPlayerAlive() then return end
    end

    statusText = "Move On"
    local moveOnCF = CFrame.new(5.10, 3.00, 47110.42, -0.94, -0.00, 0.33, -0.00, 1.00, -0.00, -0.33, -0.00, -0.94)
    requestStreamTeleport(moveOnCF)
    currentHoverCFrame = moveOnCF

    local lastTouchTick = 0
    local lastClickTick = 0
    while isPlayerAlive() do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local moveOnFound = false

        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, v in ipairs(pg:GetDescendants()) do
                if (v:IsA("TextLabel") or v:IsA("TextButton")) and isGuiElementVisible(v) then
                    local t = string.lower(v.Text or "")
                    if string.find(t, "move on") then
                        moveOnFound = true
                        if tick() - lastClickTick >= 0.5 then
                            lastClickTick = tick()
                            local btn = findButtonForLabel(v)
                            clickGuiElement(btn, v)
                        end
                        break
                    end
                end
            end
        end

        if not moveOnFound and hrp and tick() - lastTouchTick >= 1 then
            lastTouchTick = tick()
            pcall(function()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and (not char or not obj:IsDescendantOf(char)) and (obj.Position - moveOnCF.Position).Magnitude < 15 then
                        if firetouchinterest then
                            firetouchinterest(hrp, obj, 0)
                            firetouchinterest(hrp, obj, 1)
                        end
                    elseif obj:IsA("ProximityPrompt") then
                        local parentPart = obj.Parent
                        if parentPart and parentPart:IsA("BasePart") and (parentPart.Position - moveOnCF.Position).Magnitude < 15 then
                            triggerPrompt(obj)
                        end
                    end
                end
            end)
        end

        task.wait(0.2)
    end
end)

