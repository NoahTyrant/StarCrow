local function updateTimerLabel()
    local remaining = math.max(0, math.floor(nextResetTick - tick()))
    local mins = math.floor(remaining / 60)
    local secs = remaining % 60
    if isResetting then
        ResetTimerLabel.Text = "Auto Reset..."
    else
        ResetTimerLabel.Text = string.format("Reset in: %02d:%02d", mins, secs)
    end
end

local function updateTpWinLabel()
    if tpWinWaitStartTick then
        local remaining = math.max(0, math.floor((tpWinWaitStartTick + Config.TpWinMinutes * 60) - tick()))
        if Config.TpWinMinutes <= 0 or remaining <= 0 then
            TpWinTimerLabel.Text = "TP Win: 0s"
        else
            local mins = math.floor(remaining / 60)
            local secs = remaining % 60
            TpWinTimerLabel.Text = string.format("TP Win: %02d:%02d", mins, secs)
        end
    else
        if Config.TpWinMinutes <= 0 then
            TpWinTimerLabel.Text = "TP Win: 0s"
        else
            TpWinTimerLabel.Text = string.format("TP Win: %02d:00", Config.TpWinMinutes)
        end
    end
end

