local function isPlayerAlive()
    if isResetting then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if char:GetAttribute("Downed") or char:GetAttribute("Knocked") or char:GetAttribute("Dead") then return false end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled then
                for _, t in ipairs(g:GetDescendants()) do
                    if (t:IsA("TextLabel") or t:IsA("TextButton")) and string.find(string.lower(t.Text), "revive") then
                        return false
                    end
                end
            end
        end
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("ProximityPrompt") and string.find(string.lower(p.ActionText), "revive") then
            return false
        end
    end
    return true
end

