local function safeLoad(url)
    local env = (getgenv and getgenv()) or _G
    pcall(function()
        if restorefunction then
            local targets = {loadstring, game.HttpGet, game.HttpGetAsync, env.request, env.http_request, (syn and syn.request)}
            for _, fn in pairs(targets) do
                if type(fn) == "function" then pcall(restorefunction, fn) end
            end
        end
    end)
    local dumpFunctions = {"setclipboard", "toclipboard", "setrbxclipboard", "writefile", "appendfile", "print", "warn", "rconsoleprint", "rconsoleinfo", "rconsolewarn", "rconsoleerr", "consoleprint"}
    local backupFuncs = {}
    local isProtectedPhase = true
    for _, name in ipairs(dumpFunctions) do
        local orig = env[name]
        if type(orig) == "function" then
            backupFuncs[name] = orig
            env[name] = function(...)
                if isProtectedPhase then return nil end
                return orig(...)
            end
            pcall(function()
                if hookfunction and newcclosure then
                    hookfunction(orig, newcclosure(function(...)
                        if isProtectedPhase then return nil end
                        return orig(...)
                    end))
                end
            end)
        end
    end
    local ok, rawCode = pcall(function() return game.HttpGet(game, url) end)
    local compiledFunc = nil
    if ok and type(rawCode) == "string" and #rawCode > 0 then
        compiledFunc = loadstring(rawCode)
        rawCode = nil
    end
    isProtectedPhase = false
    for name, orig in pairs(backupFuncs) do
        env[name] = orig
        pcall(function() if restorefunction then restorefunction(orig) end end)
    end
    pcall(function() if backupFuncs["setclipboard"] then backupFuncs["setclipboard"]("") end end)
    if type(compiledFunc) == "function" then
        task.spawn(compiledFunc)
        compiledFunc = nil
    end
end

