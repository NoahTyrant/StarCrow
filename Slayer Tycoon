useToolAction = function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    
    local toolToUse = nil
    if Config.CustomToolName and Config.CustomToolName ~= "" then
        local lowerName = Config.CustomToolName:lower()
        if char then
            for _, c in ipairs(char:GetChildren()) do
                if c:IsA("Tool") and c.Name:lower():find(lowerName) then
                    toolToUse = c
                    break
                end
            end
        end
        if not toolToUse and bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") and c.Name:lower():find(lowerName) then
                    toolToUse = c
                    break
                end
            end
        end
    end
    
    if not toolToUse then
        if char then
            toolToUse = char:FindFirstChildOfClass("Tool")
        end
        if not toolToUse and bp then
            toolToUse = bp:FindFirstChildOfClass("Tool")
        end
    end
    
    if toolToUse and char and hum then
        if toolToUse.Parent ~= char then
            hum:EquipTool(toolToUse)
            toolToUse.Parent = char
        end
        task.delay(0.04, function()
            pcall(function() toolToUse:Activate() end)
            for _, desc in ipairs(toolToUse:GetDescendants()) do
                if desc:IsA("RemoteEvent") then
                    pcall(function() desc:FireServer() end)
                end
            end
        end)
    end
    
    if SC_toolFloatStroke then
        setFloatStrokeActive(SC_toolFloatStroke, true)
        task.delay(0.2, function()
            if SC_toolFloatStroke then
                setFloatStrokeActive(SC_toolFloatStroke, false)
            end
        end)
    end
end

