local flyConnection = nil

startFly = function()
    stopFly()
    local char = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    local realChar = LocalPlayer.Character
    local realHum = realChar and realChar:FindFirstChildOfClass("Humanoid")
    if realHum then
        realHum.PlatformStand = true
        for _, t in ipairs(realHum:GetPlayingAnimationTracks()) do
            t:Stop()
        end
    end
    humanoid.PlatformStand = true
    for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
        t:Stop()
    end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 1e7
    bg.D = 12000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    flyConnection = RunService.RenderStepped:Connect(function()
        local currentTarget = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
        local targetHRP = currentTarget and currentTarget:FindFirstChild("HumanoidRootPart")
        local rc = LocalPlayer.Character
        local rHum = rc and rc:FindFirstChildOfClass("Humanoid")
        local tHum = currentTarget and currentTarget:FindFirstChildOfClass("Humanoid")
        if not targetHRP or not bv.Parent then return end

        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        local md = (rHum and rHum.MoveDirection) or (tHum and tHum.MoveDirection) or Vector3.zero

        if md.Magnitude > 0 then
            local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if flatLook.Magnitude > 0.01 and flatRight.Magnitude > 0.01 then
                move += cam.CFrame.LookVector * md:Dot(flatLook.Unit)
                move += cam.CFrame.RightVector * md:Dot(flatRight.Unit)
            end
        end

        if move.Magnitude > 0 then
            move = move.Unit
        end
        bv.Velocity = move * Config.FlySpeed * 50
        bg.CFrame = CFrame.lookAt(targetHRP.Position, targetHRP.Position + cam.CFrame.LookVector, Vector3.new(0, 1, 0))
    end)
end

stopFly = function()
    local char = LocalPlayer.Character
    for _, c in ipairs({char, fakeCharacter}) do
        if c then
            local hrp = c:FindFirstChild("HumanoidRootPart")
            local humanoid = c:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.PlatformStand = false
            end
            if hrp then
                local bv = hrp:FindFirstChild("FlyVelocity")
                local bg = hrp:FindFirstChild("FlyGyro")
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
            end
        end
    end

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
end

