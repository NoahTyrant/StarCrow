local function isTreeValid(part)
    if not part or not part.Parent or part.Transparency >= 0.9 then return false end

    local p = part
    while p and p ~= workspace do
        local n = p.Name:lower()
        if n:find("wisteria") then
            return false
        end
        p = p.Parent
    end

    local model = part.Parent
    if model:IsA("Model") then
        local wood = model:FindFirstChild("Wood")
        if wood and wood:IsA("BasePart") and wood.Transparency >= 0.9 then
            return false
        end
    end
    if math.abs(part.CFrame.UpVector.Y) < 0.65 then
        return false
    end
    return true
end

local function isRockValid(part)
    if not part or not part.Parent or part.Transparency >= 0.9 or part.Size.Magnitude < 1.5 then
        return false
    end
    return true
end

local function getValidFarmTarget(hitPartName)
    local myChar = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local closest = nil
    local minDist = math.huge
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Name == hitPartName then
            local valid = (hitPartName == "WoodHitPart" and isTreeValid(desc)) or (hitPartName == "RockHitPart" and isRockValid(desc))
            if valid then
                local dist = (myHRP.Position - desc.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = desc
                end
            end
        end
    end
    return closest
end

