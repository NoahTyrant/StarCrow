local function updateESP()
    if not Config.ESPEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") then
                local hum, head = char.Humanoid, char.Head
                local esp = head:FindFirstChild("StarCrowESP")

                if hum.Health > 0 then
                    if not esp then
                        esp = Instance.new("BillboardGui")
                        esp.Name = "StarCrowESP"
                        esp.Adornee = head
                        esp.Size = UDim2.new(0, 300, 0, 42)
                        esp.StudsOffset = Vector3.new(0, 1.2, 0)
                        esp.AlwaysOnTop = true
                        local text = Instance.new("TextLabel", esp)
                        text.Name = "NameText"
                        text.Size = UDim2.new(1, 0, 1, 0)
                        text.BackgroundTransparency = 1
                        text.TextSize = 12
                        text.Font = Enum.Font.GothamBold
                        text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        text.RichText = true
                        esp.Parent = head
                    end
                    local hpVal = math.floor(hum.Health)
                    local pct = (hum.Health / math.max(hum.MaxHealth, 1)) * 100
                    local tc = player.Team and player.Team.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                    local hpColor = pct > 70 and "rgb(0, 255, 127)" or pct > 30 and "rgb(255, 200, 0)" or "rgb(255, 50, 50)"
                    esp.NameText.Text = string.format('<font color="rgb(%d,%d,%d)">%s</font>\n<font color="%s">%d HP</font>', tc.R * 255, tc.G * 255, tc.B * 255, player.DisplayName, hpColor, hpVal)
                else
                    if esp then
                        esp:Destroy()
                    end
                end
            end
        end
    end
end

