    Callback = function()
        if Config.KeybindsEnabled then
            toggleAimlock()
        end
    end,
    ChangedCallback = function(NewKey)
        local keyCode = typeof(NewKey) == "EnumItem" and NewKey or Enum.KeyCode[tostring(NewKey):gsub("Enum%.KeyCode%.", "")]
