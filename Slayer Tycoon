            if item ~= "" and (pName:find(item, 1, true) or pDisplay:find(item, 1, true)) then
                return true
            end
        end
    end
    return false
end

local function updateAimlockVisual()
    local myChar = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local rad = (Config.AimlockDistance or 40) * 2

    if Config.AimlockEnabled and hrp then
        if not aimlockVisualPart or not aimlockVisualPart.Parent then
            aimlockVisualPart = Instance.new("Part")
            aimlockVisualPart.Name = "StarCrowAimlockZone"
            aimlockVisualPart.Shape = Enum.PartType.Ball
            aimlockVisualPart.Material = Enum.Material.ForceField
            aimlockVisualPart.Color = Color3.fromRGB(160, 35, 255)
            aimlockVisualPart.Transparency = 0.74
            aimlockVisualPart.CanCollide = false
            aimlockVisualPart.CanQuery = false
            aimlockVisualPart.CanTouch = false
            aimlockVisualPart.CastShadow = false
            aimlockVisualPart.Anchored = true
            aimlockVisualPart.Parent = workspace
        end
        aimlockVisualPart.Size = Vector3.new(rad, rad, rad)
        aimlockVisualPart.CFrame = hrp.CFrame
    else
        if aimlockVisualPart then
            aimlockVisualPart:Destroy()
            aimlockVisualPart = nil
        end
    end
end

local function getNearestAimlockTarget()
    local myChar = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest = nil
    local minDist = Config.AimlockDistance or 40
    for _, p in ipairs(Players:GetPlayers()) do
        if not isPlayerIgnored(p) and p.Character then
            local thrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if thrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - thrp.Position).Magnitude
                if dist <= minDist then
                    minDist = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

