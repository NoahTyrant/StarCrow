    if walkConn then
        walkConn:Disconnect()
    end

    myHRP.CFrame = origCF + movedOffset
    if hum and hum.MoveDirection.Magnitude > 0 then
        myHRP.AssemblyLinearVelocity = hum.MoveDirection * hum.WalkSpeed
    end

    if workspace.CurrentCamera then
        if origCamCF then
            workspace.CurrentCamera.CameraType = origCamType or Enum.CameraType.Custom
        end
