local function collectDrop(dropPart, prompt)
    local myChar = (InvisState.isInvisible and fakeCharacter) or LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP or not dropPart or not dropPart.Parent then return end

    local origCF = myHRP.CFrame
    local origCamCF = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
    local origCamType = workspace.CurrentCamera and workspace.CurrentCamera.CameraType
    local movedOffset = Vector3.zero

    local walkConn = RunService.Heartbeat:Connect(function(dt)
        local h = myChar:FindFirstChildOfClass("Humanoid")
        if h and h.MoveDirection.Magnitude > 0 then
            movedOffset = movedOffset + (h.MoveDirection * (h.WalkSpeed * dt))
        end
        if workspace.CurrentCamera and origCamCF then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
            workspace.CurrentCamera.CFrame = origCamCF + movedOffset
        end
    end)

    myHRP.AssemblyLinearVelocity = Vector3.zero
    myHRP.AssemblyAngularVelocity = Vector3.zero
    myHRP.CFrame = dropPart.CFrame

    if prompt and fireproximityprompt then
        pcall(function() fireproximityprompt(prompt) end)
    end
    if firetouchinterest then
        pcall(function()
            firetouchinterest(myHRP, dropPart, 0)
            firetouchinterest(myHRP, dropPart, 1)
        end)
    end

    local startWait = tick()
    while dropPart and dropPart.Parent and tick() - startWait < 0.25 do
        if prompt and fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
        end
        task.wait(0.03)
