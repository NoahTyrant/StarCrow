local function updateTimerLabel()
    local remaining = math.max(0, math.floor(nextResetTick - tick()))
    local mins = math.floor(remaining / 60)
    local secs = remaining % 60
    if isResetting then
        ResetTimerLabel.Text = "Auto Reset..."
    else
        ResetTimerLabel.Text = string.format("Reset in: %02d:%02d", mins, secs)
    end
end

MinusBtn.MouseButton1Click:Connect(function()
    Config.AutoResetMinutes = math.max(1, Config.AutoResetMinutes - 1)
    SaveConfig()
    nextResetTick = tick() + (Config.AutoResetMinutes * 60)
    updateTimerLabel()
end)

PlusBtn.MouseButton1Click:Connect(function()
    Config.AutoResetMinutes = Config.AutoResetMinutes + 1
    SaveConfig()
    nextResetTick = tick() + (Config.AutoResetMinutes * 60)
    updateTimerLabel()
end)

task.spawn(function()
    while true do
        task.wait(1)
        updateTimerLabel()
    end
end)

