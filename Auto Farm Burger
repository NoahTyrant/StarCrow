local function hookBurgerNotification(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local function checkText()
            local text = string.lower(obj.Text or "")
            if string.find(text, "burger") and (string.find(text, "gain") or string.find(text, "+")) then
                local gain = string.match(text, "%+(%d+)")
                local num = tonumber(gain) or 1
                collectedBurgerCount = collectedBurgerCount + num
                if updateBurgerCounterGui then
                    updateBurgerCounterGui()
                end
            end
        end
        checkText()
        obj:GetPropertyChangedSignal("Text"):Connect(checkText)
    end
end

local function hookGuiContainer(container)
    if not container then return end
    for _, desc in ipairs(container:GetDescendants()) do
        hookBurgerNotification(desc)
    end
    container.DescendantAdded:Connect(hookBurgerNotification)
end

