local function getNearbyBurgerCount()
    local camPos = Camera.CFrame.Position
    local count = 0
    for i = #itemQueue, 1, -1 do
        local item = itemQueue[i]
        if not isValidBurger(item) then
            table.remove(itemQueue, i)
        else
            local targetPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
            if targetPart and (camPos - targetPart.Position).Magnitude <= 1000 then
                count = count + 1
            end
        end
    end
    return count
end

local function waitForBurgersCollected(maxWait)
    local timeout = maxWait or 5
    local start = tick()
    while tick() - start < timeout do
        if getNearbyBurgerCount() == 0 then
            break
        end
        task.wait(0.2)
    end
    task.wait(0.3)
end

