task.spawn(function()
    while task.wait(0.1) do
        if not Config.AutoFarmEnabled then
            hoverPos = nil
            continue
        end

        local char = LocalPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end

        if autoFarmStartTime > 0 and tick() - autoFarmStartTime >= Config.AutoResetMinutes * 60 then
            pcall(function()
                local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                for _ = 1, 3 do
                    Remotes.Reset.fireServer()
                    task.wait(1)
                end
            end)
            hoverPos = nil
            visited = false
            engaged = false
            currentIdx = 1
            autoFarmStartTime = tick()
            continue
        end

        if hum.Health <= 0 then
            hoverPos = nil
            visited = false
            engaged = false
            currentIdx = 1
            task.wait(1)
            continue
        end

        if currentIdx <= #bosses then
            local info = bosses[currentIdx]
            local targetBoss = cachedBosses[info.n]

            if targetBoss then
                local bHrp = targetBoss:FindFirstChild("HumanoidRootPart")
                local bHum = targetBoss:FindFirstChildOfClass("Humanoid")

                if bHrp and bHum and bHum.Health > 0 then
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    engaged = true
                    bHrp.CFrame = CFrame.new(info.pos.Position)
                    bHrp.Velocity = Vector3.new(0, 0, 0)
                    hoverPos = CFrame.lookAt(info.pos.Position + Vector3.new(0, 15, 0), info.pos.Position)
                elseif bHum and bHum.Health <= 0 then
                    task.wait(3)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                end
            else
                if engaged then
                    task.wait(3)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                else
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    hoverPos = CFrame.new(info.pos.Position + Vector3.new(0, 15, 0))
                end
            end
        else
            hoverPos = nil
            currentIdx = 1
            autoFarmStartTime = tick()
            task.spawn(function()
                pcall(function()
                    local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                    Remotes.Reset.fireServer()
                end)
            end)
            task.wait(3)
        end
    end
end)

