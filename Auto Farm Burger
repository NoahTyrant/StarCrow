local function forceResetUntilDead()
    isResetting = true
    hoverPos = nil
    local dead = false
    local startTime = tick()
    while tick() - startTime < 10 do
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then
            dead = true
            break
        end
        pcall(function()
            local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
            Remotes.Reset.fireServer()
        end)
        task.wait(0.5)
        local cAfter = LocalPlayer.Character
        local hAfter = cAfter and cAfter:FindFirstChildOfClass("Humanoid")
        if not hAfter or hAfter.Health <= 0 then
            dead = true
            break
        end
    end
    if not dead then
        while true do
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then break end
            pcall(function()
                local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
                Remotes.Reset.fireServer()
            end)
            task.wait(0.5)
        end
    end
    repeat task.wait(0.2) until LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0 and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    task.wait(1)
    isResetting = false
end

local function executeResetCycle(count)
    local totalResets = count or 3
    isResetting = true
    hoverPos = nil
    for i = 1, totalResets do
        forceResetUntilDead()
        if i < totalResets then
            task.wait(1.5)
        end
    end
    nextResetTick = tick() + (Config.AutoResetMinutes * 60)
    autoFarmStartTime = tick()
    isResetting = false
end

task.spawn(function()
    while task.wait(0.1) do
        if not Config.AutoFarmEnabled then
            hoverPos = nil
            continue
        end

        if isResetting then
            hoverPos = nil
            task.wait(0.2)
            continue
        end

        local char = LocalPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end

        if tick() >= nextResetTick then
            waitForBurgersCollected(3)
            hoverPos = nil
            currentIdx = 1
            executeResetCycle(3)
            task.wait(2)
            continue
        end

        if hum.Health <= 0 then
            hoverPos = nil
            visited = false
            engaged = false
            currentIdx = 1
            task.wait(1)
            continue
        end

        if currentIdx <= #bosses then
            local info = bosses[currentIdx]
            local targetBoss = cachedBosses[info.n]

            if targetBoss then
                local bHrp = targetBoss:FindFirstChild("HumanoidRootPart")
                local bHum = targetBoss:FindFirstChildOfClass("Humanoid")

                if bHrp and bHum and bHum.Health > 0 then
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    engaged = true
                    bHrp.CFrame = CFrame.new(info.pos.Position)
                    bHrp.Velocity = Vector3.new(0, 0, 0)
                    hoverPos = CFrame.lookAt(info.pos.Position + Vector3.new(0, 15, 0), info.pos.Position)
                elseif bHum and bHum.Health <= 0 then
                    waitForBurgersCollected(4)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                end
            else
                if engaged then
                    waitForBurgersCollected(4)
                    engaged = false
                    visited = false
                    hoverPos = nil
                    currentIdx = currentIdx + 1
                else
                    if not visited then
                        hoverPos = nil
                        hrp.CFrame = info.pos
                        hrp.Anchored = true
                        task.wait(2)
                        hrp.Anchored = false
                        visited = true
                    end
                    hoverPos = CFrame.new(info.pos.Position + Vector3.new(0, 15, 0))
                end
            end
        else
            waitForBurgersCollected(5)
            hoverPos = nil
            currentIdx = 1
            executeResetCycle(3)
            task.wait(3)
        end
    end
end)

