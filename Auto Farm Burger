local function updateResetTime(newVal)
    local val = tonumber(newVal)
    if val and val > 0 then
        Config.AutoResetMinutes = math.floor(val)
        TimeBox.Text = tostring(Config.AutoResetMinutes)
        if getgenv then getgenv().AutoResetMinute = Config.AutoResetMinutes end
        _G.AutoResetMinute = Config.AutoResetMinutes
        if writefile then
            pcall(function()
                if makefolder and isfolder and not isfolder("StarCrowHub") then
                    makefolder("StarCrowHub")
                end
                writefile(resetFile, tostring(Config.AutoResetMinutes))
            end)
        end
    else
        TimeBox.Text = tostring(Config.AutoResetMinutes)
    end
end

