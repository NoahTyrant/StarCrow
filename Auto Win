local function findSafeArenaPoint(currentPos)
    local activeMeteors = {}
    for _, m in ipairs(workspace:GetChildren()) do
        if m.Name == "Meteor" then
            local p = m:IsA("BasePart") and m or (m:IsA("Model") and (m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)))
            if p then
                table.insert(activeMeteors, Vector3.new(p.Position.X, 0, p.Position.Z))
            end
        end
    end

    local flatCurrent = Vector3.new(currentPos.X, 0, currentPos.Z)
    local isThreatened = false
    for _, mPos in ipairs(activeMeteors) do
        if (flatCurrent - mPos).Magnitude < 25 then
            isThreatened = true
            break
        end
    end
    if not isThreatened then return nil end

    local bestPos = nil
    local maxMinDist = -1
    for angle = 0, 330, 30 do
        local rad = math.rad(angle)
        local candX = currentPos.X + math.cos(rad) * 25
        local candZ = currentPos.Z + math.sin(rad) * 25
        local flatCand = Vector3.new(candX, 0, candZ)
        local nearest = math.huge
        for _, mPos in ipairs(activeMeteors) do
            local d = (flatCand - mPos).Magnitude
            if d < nearest then nearest = d end
        end
        if nearest > maxMinDist then
            maxMinDist = nearest
            bestPos = Vector3.new(candX, currentPos.Y, candZ)
        end
    end

    return bestPos
end

