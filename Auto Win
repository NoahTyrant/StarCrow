local function getPartCountdown()
    local altar = workspace:FindFirstChild("AltarAndForcefield", true)
    if altar then
        for _, desc in ipairs(altar:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                local txt = desc.Text
                local m, s = string.match(txt, "(%d+)%s*:%s*(%d+)")
                if m and s then
                    return tonumber(m) * 60 + tonumber(s)
                end
                local m2 = string.match(txt, "(%d+)%s*min")
                local s2 = string.match(txt, "(%d+)%s*s")
                if m2 or s2 then
                    return (tonumber(m2) or 0) * 60 + (tonumber(s2) or 0)
                end
            end
        end
    end
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            for _, lbl in ipairs(desc:GetDescendants()) do
                if lbl:IsA("TextLabel") and lbl.Text ~= "" then
                    local m, s = string.match(lbl.Text, "(%d+)%s*:%s*(%d+)")
                    if m and s then
                        local sec = tonumber(m) * 60 + tonumber(s)
                        if sec <= 300 and sec > 0 then
                            return sec
                        end
                    end
                end
            end
        end
    end
    return nil
end

