local function isItemEquipped(obj)
    local ancestor = obj.Parent
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function isValidBurger(obj)
    if not (obj and obj.Parent and targetItems[obj.Name]) then return false end
    if obj:FindFirstAncestor("Spawners") or obj:FindFirstAncestor("Spawner") then return false end
    if obj:FindFirstAncestor("FloatingCastle") then return false end
    local map = workspace:FindFirstChild("Map")
    if map and obj:IsDescendantOf(map) then return false end
    if isItemEquipped(obj) then return false end
    local p = obj.Parent
    if p and string.find(string.lower(p.Name), "spawn") then return false end
    return true
end

