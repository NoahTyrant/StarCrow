        for _, desc in ipairs(pgui:GetDescendants()) do
            if desc.Name == "Punch" and desc:IsA("GuiObject") and desc.Parent and desc.Parent.Name == "TouchControl" then
                punchState.cachedBtn = desc
                return desc
            end
        end
    end
    return nil
end

