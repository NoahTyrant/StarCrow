                task.wait(0.1)
            end
        end

        restoreState()

        if not Config.AutoCollectCash then break end
        for _ = 1, 8 do
            if not Config.AutoCollectCash then break end
            task.wait(0.2)
        end
    end

    if stopAutoCollectCash then
        pcall(stopAutoCollectCash)
        stopAutoCollectCash = nil
    end
    autoCollectCashRunning = false
end

local weaponConfigs = {}
local origWeaponStats = {}

local function registerWeaponConfig(name, stats)
    if type(stats) ~= "table" then return end
    if not weaponConfigs[name] then
        weaponConfigs[name] = stats
        origWeaponStats[name] = {
            magCapacity = stats.magCapacity,
            infiniteAmmo = stats.infiniteAmmo,
            maxRpm = stats.maxRpm,
            mode = stats.mode,
            inaccuracy = stats.inaccuracy,
            delay = stats.delay,
            ammoPerSecond = stats.ammoPerSecond,
            raycastPerSecond = stats.raycastPerSecond,
            grenadeSpeed = stats.grenadeSpeed,
            rocketSpeed = stats.rocketSpeed,
            chargeDuration = stats.chargeDuration,
            throwSpeed = stats.throwSpeed,
            throwAngle = stats.throwAngle,
            recoilPattern = stats.recoilPattern and {
                pushback = stats.recoilPattern.pushback,
                lift = stats.recoilPattern.lift,
                shake = stats.recoilPattern.shake,
                cameraLift = stats.recoilPattern.cameraLift
            }
        }
    end
end

local function applyWeaponMods(name, stats)
    if type(stats) ~= "table" then return end
    local orig = origWeaponStats[name] or stats
    if Config.InfAmmo then
        stats.magCapacity = 99999
        stats.infiniteAmmo = true
        if stats.ammoPerSecond ~= nil then
            stats.ammoPerSecond = 0
        end
    elseif orig.magCapacity ~= nil then
        stats.magCapacity = orig.magCapacity
        stats.infiniteAmmo = orig.infiniteAmmo
        if stats.ammoPerSecond ~= nil then
            stats.ammoPerSecond = orig.ammoPerSecond
        end
    end
    if Config.FastFire then
        stats.maxRpm = 1200
        stats.mode = "auto"
        if stats.delay ~= nil then
            stats.delay = 0.001
        end
        if stats.raycastPerSecond ~= nil then
            stats.raycastPerSecond = 100
        end
        if stats.grenadeSpeed ~= nil then
            stats.grenadeSpeed = 300
        end
        if stats.rocketSpeed ~= nil then
            stats.rocketSpeed = 300
        end
        if stats.chargeDuration ~= nil then
            stats.chargeDuration = 0.001
        end
        if stats.throwSpeed ~= nil then
            stats.throwSpeed = 300
        end
    elseif orig.maxRpm ~= nil then
        stats.maxRpm = orig.maxRpm
        stats.mode = orig.mode
        if stats.delay ~= nil then
            stats.delay = orig.delay
        end
        if stats.raycastPerSecond ~= nil then
            stats.raycastPerSecond = orig.raycastPerSecond
        end
        if stats.grenadeSpeed ~= nil then
            stats.grenadeSpeed = orig.grenadeSpeed
        end
        if stats.rocketSpeed ~= nil then
            stats.rocketSpeed = orig.rocketSpeed
        end
        if stats.chargeDuration ~= nil then
            stats.chargeDuration = orig.chargeDuration
        end
        if stats.throwSpeed ~= nil then
            stats.throwSpeed = orig.throwSpeed
        end
    end
    if Config.NoSpread then
        stats.inaccuracy = 0
    elseif orig.inaccuracy ~= nil then
        stats.inaccuracy = orig.inaccuracy
    end
    if type(stats.recoilPattern) == "table" then
        if Config.NoRecoil then
            stats.recoilPattern.pushback = 0
            stats.recoilPattern.lift = 0
            stats.recoilPattern.shake = 0
            stats.recoilPattern.cameraLift = 0
        elseif orig.recoilPattern then
            stats.recoilPattern.pushback = orig.recoilPattern.pushback
            stats.recoilPattern.lift = orig.recoilPattern.lift
            stats.recoilPattern.shake = orig.recoilPattern.shake
            stats.recoilPattern.cameraLift = orig.recoilPattern.cameraLift
        end
    end
end

