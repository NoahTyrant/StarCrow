runAutoWin = function()
    if autoWinRunning then return end
    autoWinRunning = true

    while Config.AutoWin do
        purgeHeli()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hrp or not hum then
            task.wait(1)
            continue
        end

        local initialReplay = getActiveReplayButton()
        if initialReplay then
            handleReplay(initialReplay)
            task.wait(2)
            continue
        end

        if hum.Health <= 0 then
            task.wait(1)
            continue
        end

        if hum.Sit then
            hum.Sit = false
            task.wait(0.2)
        end
        hrp.Anchored = false

        activateCommand()
        if not Config.AutoWin then break end

        char:PivotTo(findOfficeCFrame())
        task.wait(0.2)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = false

        local waitTime = 118
        while waitTime > 0 and Config.AutoWin do
            local gameSecs, gameText = getGameTimer()
            if gameSecs then
                waitTime = gameSecs
                showTimer(string.format("AutoWin: %s", gameText))
                if gameSecs <= 0 then break end
            else
                showTimer(string.format("AutoWin: %ds", waitTime))
            end

            task.wait(1)
            waitTime = waitTime - 1

            if getActiveReplayButton() then break end

            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health <= 0 then
                break
            end
        end
        hideTimer()

        if not Config.AutoWin then break end

        if getActiveReplayButton() then
            task.wait(3)
            continue
        end

        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            char:PivotTo(findEndCFrame())
            task.wait(0.3)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            for step = 1, 8 do
                if not Config.AutoWin or getActiveReplayButton() then break end
                local curHrp = char:FindFirstChild("HumanoidRootPart")
                if curHrp then
                    char:PivotTo(char:GetPivot() * CFrame.new(0, 0, -60) + Vector3.new(0, 0, 60))
                end
                task.wait(0.25)
            end
        end

        while Config.AutoWin do
            task.wait(0.5)
            local btn = getActiveReplayButton()
            if btn then
                handleReplay(btn)
                task.wait(2)
                break
            end
        end

        task.wait(1)
    end

    hideTimer()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
    end
    autoWinRunning = false
end

if Config.AutoWin then
    task.spawn(runAutoWin)
end

local punchAnim1 = nil
local punchAnim2 = nil
local punchAnimToggle = false
local function playLocalPunchAnim(hum)
    pcall(function()
        local animFolder = ReplicatedStorage:FindFirstChild("FlowClient") and ReplicatedStorage.FlowClient:FindFirstChild("Punches")
        if animFolder and hum then
            local animator = hum:FindFirstChildOfClass("Animator") or hum
            if not punchAnim1 and animFolder:FindFirstChild("Action") then
                punchAnim1 = animator:LoadAnimation(animFolder.Action)
            end
            if not punchAnim2 and animFolder:FindFirstChild("SecondaryAction") then
                punchAnim2 = animator:LoadAnimation(animFolder.SecondaryAction)
            end
            punchAnimToggle = not punchAnimToggle
            if punchAnimToggle and punchAnim1 then
                punchAnim1:Play(0, 1, 4)
            elseif punchAnim2 then
                punchAnim2:Play(0, 1, 4)
            end
        end
    end)
end

local function getPunchTargets(myPos)
    local npcs = {}
    local breakables = {}
    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            local hum = npc:FindFirstChildOfClass("Humanoid")
            local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or (npc:IsA("Model") and npc.PrimaryPart)
            if hum and hum.Health > 0 and root then
                if (root.Position - myPos).Magnitude <= 20 then
                    table.insert(npcs, hum)
                end
            end
        end
    end
    for obj, p in pairs(breakableCache) do
        if obj.Parent and p.Parent then
            local partPos = p:IsA("BasePart") and p.Position or (obj:IsA("BasePart") and obj.Position)
            if partPos and (partPos - myPos).Magnitude <= 20 then
                table.insert(breakables, obj)
            end
        else
            breakableCache[obj] = nil
        end
    end
    return npcs, breakables
end

