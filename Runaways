task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myHrp = char.HumanoidRootPart
            
            if Config.KillAura then
                local npcsFolder = workspace:FindFirstChild("NPCs")
                if npcsFolder then
                    for _, npc in ipairs(npcsFolder:GetChildren()) do
                        local enemyHum = npc:FindFirstChild("Humanoid")
                        local enemyHrp = npc:FindFirstChild("HumanoidRootPart")
                        if enemyHum and enemyHum.Health > 0 and enemyHrp then
                            if (myHrp.Position - enemyHrp.Position).Magnitude <= Config.AuraRange then
                                pcall(function() FlowEvent:FireServer("Punches", "ReplicateSound", enemyHrp, "Swoosh") end)
                                pcall(function() FlowEvent:FireServer("NPCs", "Damage", enemyHum, 99999) end)
                            end
                        end
                    end
                end
            end

            if Config.AutoBreakSafes then
                for obj in pairs(breakableCache) do
                    if obj.Parent then
                        local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            if (myHrp.Position - targetPart.Position).Magnitude <= Config.AuraRange then
                                pcall(function() FlowEvent:FireServer("Punches", "ReplicateSound", targetPart, "Swoosh") end)
                                pcall(function() FlowEvent:FireServer("DamageToOpen", "Damage", obj, 99999, "melee") end)
                            end
                        end
                    else
                        breakableCache[obj] = nil
                    end
                end
            end
            
            if Config.AutoPickupItem then
                local lootFolder = workspace:FindFirstChild("Loot")
                if lootFolder then
                    for _, item in ipairs(lootFolder:GetChildren()) do
                        local handle = item:FindFirstChild("Handle")
                        if handle then
                            if (myHrp.Position - handle.Position).Magnitude <= 50 then
                                pcall(function()
                                    FlowFunction:InvokeServer("Loot", "LootEquip", handle)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

local _noclipThrottle = 0
RunService.Stepped:Connect(function(_, dt)
    local char = LocalPlayer.Character
    if char then
        if Config.Noclip then
            _noclipThrottle = _noclipThrottle + dt
            if _noclipThrottle >= 0.1 then
                _noclipThrottle = 0
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then 
                        part.CanCollide = false 
                    end
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and Config.WalkSpeedEnabled then 
            hum.WalkSpeed = Config.WalkSpeed 
        end
    end

    pcall(function()
        for name, stats in pairs(GunsData) do
            if type(stats) == "table" then
                if Config.InfAmmo then
                    stats.magCapacity = 99999
                    stats.infiniteAmmo = true
                end
                if Config.FastFire then
                    stats.maxRpm = 1200
                    stats.mode = "auto"
                end
                if Config.NoSpread then
                    stats.inaccuracy = 0
                end
                if Config.NoRecoil and type(stats.recoilPattern) == "table" then
                    stats.recoilPattern.pushback = 0
                    stats.recoilPattern.lift = 0
                    stats.recoilPattern.shake = 0
                    stats.recoilPattern.cameraLift = 0
                end
            end
        end
    end)
end)

