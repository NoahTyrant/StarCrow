    else
        currentTarget = nil
    end

    if Config.SilentAim and Config.PovMode == "Pov" then
        FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        FOVCircle.Radius = Config.PovSize
        FOVCircle.Visible = true
    else
