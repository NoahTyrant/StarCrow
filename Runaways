    if not chassis then return end
    local road = nil
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, part in ipairs(map:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name:lower() == "road" or part.Name:lower() == "sideroad") and math.abs(part.Position.Z - endZ) < 200 then
                road = part
                break
            end
        end
    end
    local pos
    if road then
        pos = Vector3.new(road.Position.X, road.Position.Y + road.Size.Y * 0.5 + 4.5, endZ - direction * 28)
    else
        pos = Vector3.new(chassis.Position.X, chassis.Position.Y + 5, endZ - direction * 28)
    end
    veh:PivotTo(CFrame.new(pos))
    for _, p in ipairs(veh:GetDescendants()) do
        if p:IsA("BasePart") then
            p.AssemblyLinearVelocity = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

