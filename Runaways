local cachedTimerLabel = nil
local function getGameTimer()
    if cachedTimerLabel and cachedTimerLabel.Parent and cachedTimerLabel.Text and cachedTimerLabel.Text ~= "" then
        local m, s = cachedTimerLabel.Text:match("(%d+)m%s*(%d+)s")
        if m and s then return tonumber(m) * 60 + tonumber(s), cachedTimerLabel.Text end
        local m2, s2 = cachedTimerLabel.Text:match("(%d+):(%d+)")
        if m2 and s2 then return tonumber(m2) * 60 + tonumber(s2), cachedTimerLabel.Text end
    end
    cachedTimerLabel = nil
    local cmd = workspace:FindFirstChild("Command", true)
    local customs = workspace:FindFirstChild("CustomsFinal", true)
    local office = workspace:FindFirstChild("CustomsOffice", true)
    local roots = {}
    if cmd then table.insert(roots, cmd) end
    if office then table.insert(roots, office) end
    if customs then table.insert(roots, customs) end

    for _, root in ipairs(roots) do
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                local m, s = desc.Text:match("(%d+)m%s*(%d+)s")
                if m and s then
                    cachedTimerLabel = desc
                    return tonumber(m) * 60 + tonumber(s), desc.Text
                end
                local m2, s2 = desc.Text:match("(%d+):(%d+)")
                if m2 and s2 then
                    cachedTimerLabel = desc
                    return tonumber(m2) * 60 + tonumber(s2), desc.Text
                end
            end
        end
    end
    return nil, nil
end

local function findCommandKey()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and (prompt.ActionText:lower():find("activate") or prompt.ObjectText:lower():find("activate")) then
            local part = prompt.Parent
            if part and part:IsA("BasePart") then
                return part, prompt
            end
        end
    end
    local cmd = workspace:FindFirstChild("Command", true)
    if cmd then
        local console = cmd:FindFirstChild("Console", true)
        if console and console:IsA("BasePart") then
            local prompt = console:FindFirstChildWhichIsA("ProximityPrompt", true) or cmd:FindFirstChildWhichIsA("ProximityPrompt", true)
            return console, prompt
        end
        local part = cmd:FindFirstChildWhichIsA("BasePart", true)
        local prompt = cmd:FindFirstChildWhichIsA("ProximityPrompt", true)
        if part then return part, prompt end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "CommandButton" or v.Name == "Console" then
            local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart", true)
            local prompt = v:FindFirstChildWhichIsA("ProximityPrompt", true)
            if part then return part, prompt end
        end
    end
    return nil, nil
end

local function isCommandActive()
    local part, prompt = findCommandKey()
    if prompt then
        if not prompt.Enabled then return true end
        if prompt:GetAttribute("Active") == true or prompt:GetAttribute("Activated") == true then return true end
        return false
    end
    local gameSecs = getGameTimer()
    if gameSecs and gameSecs > 0 and gameSecs < 119 then
        return true
    end
    if part then
        if part:GetAttribute("Active") == true or part:GetAttribute("Activated") == true then return true end
        local parent = part.Parent
        if parent and (parent:GetAttribute("Active") == true or parent:GetAttribute("Activated") == true) then return true end
    end
    return false
end

local function activateCommand()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hrp then return false end

    for attempt = 1, 10 do
        if not Config.AutoWin then return false end

        local keyPart, prompt = findCommandKey()
        if prompt and not prompt.Enabled then
            return true
        end

        local offsets = {
            CFrame.new(0, 0, 1.5),
            CFrame.new(0, 0, -1.5),
            CFrame.new(0, 1, 0)
        }
        local offset = offsets[((attempt - 1) % #offsets) + 1]

        if keyPart then
            char:PivotTo(keyPart.CFrame * offset)
        else
            char:PivotTo(CFrame.new(530.9, 1746.5, 83581.1))
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.3)

        if not prompt then
            keyPart, prompt = findCommandKey()
        end

        if isCommandActive() then
            return true
        end

        local holdTime = 2.5
        if prompt and prompt.HoldDuration and prompt.HoldDuration > 0 then
            holdTime = prompt.HoldDuration + 0.5
        end

        if prompt and fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
        end

        pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            local elapsed = 0
            while elapsed < holdTime and not isCommandActive() do
                task.wait(0.15)
                elapsed = elapsed + 0.15
                if prompt and fireproximityprompt then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            end
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        task.wait(0.4)

        if isCommandActive() then
            return true
        end

        task.wait(0.2)
    end

    return isCommandActive()
end

local function findOfficeCFrame()
    local customs = workspace:FindFirstChild("CustomsFinal", true)
    if customs then
        local office = customs:FindFirstChild("CustomsOffice", true)
        if office then
            local floor = office:FindFirstChild("Floor", true)
            if floor and floor:IsA("BasePart") then
                return floor.CFrame * CFrame.new(0, 3.5, 0)
            end
        end
    end
    return CFrame.new(530.9, 1746.5, 83581.1)
end

local function findEndCFrame()
    local customs = workspace:FindFirstChild("CustomsFinal", true)
    if customs then
        for _, desc in ipairs(customs:GetDescendants()) do
            if desc:IsA("BasePart") and (CollectionService:HasTag(desc, "WorldEndPart") or desc.Name == "601" or desc.Name == "600") then
                return desc.CFrame * CFrame.new(0, 3.5, 0)
            end
        end
    end
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and CollectionService:HasTag(desc, "WorldEndPart") then
            return desc.CFrame * CFrame.new(0, 3.5, 0)
        end
    end
    return CFrame.new(343.7, 2205.7, 83637.0)
end

