local function getGasStations()
    local list = {}
    local seen = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Name == "Road" then
            local isGas = false
            if desc.Parent and desc.Parent.Name == "Exterior" then
                isGas = true
            elseif desc.Parent and desc.Parent.Name:lower():find("gas") then
                isGas = true
            end
            if isGas then
                local pos = desc.Position
                local k = math.floor(pos.X / 50) .. "_" .. math.floor(pos.Z / 50)
                if not seen[k] then
                    seen[k] = true
                    table.insert(list, {
                        Position = pos,
                        CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
                    })
                end
            end
        end
    end
    if #list == 0 then
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("Model") and desc.Name:lower():find("gasstation") then
                local ext = desc:FindFirstChild("Exterior", true)
                local road = ext and ext:FindFirstChild("Road", true) or desc:FindFirstChild("Road", true)
                if road and road:IsA("BasePart") then
                    local pos = road.Position
                    local k = math.floor(pos.X / 50) .. "_" .. math.floor(pos.Z / 50)
                    if not seen[k] then
                        seen[k] = true
                        table.insert(list, {
                            Position = pos,
                            CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
                        })
                    end
                end
            end
        end
    end
    return list
end

local function getPawnShops()
    local list = {}
    local seen = {}

    local function addCandidate(pos, isPrimary)
        if not pos then return end
        local k = math.floor(pos.X / 50) .. "_" .. math.floor(pos.Z / 50)
        if not seen[k] then
            seen[k] = true
            table.insert(list, {
                Position = pos,
                CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)),
                IsPrimary = isPrimary
            })
        end
    end

    for _, desc in ipairs(workspace:GetDescendants()) do
        local nameLower = desc.Name:lower()

        if desc:IsA("BasePart") and desc.Name == "Road" then
            if desc.Parent and (desc.Parent.Name:lower():find("pawn") or desc.Parent.Name:lower():find("trash")) then
                addCandidate(desc.Position, true)
            end
        end

        if nameLower:find("pawnshoplot") then
            local road = desc:FindFirstChild("Road", true) or desc:FindFirstChildWhichIsA("BasePart", true) or (desc:IsA("BasePart") and desc)
            if road then
                local p = road:IsA("BasePart") and road.Position or (road:IsA("Model") and road:GetPivot().Position)
                addCandidate(p, true)
            end
        end

        if nameLower:find("trashamerica") or nameLower:find("trash_america") then
            local p = desc.Parent
            local pLot = (p and p:FindFirstChild("PawnShopLot", true)) or (p and p.Parent and p.Parent:FindFirstChild("PawnShopLot", true))
            local road = pLot and (pLot:FindFirstChild("Road", true) or pLot:FindFirstChildWhichIsA("BasePart", true))
            if road and road:IsA("BasePart") then
                addCandidate(road.Position, true)
            else
                local cf = (desc:IsA("Model") and desc:GetPivot()) or (desc:IsA("BasePart") and desc.CFrame)
                if cf then
                    local front = (cf * CFrame.new(0, -6, -25)).Position
                    addCandidate(front, false)
                end
            end
        end

        if nameLower == "pawnshop" or nameLower == "pawn" or (nameLower:find("pawn") and not nameLower:find("spawn")) then
            if desc:IsA("Model") or desc:IsA("Folder") then
                local road = desc:FindFirstChild("Road", true) or desc:FindFirstChild("PawnShopLot", true) or desc:FindFirstChildWhichIsA("BasePart", true)
                if road then
                    local p = road:IsA("BasePart") and road.Position or (road:IsA("Model") and road:GetPivot().Position)
                    addCandidate(p, true)
                end
            end
        end
    end

    local primary = {}
    for _, item in ipairs(list) do
        if item.IsPrimary then
            table.insert(primary, item)
        end
    end
    if #primary > 0 then
        return primary
    end
    return list
end

