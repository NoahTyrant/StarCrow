local function getAllItems()
    local items = {}
    local seen = {}
    local lootFolder = workspace:FindFirstChild("Loot")
    if lootFolder then
        for _, item in ipairs(lootFolder:GetChildren()) do
            if item:IsA("Model") or item:IsA("BasePart") then
                table.insert(items, item)
                seen[item] = true
            elseif item:IsA("Folder") then
                for _, sub in ipairs(item:GetChildren()) do
                    if (sub:IsA("Model") or sub:IsA("BasePart")) and not seen[sub] then
                        table.insert(items, sub)
                        seen[sub] = true
                    end
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if not seen[obj] and obj ~= LocalPlayer.Character then
            if obj:IsA("Model") and not obj:FindFirstChildOfClass("Humanoid") then
                if obj:FindFirstChild("Handle") or obj.Name:lower():find("trash") or obj.Name:lower():find("bag") or obj.Name:lower():find("loot") then
                    table.insert(items, obj)
                    seen[obj] = true
                end
            end
        end
    end
    return items
end

