                pcall(function() Fluent:Notify({ Title = "Teleport", Content = "No Pawn Shop found in loaded map", Duration = 3 }) end)
                return
            end
            local closest = nil
            local minDist = math.huge
            for _, sh in ipairs(shops) do
                local dist = (sh.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = sh
                end
            end
            if closest then
                teleportEntity(closest.CFrame)
                pcall(function() Fluent:Notify({ Title = "Teleport", Content = "Teleported to Pawn Shop", Duration = 3 }) end)
            end
        end)
    end
})

