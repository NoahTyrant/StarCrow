local function refreshTeleportLists(force)
    local map = workspace:FindFirstChild("Map")
    local buildings = (map and map:FindFirstChild("Buildings")) or workspace:FindFirstChild("Buildings")
    if not buildings then return end

    local gasEntries = {}
    local pawnEntries = {}

    for _, b in ipairs(buildings:GetChildren()) do
        if b:IsA("Model") then
            local name = b.Name:lower()
            if not name:find("sign", 1, true) then
                local bId = b:GetAttribute("BuildingId") or b.Name:match("%d+")
                local numId = tonumber(bId)
                local genId = getBuildingUniqueId(b)
                local order = numId or (1000000000 + genId)
                local baseName = formatBuildingName(b.Name:gsub("%d+$", ""):gsub("_%d+$", ""))

                local label
                if numId then
                    label = baseName .. " #" .. tostring(numId)
                else
                    label = baseName .. " (Landmark #" .. tostring(genId) .. ")"
                end

                if isGasStation(b) then
                    table.insert(gasEntries, {
                        Instance = b,
                        Label = label,
                        Order = order
                    })
                elseif isPawnShop(b) then
                    table.insert(pawnEntries, {
                        Instance = b,
                        Label = label,
                        Order = order
                    })
                end
            end
        end
    end

    table.sort(gasEntries, function(a, b)
        if a.Order == b.Order then
            return a.Label < b.Label
        end
        return a.Order < b.Order
    end)

    table.sort(pawnEntries, function(a, b)
        if a.Order == b.Order then
            return a.Label < b.Label
        end
        return a.Order < b.Order
    end)

    local newGasMap = {}
    local gasValues = { "None" }
    local seenGas = {}
    for _, entry in ipairs(gasEntries) do
        local l = entry.Label
        if seenGas[l] then
            seenGas[l] = seenGas[l] + 1
            l = l .. " (" .. seenGas[l] .. ")"
        else
            seenGas[l] = 1
        end
        table.insert(gasValues, l)
        newGasMap[l] = entry.Instance
    end

    local newPawnMap = {}
    local pawnValues = { "None" }
    local seenPawn = {}
    for _, entry in ipairs(pawnEntries) do
        local l = entry.Label
        if seenPawn[l] then
            seenPawn[l] = seenPawn[l] + 1
            l = l .. " (" .. seenPawn[l] .. ")"
        else
            seenPawn[l] = 1
        end
        table.insert(pawnValues, l)
        newPawnMap[l] = entry.Instance
    end

    local newGasSig = table.concat(gasValues, "\0")
    local newPawnSig = table.concat(pawnValues, "\0")

    teleData.isRefreshing = true

    if teleData.GasDropdown then
        teleData.gasMap = newGasMap
        if force or teleData.gasSig ~= newGasSig then
            teleData.gasSig = newGasSig
            teleData.GasDropdown:SetValues(gasValues)
            if newGasMap[teleData.selectedGas] then
                teleData.GasDropdown:SetValue(teleData.selectedGas)
            else
                teleData.GasDropdown:SetValue("None")
                teleData.selectedGas = "None"
            end
        end
    end

    if teleData.PawnDropdown then
        teleData.pawnMap = newPawnMap
        if force or teleData.pawnSig ~= newPawnSig then
            teleData.pawnSig = newPawnSig
            teleData.PawnDropdown:SetValues(pawnValues)
            if newPawnMap[teleData.selectedPawn] then
                teleData.PawnDropdown:SetValue(teleData.selectedPawn)
            else
                teleData.PawnDropdown:SetValue("None")
                teleData.selectedPawn = "None"
            end
        end
    end

    teleData.isRefreshing = false

    task.spawn(function()
        task.wait(0.1)
        local coreGui = game:GetService("CoreGui")
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local guis = { Fluent and Fluent.GUI, coreGui, playerGui }
        for _, root in ipairs(guis) do
            if root then
                for _, desc in ipairs(root:GetDescendants()) do
                    if desc:IsA("ScrollingFrame") then
                        desc.AutomaticCanvasSize = Enum.AutomaticSize.Y
                        desc.ScrollingEnabled = true
                        desc.ScrollBarImageTransparency = 0.2
                        desc.ScrollBarThickness = 6
                        local l = desc:FindFirstChildOfClass("UIListLayout")
                        if l and l.AbsoluteContentSize.Y > 0 then
                            desc.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 25)
                        end
                    end
                end
            end
        end
    end)
end

local function setupDropdownScrollFix()
    local function applyScrollerFix(scroller)
        if not scroller or not scroller:IsA("ScrollingFrame") then return end
        scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroller.ScrollingEnabled = true
        scroller.ScrollBarImageTransparency = 0.2
        scroller.ScrollBarThickness = 6
        local layout = scroller:FindFirstChildOfClass("UIListLayout")
        if layout then
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                if layout.AbsoluteContentSize.Y > 0 then
                    scroller.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 25)
                end
            end)
            if layout.AbsoluteContentSize.Y > 0 then
                scroller.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 25)
            end
        end
    end

    local function scanRoot(root)
        if not root then return end
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("ScrollingFrame") then
                applyScrollerFix(desc)
            end
        end
        root.DescendantAdded:Connect(function(desc)
            if desc:IsA("ScrollingFrame") then
                task.wait(0.05)
                applyScrollerFix(desc)
            elseif desc:IsA("UIListLayout") and desc.Parent and desc.Parent:IsA("ScrollingFrame") then
                task.wait(0.05)
                applyScrollerFix(desc.Parent)
            end
        end)
    end

    task.spawn(function()
        for _ = 1, 30 do
            if Fluent and Fluent.GUI then
                scanRoot(Fluent.GUI)
                break
            end
            task.wait(0.2)
        end
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            for _, r in ipairs({ coreGui, playerGui }) do
                if r then
                    for _, ch in ipairs(r:GetChildren()) do
                        if ch:IsA("ScreenGui") then
                            scanRoot(ch)
                        end
                    end
                    r.ChildAdded:Connect(function(ch)
                        if ch:IsA("ScreenGui") then
                            task.wait(0.1)
                            scanRoot(ch)
                        end
                    end)
                end
            end
        end)
    end)
end

