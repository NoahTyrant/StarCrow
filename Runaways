local punchState = {
    holding = false,
    running = false,
    cachedBtn = nil,
    activeTouch = nil
}

local function startPunchLoop()
    if punchState.running then return end
    punchState.running = true
    task.spawn(function()
        while punchState.holding and Config.NoPunchCooldown do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 1 and hrp and not char:FindFirstChildOfClass("Tool") then
                playLocalPunchAnim(hum)
                pcall(function()
                    FlowEvent:FireServer("Punches", "ReplicateSound", hrp, "Swoosh")
                end)
                local npcs, breakables = getPunchTargets(hrp.Position)
                local dmg = Config.PunchDamage or 10
                for _, enemyHum in ipairs(npcs) do
                    pcall(function()
                        FlowEvent:FireServer("NPCs", "Damage", enemyHum, dmg)
                    end)
                end
                for _, bObj in ipairs(breakables) do
                    pcall(function()
                        FlowEvent:FireServer("DamageToOpen", "Damage", bObj, dmg, "melee")
                    end)
                end
            end
            task.wait(0.02)
        end
        punchState.running = false
    end)
end

local function onPunchBegan()
    punchState.holding = true
    if Config.NoPunchCooldown then
        startPunchLoop()
    end
end

local function onPunchEnded()
    punchState.holding = false
end

local function getPunchButton()
    if punchState.cachedBtn and punchState.cachedBtn.Parent then
        return punchState.cachedBtn
    end
    local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pgui then
        local hud = pgui:FindFirstChild("HudGui")
