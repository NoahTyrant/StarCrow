local holdingPunch = false
local punchThreadRunning = false

local function startPunchLoop()
    if punchThreadRunning then return end
    punchThreadRunning = true
    task.spawn(function()
        while holdingPunch and Config.NoPunchCooldown do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 1 and hrp and not char:FindFirstChildOfClass("Tool") then
                playLocalPunchAnim(hum)
                pcall(function()
                    FlowEvent:FireServer("Punches", "ReplicateSound", hrp, "Swoosh")
                end)
                local npcs, breakables = getPunchTargets(hrp.Position)
                local dmg = Config.PunchDamage or 10
                for _, enemyHum in ipairs(npcs) do
                    pcall(function()
                        FlowEvent:FireServer("NPCs", "Damage", enemyHum, dmg)
                    end)
                end
                for _, bObj in ipairs(breakables) do
                    pcall(function()
                        FlowEvent:FireServer("DamageToOpen", "Damage", bObj, dmg, "melee")
                    end)
                end
            end
            task.wait(0.02)
        end
        punchThreadRunning = false
    end)
end

local function onPunchBegan()
    holdingPunch = true
    if Config.NoPunchCooldown then
        startPunchLoop()
    end
end

local function onPunchEnded()
    holdingPunch = false
end

local cachedPunchButton = nil
local function getPunchButton()
    if cachedPunchButton and cachedPunchButton.Parent then
        return cachedPunchButton
    end
    local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pgui then
        local hud = pgui:FindFirstChild("HudGui")
        if hud then
            local tc = hud:FindFirstChild("TouchControl")
            if tc then
                local pb = tc:FindFirstChild("Punch")
                if pb and pb:IsA("GuiObject") then
                    cachedPunchButton = pb
                    return pb
                end
            end
        end
        for _, desc in ipairs(pgui:GetDescendants()) do
            if desc.Name == "Punch" and desc:IsA("GuiObject") and desc.Parent and desc.Parent.Name == "TouchControl" then
                cachedPunchButton = desc
                return desc
            end
        end
    end
    return nil
end

local activePunchTouch = nil

UserInputService.TouchStarted:Connect(function(touch)
    local btn = getPunchButton()
    if btn and btn.Visible then
        local ap = btn.AbsolutePosition
        local as = btn.AbsoluteSize
        local p = touch.Position
        if p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y then
            activePunchTouch = touch
            onPunchBegan()
        end
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    if activePunchTouch and touch == activePunchTouch then
        activePunchTouch = nil
        onPunchEnded()
    end
end)

local function bindPunchGui(obj)
    if not obj or not obj:IsA("GuiObject") then return end
    if obj:GetAttribute("PunchBound") then return end
    obj:SetAttribute("PunchBound", true)

    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            onPunchBegan()
        end
    end)

    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            onPunchEnded()
        end
    end)

    if obj:IsA("GuiButton") then
        obj.MouseButton1Down:Connect(onPunchBegan)
        obj.MouseButton1Up:Connect(onPunchEnded)
    end
end

local function scanAndBindPunchGui()
    local btn = getPunchButton()
    if btn then
        bindPunchGui(btn)
    end
end

scanAndBindPunchGui()

local pguiObj = LocalPlayer:WaitForChild("PlayerGui", 9e9)
if pguiObj then
    pguiObj.DescendantAdded:Connect(function(desc)
        if desc.Name == "Punch" and desc:IsA("GuiObject") and desc.Parent and desc.Parent.Name == "TouchControl" then
            bindPunchGui(desc)
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if UserInputService:GetLastInputType() == Enum.UserInputType.Touch then return end
        onPunchBegan()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if UserInputService:GetLastInputType() == Enum.UserInputType.Touch then return end
        onPunchEnded()
    end
end)


