                end
                if obj then
                    for _, desc in ipairs(obj:GetDescendants()) do
                        if desc.Name == "StarCrowCashESP" then
                            pcall(function() desc:Destroy() end)
                        end
                    end
                    local chams = obj:FindFirstChild("StarCrowCashChams")
                    if chams then chams:Destroy() end
