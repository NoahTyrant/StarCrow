runAutoWin = function()
    if autoWinRunning then return end
    autoWinRunning = true

    while Config.AutoWin do
        purgeHeli()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hrp or not hum then
            task.wait(1)
            continue
        end

        local initialReplay = getActiveReplayButton()
        if initialReplay then
            queueAutoExec()
            clickButton(initialReplay)
            task.wait(2)
            continue
        end

        if hum.Health <= 0 then
            task.wait(1)
            continue
        end

        if hum.Sit then
            hum.Sit = false
            task.wait(0.2)
        end
        hrp.Anchored = false
        Config.KillAura = true

        char:PivotTo(findOfficeCFrame())
        task.wait(0.5)
        if not Config.AutoWin then break end

        local keyPart, prompt = findCommandKey()
        if not keyPart then
            char:PivotTo(CFrame.new(-356.5, 2328.4, 83595.9))
            task.wait(0.8)
            keyPart, prompt = findCommandKey()
        end
        if not Config.AutoWin then break end

        if keyPart then
            char:PivotTo(keyPart.CFrame * CFrame.new(0, 0, 3))
        else
            char:PivotTo(CFrame.new(-356.5, 2328.4, 83595.9))
        end
        task.wait(0.4)

        if prompt and fireproximityprompt then
            fireproximityprompt(prompt)
        end
        pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(1.5)
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        task.wait(0.3)
        if not Config.AutoWin then break end

        char:PivotTo(findOfficeCFrame())
        task.wait(0.2)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = false

        local waitTime = 120
        while waitTime > 0 and Config.AutoWin do
            task.wait(1)
            waitTime = waitTime - 1

            if getActiveReplayButton() then break end

            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health <= 0 then
                break
            end
        end

        if not Config.AutoWin then break end

        if getActiveReplayButton() then
            task.wait(3)
            continue
        end

        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            char:PivotTo(findEndCFrame())
            task.wait(0.3)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            for step = 1, 8 do
                if not Config.AutoWin or getActiveReplayButton() then break end
                local curHrp = char:FindFirstChild("HumanoidRootPart")
                if curHrp then
                    char:PivotTo(char:GetPivot() * CFrame.new(0, 0, -60) + Vector3.new(0, 0, 60))
                end
                task.wait(0.25)
            end
        end

        local replayTimeout = tick() + 90
        while Config.AutoWin and tick() < replayTimeout do
            task.wait(0.5)
            local btn = getActiveReplayButton()
            if btn then
                task.wait(2)
                if not getActiveReplayButton() then
                    task.wait(2)
                    break
                end
            end
        end

        task.wait(1)
    end

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
    end
    autoWinRunning = false
end

if Config.AutoWin then
    task.spawn(runAutoWin)
end

local _noclipThrottle = 0
RunService.Stepped:Connect(function(_, dt)
    local char = LocalPlayer.Character
    if char then
        if Config.Noclip then
            _noclipThrottle = _noclipThrottle + dt
            if _noclipThrottle >= 0.1 then
                _noclipThrottle = 0
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then 
                        part.CanCollide = false 
                    end
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and Config.WalkSpeedEnabled then 
            hum.WalkSpeed = Config.WalkSpeed 
        end
    end

    pcall(function()
        for name, stats in pairs(GunsData) do
            if type(stats) == "table" then
                if Config.InfAmmo then
                    stats.magCapacity = 99999
                    stats.infiniteAmmo = true
                end
                if Config.FastFire then
                    stats.maxRpm = 1200
                    stats.mode = "auto"
                end
                if Config.NoSpread then
                    stats.inaccuracy = 0
                end
                if Config.NoRecoil and type(stats.recoilPattern) == "table" then
                    stats.recoilPattern.pushback = 0
                    stats.recoilPattern.lift = 0
                    stats.recoilPattern.shake = 0
                    stats.recoilPattern.cameraLift = 0
                end
            end
        end
    end)
end)

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end

    if Config.SilentAim then
