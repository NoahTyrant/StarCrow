local function getConsumableCategory(tool)
    if not tool or not tool:IsA("Tool") then return nil end

    local name = tool.Name:lower()
    local baseTool = tool:GetAttribute("BaseTool")
    local baseName = type(baseTool) == "string" and baseTool:lower() or ""
    local full = name .. " " .. baseName

    if full:find("bandage") then
        return "Bandage"
    end

    if full:find("medicbag") or (full:find("medic") and full:find("bag")) then
        return "MedicBag"
    end

    if full:find("medicpack") or (full:find("medic") and full:find("pack")) or full:find("medkit") or full:find("firstaid") or full:find("aid") or full:find("pill") or full:find("painkiller") or full:find("syring") or full:find("heal") or full:find("medic") then
        return "MedicPack"
    end

    if tool:HasTag("Food") or tool:GetAttribute("Food") == true or tool:GetAttribute("Category") == "Food" then
        return "Foods & Drinks"
    end

    for _, kw in ipairs(consumableKeywords) do
        if full:find(kw) then
            return "Foods & Drinks"
        end
    end

    if tool:HasTag("Consumable") or tool:HasTag("Medical") or tool:GetAttribute("Consumable") == true or tool:GetAttribute("Category") == "Consumable" then
        return "Foods & Drinks"
    end

    return nil
end

local function isCategoryEnabled(cat)
    if not cat then return false end
    if not Config.AutoHealItems then return true end
    if type(Config.AutoHealItems) ~= "table" then return true end

    if Config.AutoHealItems[cat] == true then
        return true
    end

    for k, v in pairs(Config.AutoHealItems) do
        if v == true and tostring(k):lower() == cat:lower() then
            return true
        elseif type(k) == "number" and tostring(v):lower() == cat:lower() then
            return true
        end
    end

    return false
end

local function isConsumableTool(tool)
    if not tool or not tool:IsA("Tool") then return false end

    local name = tool.Name:lower()
    local baseTool = tool:GetAttribute("BaseTool")
    local baseName = type(baseTool) == "string" and baseTool:lower() or ""

    if tool:HasTag("Melee") or tool:HasTag("Backpack") or tool:HasTag("Undroppable") then
        return false
    end

    if tool:FindFirstChild("Ammo") or tool:FindFirstChild("GunScript") or tool:FindFirstChild("GunClient") or tool:FindFirstChild("Mag") then
        return false
    end

    if name:find("%d+/%d+") or baseName:find("%d+/%d+") then
        return false
    end

    for _, kw in ipairs(nonConsumableKeywords) do
        if name:find(kw) or baseName:find(kw) then
            return false
        end
    end

    local cat = getConsumableCategory(tool)
    if cat and isCategoryEnabled(cat) then
        return true
    end

    return false
end

local function findConsumable(char, hum)
    if not char then return nil end
    local bp = LocalPlayer:FindFirstChild("Backpack")

    local held = char:FindFirstChildOfClass("Tool")
    if held and isConsumableTool(held) then
        return held
    end

    local order = {"MedicPack", "MedicBag", "Bandage", "Foods & Drinks"}
    for _, targetCat in ipairs(order) do
        if isCategoryEnabled(targetCat) then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and getConsumableCategory(tool) == targetCat and isConsumableTool(tool) then
                    return tool
                end
            end
            if bp then
                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") and getConsumableCategory(tool) == targetCat and isConsumableTool(tool) then
                        if hum then
                            hum:EquipTool(tool)
                            local t0 = os.clock()
                            repeat
                                task.wait(0.03)
                            until tool.Parent == char or os.clock() - t0 >= 0.3
                        end
                        return tool
                    end
                end
            end
        end
    end

    return nil
end

