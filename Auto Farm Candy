local function equipCandyBucket()
    local char = LocalPlayer.Character
    if not char then return end
    local toolInChar = char:FindFirstChild("Candy Bucket")
    if toolInChar then return toolInChar end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild("Candy Bucket")
        if tool then
            tool.Parent = char
            return tool
        end
    end
    for _, item in ipairs(LocalPlayer:GetDescendants()) do
        if item:IsA("Tool") and item.Name == "Candy Bucket" then
            item.Parent = char
            return item
        end
    end
    return nil
end

