local function bringCandyItem(item, hrp)
    if not isValidCandy(item) or not hrp then return end
    local targetCFrame = Camera.CFrame * CFrame.new(0, 0, -2)
    if item:IsA("Model") then
        item:PivotTo(targetCFrame)
        for _, p in ipairs(item:GetChildren()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                if firetouchinterest then
                    firetouchinterest(hrp, p, 0)
                    firetouchinterest(hrp, p, 1)
                end
            elseif p:IsA("ProximityPrompt") then
                if fireproximityprompt then
                    fireproximityprompt(p)
                end
            end
        end
    elseif item:IsA("BasePart") then
        item.CFrame = targetCFrame
        item.CanCollide = false
        item.AssemblyLinearVelocity = Vector3.zero
        item.AssemblyAngularVelocity = Vector3.zero
        if firetouchinterest then
            firetouchinterest(hrp, item, 0)
            firetouchinterest(hrp, item, 1)
        end
    end
    for _, prompt in ipairs(item:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end
    end
end

