end)

local function getNearestPendingDoor(hrpPos)
    local nearestPrompt, nearestPart, minDist = nil, nil, math.huge
    for prompt, part in pairs(knownDoors) do
        if prompt.Parent and part.Parent and not interactedDoors[prompt] then
            local d = (part.Position - hrpPos).Magnitude
            if d <= SCAN_RADIUS and d < minDist then
                minDist = d
                nearestPrompt = prompt
                nearestPart = part
            end
        end
    end
    return nearestPrompt, nearestPart
end

local function fastStreamAround(pos)
