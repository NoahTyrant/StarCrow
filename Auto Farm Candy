local interactedDoors = {}
local knownDoors = {}

local function scanForDoors()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and not knownDoors[prompt] then
            local act = string.lower(prompt.ActionText)
            local ob = string.lower(prompt.ObjectText)
            local pName = string.lower(prompt.Name)
            local parentName = prompt.Parent and string.lower(prompt.Parent.Name) or ""
            if string.find(act, "knock") or string.find(ob, "door") or string.find(pName, "knock") or string.find(parentName, "door") then
                local promptPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                if promptPart then
                    knownDoors[prompt] = promptPart
                end
            end
        end
    end
end

