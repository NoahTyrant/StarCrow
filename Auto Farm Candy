local function prestreamRoute(fromPos, toPos)
    task.spawn(function()
        local dist = (fromPos - toPos).Magnitude
        local count = math.clamp(math.floor(dist / 2500), 1, 20)
        for i = 1, count do
            local p = fromPos:Lerp(toPos, i / count)
            fastStreamAround(p)
        end
    end)
end

local function tweenStep(fromPos, toPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    fastStreamAround(toPos)
    prestreamRoute(fromPos, toPos)

    local currentSpeed = speed or Config.TweenSpeed
    local dist = (fromPos - toPos).Magnitude
    local dur = math.max(0.05, dist / currentSpeed)
    local interrupted = false

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = hrp

    local tw = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(toPos) * endCFrame.Rotation
    })

    local completed = false
    local conn
    conn = tw.Completed:Connect(function()
        completed = true
    end)
    tw:Play()

    activeTweenUpdate = function()
        if completed or not isPlayerAlive() then return end
        local c = LocalPlayer.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        hrp = root
        currentSpeed = Config.TweenSpeed
        if tw then
            pcall(function() tw:Cancel() end)
        end
        if conn then
            conn:Disconnect()
            conn = nil
        end
        local remDist = (root.Position - toPos).Magnitude
        local remDur = math.max(0.05, remDist / currentSpeed)
        tw = TweenService:Create(root, TweenInfo.new(remDur, Enum.EasingStyle.Linear), {
            CFrame = CFrame.new(toPos) * endCFrame.Rotation
        })
        conn = tw.Completed:Connect(function()
            completed = true
        end)
        tw:Play()
    end

    local lastLookAhead = 0
    while not completed do
        if not isPlayerAlive() then
            activeTweenUpdate = nil
            if tw then pcall(function() tw:Cancel() end) end
            if conn then conn:Disconnect() end
            if bv then bv:Destroy() end
            return false
        end

        if currentSpeed ~= Config.TweenSpeed then
            pcall(activeTweenUpdate)
        end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if tick() - lastLookAhead > 0.2 then
            lastLookAhead = tick()
            local dir = (toPos - hrp.Position)
            if dir.Magnitude > 100 then
                fastStreamAround(hrp.Position + dir.Unit * math.min(dir.Magnitude, 3000))
            end
        end

        local prompt, promptPart = getNearestPendingDoor(hrp.Position)
        if prompt and promptPart then
            activeTweenUpdate = nil
            if tw then pcall(function() tw:Cancel() end) end
            if conn then conn:Disconnect() end
            if bv then bv:Destroy() end
            interrupted = true

            statusText = "Farm Candy"
            interactedDoors[prompt] = true
            equipCandyBucket()
            fastStreamAround(promptPart.Position)
            hrp.CFrame = promptPart.CFrame * CFrame.new(0, 0, 3)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.15)
            for i = 1, 3 do
                triggerPrompt(prompt)
                task.wait(0.08)
            end
            task.wait(0.2)
            
            local resumeHighPos = Vector3.new(hrp.Position.X, TWEEN_ALTITUDE, hrp.Position.Z)
            hrp.CFrame = CFrame.new(resumeHighPos) * endCFrame.Rotation
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            fastStreamAround(toPos)
            
            return tweenStep(resumeHighPos, toPos, Config.TweenSpeed)
        end

        task.wait(0.05)
    end

    activeTweenUpdate = nil
    if conn then conn:Disconnect() end
    if bv then bv:Destroy() end
    return true
end

