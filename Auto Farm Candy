            prestreamRoute(initialHighPos, targetHighPos)

            statusText = "Ascending"
            hrp.CFrame = CFrame.new(initialHighPos) * endCFrame.Rotation
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            statusText = "Tweening to End"
            local reached = tweenStep(initialHighPos, targetHighPos, Config.TweenSpeed)
            
            if reached and isPlayerAlive() then
                hrp.CFrame = endCFrame
                statusText = "Reached End - Resetting"
                task.wait(0.5)
                forceResetUntilDead()
            end
        end
        task.wait(1)
    end
end)

