local function findMainHubFrame(container)
    if not container then return nil end
    local ok, children = pcall(function() return container:GetChildren() end)
    if not ok then return nil end
    for _, gui in ipairs(children) do
        if gui:IsA("ScreenGui") and gui ~= LogoGui and gui ~= fovGui then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("TextLabel") and (desc.Text == "StarCrow Hub" or desc.Text:find("StarCrow")) then
                    local p = desc.Parent
                    while p and p.Parent ~= gui do p = p.Parent end
                    if p and p:IsA("Frame") then
                        return p
                    end
                end
            end
        end
    end
    return nil
end

local function toggleUI()
    local now = tick()
    if now - lastToggleTime < 0.3 then return end
    lastToggleTime = now
    uiVisible = not uiVisible
    if cachedMainHubFrame and cachedMainHubFrame.Parent then
        cachedMainHubFrame.Visible = uiVisible
        return
    end
    local containers = {}
    if gethui then
        pcall(function() table.insert(containers, gethui()) end)
    end
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pGui then
        table.insert(containers, pGui)
    end
    for _, container in ipairs(containers) do
        local frame = findMainHubFrame(container)
        if frame then
            cachedMainHubFrame = frame
            frame.Visible = uiVisible
            return
        end
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if (ToggleUIKeybind and ToggleUIKeybind.Picking) or (FlyKeybind and FlyKeybind.Picking) or (NoclipKeybind and NoclipKeybind.Picking) then
        return
    end
    if not processed and input.KeyCode == minimizeKey then
        uiVisible = not uiVisible
        return
    end
    if processed or Config.DisableKeybinds then return end
    if os.clock() - lastKeybindEditTime <= 0.25 then return end
    if input.KeyCode == flyKey then
        toggleFeatureWithToggle(FlyToggle, function()
            return Config.FlyEnabled
        end, setFlyEnabled)
    elseif input.KeyCode == noclipKey then
        toggleFeatureWithToggle(NoclipToggle, function()
            return Config.NoclipEnabled
        end, setNoclipEnabled)
    end
end)

