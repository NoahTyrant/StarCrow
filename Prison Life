local function addSavedMultiDropdown(tab, id, title, valuesList, configKey, excludedKey)
    local dd = tab:AddDropdown(id, {
        Title = title,
        Values = valuesList,
        Default = {},
        Multi = true,
        AllowNull = true,
        ScrollingEnabled = true,
        Callback = function(Value)
            Config[configKey] = sanitizeStringBoolMap(Value, excludedKey)
            if not isInitializingDropdown then
                SaveConfig()
            end
        end
    })
    local initialMap = {}
    local saved = Config[configKey]
    if type(saved) == "table" then
        for _, name in ipairs(valuesList) do
            if saved[name] == true and name ~= excludedKey then
                initialMap[name] = true
            end
        end
    end
    isInitializingDropdown = true
    if next(initialMap) and dd and dd.SetValue then
        pcall(function()
            dd:SetValue(initialMap)
        end)
    end
    isInitializingDropdown = false
    return dd
end

