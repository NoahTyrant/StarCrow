local function getPlayerFromHitInstance(inst)
    local cur = inst
    while cur and cur ~= workspace do
        if cur:IsA("Model") then
            local p = Players:GetPlayerFromCharacter(cur)
            if p then
                return p, cur
            end
        end
        cur = cur.Parent
    end
    return nil, nil
