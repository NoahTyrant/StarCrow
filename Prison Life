local gunValues = getGunList()
if not table.find(gunValues, Config.SelectedGun) and gunValues[1] then
    Config.SelectedGun = gunValues[1]
end

Tabs.Misc:AddDropdown("SelectGunDropdown", {
    Title = "Select Gun",
    Values = gunValues,
    Default = Config.SelectedGun or gunValues[1],
    Multi = false,
    ScrollingEnabled = true,
    Callback = function(Value)
        Config.SelectedGun = Value or gunValues[1]
        SaveConfig()
    end
})

Tabs.Misc:AddButton({
    Title = "Get Gun",
    Callback = function()
        local selected = Config.SelectedGun or gunValues[1]
        if selected then
            task.spawn(function()
                getGunAndReturn(selected)
            end)
        end
    end
})

Tabs.Settings:AddSection("Keybinds")

Tabs.Settings:AddKeybind("ToggleUIKeybind", {
    Title = "Minimize UI Keybind",
    Mode = "Toggle",
    Default = Config.MinimizeKey or "LeftControl",
    ChangedCallback = function(NewKey)
        local keyName = typeof(NewKey) == "EnumItem" and NewKey.Name or tostring(NewKey):gsub("Enum%.KeyCode%.", "")
        local keyCode = Enum.KeyCode[keyName] or Enum.KeyCode.LeftControl
        minimizeKey = keyCode
        Window.MinimizeKey = keyCode
        Config.MinimizeKey = keyCode.Name
        SaveConfig()
    end
})

Window:SelectTab(1)
