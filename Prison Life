        end
    end
    if #gunList == 0 then
        if not silentMode then
            Fluent:Notify({
                Title = "Get Gun",
                Content = "No gun selected",
                Duration = 2
            })
        end
        return
    end
    gettingGun = true
    local wasInvisPaused = invisPaused
    invisPaused = true
    local ok, err = pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or hum.Health <= 0 or not hrp then return end

        restoreInvisRoot()
        local savedCFrame = hrp.CFrame

        for _, gunName in ipairs(gunList) do
            if not hrp.Parent or hum.Health <= 0 then break end
            if not (silentMode and playerOwnsTool(gunName)) then
                local giver, part = findGunGiver(gunName)
                if not giver or not part then
                    if not silentMode then
                        Fluent:Notify({
                            Title = "Get Gun",
                            Content = "Gun not found: " .. tostring(gunName),
                            Duration = 2
                        })
                    end
                else
                    local hadBefore = playerOwnsTool(gunName)
                    hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    task.wait(0.15)

                    for _ = 1, 2 do
                        if not hrp.Parent or hum.Health <= 0 then break end
                        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero

                        triggerItemInteraction(giver, part, hrp, false)

                        task.wait(0.18)
                        if not hadBefore and playerOwnsTool(gunName) then
                            break
                        end
                    end
                end
            end
        end

        if hrp and hrp.Parent then
            hrp.CFrame = savedCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        if Config.FastFire or Config.NoSpread then
            task.defer(applyGunMods)
        end
    end)
    invisPaused = wasInvisPaused
    gettingGun = false
    if not ok and err then
        warn(err)
    end
end

