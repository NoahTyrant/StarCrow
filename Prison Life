do
    local activeInput, dragStart, startPos, clickStartPos, didDrag = nil, nil, nil, nil, false
    LogoBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeInput = input
            dragStart = input.Position
            startPos = LogoFrame.Position
            clickStartPos = Vector2.new(input.Position.X, input.Position.Y)
            didDrag = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not activeInput then return end
        local isMatchingDrag = (input == activeInput) or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if isMatchingDrag then
            local delta = input.Position - dragStart
            if not didDrag and Vector2.new(delta.X, delta.Y).Magnitude >= 8 then
                didDrag = true
            end
            if didDrag then
                LogoFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if activeInput and input == activeInput then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            local dist = clickStartPos and (pos - clickStartPos).Magnitude or 999
            local wasDragged = didDrag
            activeInput = nil
            dragStart = nil
            startPos = nil
            clickStartPos = nil
            didDrag = false
            if not wasDragged and dist < 16 then
                toggleUI()
            end
        end
    end)
end

