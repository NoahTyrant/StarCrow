    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild(gunName) then
        return true
    end
    return false
end

local gettingGun = false

local function getGunAndReturn(gunName)
    if gettingGun then return end
    gettingGun = true
    local ok, err = pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or hum.Health <= 0 or not hrp then return end

        local giver, part = findGunGiver(gunName)
        if not giver or not part then
            Fluent:Notify({
                Title = "Get Gun",
                Content = "Gun not found: " .. tostring(gunName),
                Duration = 3
            })
            return
        end

        local hadBefore = playerOwnsTool(gunName)
        local savedCFrame = hrp.CFrame

        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.15)

        for _ = 1, 2 do
            if not hrp.Parent or hum.Health <= 0 then break end
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero

            if GiverPressedRemote and (CollectionService:HasTag(giver, "Giver") or CollectionService:HasTag(giver, "TouchGiver")) then
                pcall(function()
                    GiverPressedRemote:FireServer(giver)
                end)
            end

            if firetouchinterest then
                local hasTouch = CollectionService:HasTag(giver, "TouchGiver") or giver:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
                if hasTouch then
                    if giver:IsA("BasePart") then
                        pcall(function()
                            firetouchinterest(hrp, giver, 0)
                            task.wait(0.03)
                            firetouchinterest(hrp, giver, 1)
                        end)
                    else
                        for _, desc in ipairs(giver:GetDescendants()) do
                            if desc:IsA("BasePart") then
                                pcall(function()
                                    firetouchinterest(hrp, desc, 0)
                                    task.wait(0.02)
                                    firetouchinterest(hrp, desc, 1)
                                end)
                            end
                        end
                    end
                end
            end

            local pName = giver.Parent and giver.Parent.Name
            if InteractWithItemRemote and (pName == "giver" or pName == "single") then
                task.spawn(function()
                    pcall(function()
                        InteractWithItemRemote:InvokeServer(part)
                    end)
                end)
            end

            if fireclickdetector then
                local cd = giver:FindFirstChildWhichIsA("ClickDetector", true)
                if cd then
                    pcall(function()
                        fireclickdetector(cd)
                    end)
                end
            end

            if fireproximityprompt then
                local pp = giver:FindFirstChildWhichIsA("ProximityPrompt", true)
                if pp then
                    pcall(function()
                        fireproximityprompt(pp)
                    end)
                end
            end

            task.wait(0.18)
            if not hadBefore and playerOwnsTool(gunName) then
                break
            end
        end

        if hrp and hrp.Parent then
            hrp.CFrame = savedCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        if Config.FastFire or Config.AutoFire or Config.NoSpread then
            task.defer(applyGunMods)
        end
    end)
    gettingGun = false
    if not ok and err then
        warn(err)
    end
end

