local lastHealNotifyTime = 0

local cachedArmor300 = nil
local cachedArmor150 = nil
local cachedArmor125 = nil
local lastArmorScan = 0

local function getEquipArmorParts()
    local now = os.clock()
    if cachedArmor300 and cachedArmor150 and cachedArmor125 and (now - lastArmorScan < 15) then
        return cachedArmor300, cachedArmor150, cachedArmor125
    end
    lastArmorScan = now

    local armors300 = {}
    local armors150 = {}
    local armors125 = {}

    local tycoonsFolder = workspace:FindFirstChild("Tycoons") or workspace
    for _, desc in ipairs(tycoonsFolder:GetDescendants()) do
        if desc:IsA("BasePart") then
            local n = desc.Name:lower()
            local pName = desc.Parent and desc.Parent.Name:lower() or ""
            local mName = desc.Parent and desc.Parent.Parent and desc.Parent.Parent.Name:lower() or ""

            local isArmor = (n == "giver" or n == "accessory equip" or n:find("armor") or n:find("vest") or n == "handle" or n == "torso") and
                            (pName:find("armor") or pName:find("morph") or pName:find("hat") or pName:find("model") or pName:find("vest") or
                             mName:find("dropper") or mName:find("showcase") or mName:find("tycoon"))

            if isArmor then
                local is300 = false
                local is150 = false
                local is125 = false

                local searchScope = desc.Parent and desc.Parent.Parent or desc.Parent
                if searchScope then
                    for _, child in ipairs(searchScope:GetDescendants()) do
                        if child:IsA("TextLabel") or child:IsA("BillboardGui") then
                            local t = child:IsA("TextLabel") and child.Text:lower() or ""
                            if t:find("300") then
                                is300 = true
                                break
                            elseif t:find("150") then
                                is150 = true
                                break
                            elseif t:find("125") or t:find("light") then
                                is125 = true
                                break
                            end
                        end
                    end
                end

                if not is300 and not is150 and not is125 then
                    local fullPath = (n .. " " .. pName .. " " .. mName):lower()
                    if fullPath:find("300") then
                        is300 = true
                    elseif fullPath:find("150") or fullPath:find("heavy") then
                        is150 = true
                    elseif fullPath:find("125") or fullPath:find("light") then
                        is125 = true
                    end
                end

                if is300 then
                    table.insert(armors300, desc)
                elseif is150 then
                    table.insert(armors150, desc)
                elseif is125 then
                    table.insert(armors125, desc)
                end
            end
        end
    end
    cachedArmor300 = armors300
    cachedArmor150 = armors150
    cachedArmor125 = armors125
    return armors300, armors150, armors125
end

local function autoHealArmor(force)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return end

    local currentPercent = (hum.Health / hum.MaxHealth) * 100
    if force or currentPercent < Config.AutoHealPercent then
        local armors300, armors150, armors125 = getEquipArmorParts()
        local equippedType = nil

        local function tryEquipList(list, armorName)
            for _, part in ipairs(list) do
                if part and part.Parent then
                    firetouchinterest(hrp, part, 0)
                    firetouchinterest(hrp, part, 1)
                    equippedType = armorName
                    return true
                end
            end
            return false
        end

        local sel = Config.SelectedArmor or "Super Armor (300 HP)"
        if sel:find("300") then
            tryEquipList(armors300, "Super Armor (300 HP)")
        elseif sel:find("125") or sel:find("Light") then
            tryEquipList(armors125, "Light Armor (125 HP)")
        else
            tryEquipList(armors150, "Heavy Armor (150 HP)")
        end

        if equippedType and (force or os.clock() - lastHealNotifyTime >= 3) then
            lastHealNotifyTime = os.clock()
            pcall(function()
                Fluent:Notify({
                    Title = "Auto Heal",
                    Content = "Equipped: " .. equippedType,
                    Duration = 2.5
                })
            end)
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if Config.AutoHeal then
            pcall(autoHealArmor)
        end
    end
end)

