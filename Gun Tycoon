local function teleportToClaimBase()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local tycoons = workspace:FindFirstChild("Tycoons") and workspace.Tycoons:FindFirstChild("Tycoons")
    if not tycoons then return end

    for _, tycoon in ipairs(tycoons:GetChildren()) do
        local owner = tycoon:FindFirstChild("Owner")
        if owner and owner.Value == nil then
            local targetPart = nil
            local claimModel = tycoon:FindFirstChild("Touch to claim!")
            if claimModel then
                targetPart = claimModel:FindFirstChild("Head") or claimModel:FindFirstChildWhichIsA("BasePart")
            end
            if not targetPart and tycoon:FindFirstChild("Essentials") then
                local claimEss = tycoon.Essentials:FindFirstChild("Touch to claim!")
                if claimEss then
                    targetPart = claimEss:FindFirstChild("Head") or claimEss:FindFirstChildWhichIsA("BasePart")
                end
            end
            if not targetPart and tycoon:FindFirstChild("Marker") then
                targetPart = tycoon.Marker:FindFirstChildWhichIsA("BasePart") or tycoon.Marker
            end

            if targetPart then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hrp.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
                task.wait(0.2)
                firetouchinterest(hrp, targetPart, 0)
                task.wait(0.05)
