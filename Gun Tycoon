local function createFakeCharacter(realChar)
    local ok, clone = pcall(function()
        realChar.Archivable = true
        local c = realChar:Clone()
        realChar.Archivable = false
        return c
    end)
    if not ok or not clone then return nil end

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("Sound") or descendant:IsA("Highlight") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") or descendant:IsA("Decal") then
            if descendant:IsA("BasePart") then
                descendant.Anchored = false
            end
            local realPart = realChar:FindFirstChild(descendant.Name, true)
            if descendant.Name == "HumanoidRootPart" or (realPart and realPart:IsA("BasePart") and realPart.Transparency >= 0.99) then
                descendant.Transparency = 1
            else
                descendant.Transparency = 0.5
            end
        end
    end

    invisMotor6DMap = {}
    for _, descendant in ipairs(realChar:GetDescendants()) do
        if descendant:IsA("Motor6D") then
            local current = descendant
            local path = {}
            while current and current ~= realChar do
                table.insert(path, 1, current.Name)
                current = current.Parent
            end
            local cloneCurrent = clone
            for _, name in ipairs(path) do
                cloneCurrent = cloneCurrent and cloneCurrent:FindFirstChild(name)
            end
            if cloneCurrent and cloneCurrent:IsA("Motor6D") then
                invisMotor6DMap[descendant] = cloneCurrent
            end
        end
    end

    clone.Parent = workspace
    return clone
end

local function disableInvisibility()
    if invisHeartbeatConn then
        invisHeartbeatConn:Disconnect()
        invisHeartbeatConn = nil
    end
    if invisSteppedConn then
        invisSteppedConn:Disconnect()
        invisSteppedConn = nil
    end
    if invisJumpConn then
        invisJumpConn:Disconnect()
        invisJumpConn = nil
    end

    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local fakeHRP = fakeCharacter and fakeCharacter:FindFirstChild("HumanoidRootPart")
        local returnCFrame = fakeHRP and fakeHRP.CFrame

        if fakeCharacter then
            fakeCharacter:Destroy()
            fakeCharacter = nil
        end

        if humanoidRootPart and returnCFrame then
            humanoidRootPart.CFrame = returnCFrame
            humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end

        local cam = workspace.CurrentCamera
        if cam and humanoid then
            cam.CameraSubject = humanoid
        end
    end

    if invisPlatform then
        invisPlatform:Destroy()
        invisPlatform = nil
    end

    invisMotor6DMap = {}
    InvisState.isInvisible = false
    if Config.FlyEnabled and startFly then
        startFly()
    end
    if SC_invisFloatStroke and setFloatStrokeActive then
        setFloatStrokeActive(SC_invisFloatStroke, false)
    end
    pcall(function()
        if Fluent and Fluent.Options and Fluent.Options["InvisibleToggle"] then
            Fluent.Options["InvisibleToggle"]:SetValue(false)
        end
    end)
end

local function enableInvisibility()
    local character = LocalPlayer.Character
    if not character then return end

    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoidRootPart or not humanoid then return end

    local hipHeightOffset = (humanoid.RigType ~= Enum.HumanoidRigType.R6) and (humanoid.HipHeight + humanoidRootPart.Size.Y / 2) or 3
    local originalPos = humanoidRootPart.Position
    local groundY = originalPos.Y - hipHeightOffset

    fakeCharacter = createFakeCharacter(character)
    if not fakeCharacter then return end

    local fakeHRP = fakeCharacter:FindFirstChild("HumanoidRootPart")
    local fakeHumanoid = fakeCharacter:FindFirstChildOfClass("Humanoid")
    if not fakeHRP or not fakeHumanoid then
        if fakeCharacter then
            fakeCharacter:Destroy()
            fakeCharacter = nil
        end
        return
    end

    invisPlatform = Instance.new("Part")
    invisPlatform.Name = "InvisPlatform"
    invisPlatform.Size = Vector3.new(12, 1, 12)
    invisPlatform.Anchored = true
    invisPlatform.CanCollide = true
    invisPlatform.Transparency = 1
    invisPlatform.CastShadow = false
    invisPlatform.Parent = workspace
    invisPlatform.CFrame = CFrame.new(originalPos.X, groundY + INVIS_Y_OFFSET - 0.5, originalPos.Z)

    fakeHumanoid.WalkSpeed = humanoid.WalkSpeed
    fakeHumanoid.JumpPower = humanoid.JumpPower
    fakeHumanoid.JumpHeight = humanoid.JumpHeight
    fakeHumanoid.UseJumpPower = humanoid.UseJumpPower

    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraSubject = fakeHumanoid
    end

    humanoidRootPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, INVIS_Y_OFFSET, 0)
    humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

    invisSteppedConn = RunService.Stepped:Connect(function()
        if fakeCharacter and character then
            for realMotor, fakeMotor in pairs(invisMotor6DMap) do
                if realMotor and realMotor.Parent and realMotor.Parent.Parent then
                    fakeMotor.Transform = realMotor.Transform
                end
            end
        end
    end)

    invisJumpConn = UserInputService.JumpRequest:Connect(function()
        if fakeHumanoid then
            if Config.InfJumpEnabled then
                fakeHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            else
                fakeHumanoid.Jump = true
            end
        end
    end)

    invisHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not character or not character.Parent or humanoid.Health <= 0 then
            if InvisState.isInvisible then
                disableInvisibility()
            end
            return
        end

        if humanoidRootPart and fakeCharacter and fakeCharacter.Parent and fakeHRP and fakeHRP.Parent and fakeHumanoid and invisPlatform then
            local state = fakeHumanoid:GetState()
            if (state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Seated) and state ~= humanoid:GetState() then
                humanoid:ChangeState(state)
            end

            local moveDirection = humanoid.MoveDirection
            if state == Enum.HumanoidStateType.Climbing then
                if cam then
                    local lookVector = cam.CFrame.LookVector
                    local unit = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
                    local dot = humanoid.MoveDirection:Dot(unit)
                    if dot > 0.1 then
                        moveDirection = Vector3.new(0, 1, 0)
                    elseif dot < -0.1 then
                        moveDirection = Vector3.new(0, -1, 0)
                    else
                        moveDirection = Vector3.new(0, 0, 0)
                    end
                end
            elseif state == Enum.HumanoidStateType.Swimming then
                local jumpY = (UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump) and 1 or 0
                moveDirection = Vector3.new(moveDirection.X, jumpY, moveDirection.Z)
            end

            if not Config.FlyEnabled then
                fakeHumanoid:Move(moveDirection, false)
            end
            fakeHumanoid.Jump = humanoid.Jump
            fakeHumanoid.WalkSpeed = humanoid.WalkSpeed
            fakeHumanoid.JumpPower = humanoid.JumpPower
            fakeHumanoid.JumpHeight = humanoid.JumpHeight
            fakeHumanoid.UseJumpPower = humanoid.UseJumpPower

            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.FilterDescendantsInstances = {character, invisPlatform, fakeCharacter}

            local raycastResult = workspace:Raycast(fakeHRP.Position, Vector3.new(0, -500, 0), raycastParams)
            if raycastResult then
                groundY = raycastResult.Position.Y
            else
                groundY = fakeHRP.Position.Y - hipHeightOffset
            end

            humanoidRootPart.CFrame = fakeHRP.CFrame + Vector3.new(0, INVIS_Y_OFFSET, 0)
            humanoidRootPart.AssemblyLinearVelocity = fakeHRP.AssemblyLinearVelocity
            humanoidRootPart.AssemblyAngularVelocity = fakeHRP.AssemblyAngularVelocity
            invisPlatform.CFrame = CFrame.new(humanoidRootPart.Position.X, humanoidRootPart.Position.Y - hipHeightOffset - 0.5, humanoidRootPart.Position.Z)

            if humanoidRootPart.Position.Y < groundY + INVIS_Y_OFFSET - 15 then
                humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position.X, groundY + INVIS_Y_OFFSET + hipHeightOffset + 2, humanoidRootPart.Position.Z)
                humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)

    InvisState.isInvisible = true
    if Config.FlyEnabled and startFly then
        startFly()
    end
    if SC_invisFloatStroke and setFloatStrokeActive then
        setFloatStrokeActive(SC_invisFloatStroke, true)
    end
    pcall(function()
        if Fluent and Fluent.Options and Fluent.Options["InvisibleToggle"] then
            Fluent.Options["InvisibleToggle"]:SetValue(true)
        end
    end)
end

local function toggleInvisibility(state)
    if state == nil then
        state = not InvisState.isInvisible
    end
    if state then
        if not InvisState.isInvisible then
            enableInvisibility()
        end
    else
        if InvisState.isInvisible then
            disableInvisibility()
        end
    end
end

