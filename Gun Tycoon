local function doAutoRebirth(myTycoon)
    local canRebirthVal = LocalPlayer:FindFirstChild("CanRebirth")
    if canRebirthVal and canRebirthVal:IsA("BoolValue") and not canRebirthVal.Value then
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local buttons = myTycoon:FindFirstChild("Buttons")
    if not buttons then return end

    for _, button in ipairs(buttons:GetChildren()) do
        if button.Name:lower():find("rebirth") then
            local head = button:FindFirstChild("Head") or button:FindFirstChildWhichIsA("BasePart")
            if head and head:FindFirstChild("TouchInterest") then
                firetouchinterest(hrp, head, 0)
                task.wait(0.04)
                firetouchinterest(hrp, head, 1)
            end
        end
    end

    confirmRebirthGui()

    local repStorage = game:GetService("ReplicatedStorage")
    local tycoonHelpers = repStorage:FindFirstChild("TycoonHelpers")
    local scope = tycoonHelpers or repStorage
    for _, r in ipairs(scope:GetChildren()) do
        if (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) and r.Name:lower():find("rebirth") then
            pcall(function()
                if r:IsA("RemoteEvent") then
                    r:FireServer()
                else
                    r:InvokeServer()
                end
            end)
        end
    end
end

local function isLaserObject(obj)
    local n = obj.Name:lower()
    if n:find("laser") or n:find("door") or n:find("security") or n:find("gate") or n:find("barrier") or n:find("forcefield") then
        return true
    end
    local p = obj.Parent and obj.Parent.Name:lower() or ""
    if p:find("laser") or p:find("barrier") or p:find("security") or p:find("door") then
        return true
    end
    return false
end

local function removeLasersOnce()
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and isLaserObject(desc) then
            pcall(function()
                desc.CanTouch = false
                desc.CanCollide = false
                desc.Transparency = 1
                for _, child in ipairs(desc:GetChildren()) do
                    if child:IsA("TouchTransmitter") or child:IsA("Script") then
                        child:Destroy()
                    end
                end
                desc:Destroy()
            end)
        end
    end
end

local function deleteAllBaseForcefields()
    local tycoonsFolder = workspace:FindFirstChild("Tycoons")
    local root = tycoonsFolder or workspace
    for _, desc in ipairs(root:GetDescendants()) do
        local n = desc.Name:lower()
        local pName = desc.Parent and desc.Parent.Name:lower() or ""
        if (n == "forcefield" or n:find("forcefield") or n:find("force_field")) and pName ~= "buttons" then
            pcall(function()
                if desc:IsA("BasePart") then
                    desc.CanTouch = false
                    desc.CanCollide = false
                    desc.Transparency = 1
                    for _, child in ipairs(desc:GetChildren()) do
                        if child:IsA("TouchTransmitter") or child:IsA("Script") then
                            child:Destroy()
                        end
                    end
                elseif desc:IsA("Model") then
                    for _, child in ipairs(desc:GetDescendants()) do
                        if child:IsA("BasePart") then
                            child.CanTouch = false
                            child.CanCollide = false
                            child.Transparency = 1
                            for _, c in ipairs(child:GetChildren()) do
                                if c:IsA("TouchTransmitter") or c:IsA("Script") then
                                    c:Destroy()
                                end
                            end
                        end
                    end
                end
                desc:Destroy()
            end)
        end
    end
end

