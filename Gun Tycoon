local function isBuyableButton(button)
    if not button or not button.Parent then return false end
    local bName = button.Name:lower()
    if bName:find("rebirth") or bName:find("gamepass") or bName:find("robux") or bName:find("devproduct") or bName:find("invite") or bName:find("potion") then
        return false
    end

    local checkPart = button:FindFirstChild("Head") or button:FindFirstChild("Pad") or button:FindFirstChildWhichIsA("BasePart")
    if not checkPart or not checkPart:IsA("BasePart") then return false end

    if checkPart.Transparency >= 0.95 then
        return false
    end

    local bill = button:FindFirstChildWhichIsA("BillboardGui", true)
    if bill then
        for _, c in ipairs(bill:GetDescendants()) do
            if c:IsA("TextLabel") then
                local t = c.Text:lower()
                if t:find("r$") or t:find("robux") or t:find("invite") or t:find("gamepass") or t:find("friend") then
                    return false
                end
            end
        end
    end

    local c = checkPart.Color
    local r, g, b = c.R, c.G, c.B
    if (r > 0.65 and g > 0.65 and b < 0.25) or (b > 0.6 and b > g) then
        return false
    end
    local bc = checkPart.BrickColor.Name:lower()
    if bc:find("yellow") or bc:find("purple") or bc:find("magenta") or bc:find("cyan") or bc:find("blue") or bc:find("teal") then
        return false
    end

    return true
end

