end

local lastInvisToggleTime = 0
local function toggleInvisAction()
    local now = tick()
    if now - lastInvisToggleTime < 0.25 then return end
    lastInvisToggleTime = now
    if InvisToggleObj then
        InvisToggleObj:SetValue(not InvisState.isInvisible)
    else
        toggleInvisibility(not InvisState.isInvisible)
        if SC_invisFloatStroke and setFloatStrokeActive then
            setFloatStrokeActive(SC_invisFloatStroke, InvisState.isInvisible)
        end
    end
end

local function getFlyKey()
    local k = Config.FlyKey or "F"
    if typeof(k) == "EnumItem" then return k end
    local name = tostring(k):gsub("Enum%.KeyCode%.", "")
    return Enum.KeyCode[name] or Enum.KeyCode.F
end

local function getNoclipKey()
    local k = Config.NoclipKey or "J"
    if typeof(k) == "EnumItem" then return k end
    local name = tostring(k):gsub("Enum%.KeyCode%.", "")
    return Enum.KeyCode[name] or Enum.KeyCode.J
end

local function getInvisKey()
    local k = Config.InvisKey or "C"
    if typeof(k) == "EnumItem" then return k end
    local name = tostring(k):gsub("Enum%.KeyCode%.", "")
    return Enum.KeyCode[name] or Enum.KeyCode.C
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not Config.KeybindsEnabled then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == getFlyKey() then
            toggleFly()
        elseif input.KeyCode == getNoclipKey() then
            toggleNoclip()
        elseif input.KeyCode == getInvisKey() then
            toggleInvisAction()
        end
    end
end)

local function makeDraggableFloat(btn)
    local fDragging, fMoved, fDragStart, fDragPos, fDragInput = false, false, nil, nil, nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if floatDragLocked then return end
            fDragging = true
            fMoved = false
            fDragStart = input.Position
            fDragPos = btn.Position
            fDragInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    fDragging = false
                    fDragInput = nil
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if floatDragLocked then return end
        if fDragging and (input == fDragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - fDragStart
            if delta.Magnitude > 6 then
                fMoved = true
            end
            btn.Position = UDim2.new(fDragPos.X.Scale, fDragPos.X.Offset + delta.X, fDragPos.Y.Scale, fDragPos.Y.Offset + delta.Y)
        end
    end)
