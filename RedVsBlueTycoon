setFloatStrokeActive = function(stroke, isActive)
    if not stroke then return end
    local old = stroke:FindFirstChildOfClass("UIGradient")
    if old then
        old:Destroy()
    end

    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = isActive and 2.2 or 1.6

    local grad = Instance.new("UIGradient")
    grad.Color = isActive and ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 70, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 180, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 70, 255)),
    }) or ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 0, 120)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 100, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 0, 120)),
    })
    grad.Parent = stroke
    task.spawn(function()
        TweenService:Create(grad, TweenInfo.new(3, isActive and Enum.EasingStyle.Linear or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, not isActive), {Rotation = isActive and 360 or 180}):Play()
    end)
end

local function makeDraggableFloat(btn)
    local fDragging, fMoved, fDragStart, fDragPos, fDragInput = false, false, nil, nil, nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if floatDragLocked then return end
            fDragging = true
            fMoved = false
            fDragStart = input.Position
            fDragPos = btn.Position
            fDragInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    fDragging = false
                    fDragInput = nil
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if floatDragLocked then return end
        if fDragging and (input == fDragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - fDragStart
            if delta.Magnitude > 6 then
                fMoved = true
            end
            btn.Position = UDim2.new(fDragPos.X.Scale, fDragPos.X.Offset + delta.X, fDragPos.Y.Scale, fDragPos.Y.Offset + delta.Y)
        end
    end)
    return function() return fMoved end, function() fMoved = false end
end

