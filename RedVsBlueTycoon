            startFly()
        else
            stopFly()
        end
        setFloatStrokeActive(SC_flyFloatStroke, Config.FlyEnabled)
        pcall(function()
            Fluent.Options["FlyToggle"]:SetValue(Config.FlyEnabled)
        end)
    elseif key == Config.NoclipKey then
