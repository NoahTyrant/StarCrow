						targetFrame.Visible = false
						state = false
					else
						local p = targetFrame
						while p and p:IsA("GuiObject") do
							p.Visible = true
							p = p.Parent
						end
						targetFrame.Visible = true
						targetFrame.Position =
							UDim2.new(0.5, -targetFrame.AbsoluteSize.X / 2, 0.5, -targetFrame.AbsoluteSize.Y / 2)
						state = true
					end
				end
