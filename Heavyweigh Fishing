	do
		local fakeName = "StarCrow Hub"
		local oldName = LocalPlayer.Name
		local oldDisplayName = LocalPlayer.DisplayName
		local oldUserId = tostring(LocalPlayer.UserId)
		local hideConnections = {}
		local originalTexts = setmetatable({}, { __mode = "k" })
		local isHiding = false

		local function replaceInText(text)
			if typeof(text) ~= "string" or text == "" then
				return text, false
			end
			local changed = false
			if string.find(text, oldUserId, 1, true) then
				text = string.gsub(text, oldUserId, fakeName)
				changed = true
			end
			if string.find(text, oldDisplayName, 1, true) then
				text = string.gsub(text, oldDisplayName, fakeName)
				changed = true
			end
			if string.find(text, oldName, 1, true) then
				text = string.gsub(text, oldName, fakeName)
				changed = true
			end
			return text, changed
		end

		local function handleTextObject(obj)
			if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
				return
			end
			if not originalTexts[obj] then
				originalTexts[obj] = obj.Text
			end
			local updating = false
			local function apply()
				if updating or not isHiding then
					return
				end
				local t = obj.Text
				local newT, changed = replaceInText(t)
				if changed and obj.Text ~= newT then
					updating = true
					obj.Text = newT
					updating = false
				end
			end
			apply()
			local conn = obj:GetPropertyChangedSignal("Text"):Connect(apply)
			table.insert(hideConnections, conn)
		end

		local function scanContainer(container)
			pcall(function()
				for _, v in ipairs(container:GetDescendants()) do
					if isHiding then
						handleTextObject(v)
					end
				end
				local conn = container.DescendantAdded:Connect(function(v)
					if isHiding then
						handleTextObject(v)
					end
				end)
				table.insert(hideConnections, conn)
			end)
		end

		local function updateCharacterDisplay(char)
			if not char then
				return
			end
			pcall(function()
				local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
				if hum then
					if isHiding then
						hum.DisplayName = fakeName
					else
						hum.DisplayName = (oldDisplayName ~= "" and oldDisplayName) or oldName
					end
				end
			end)
			if isHiding then
				scanContainer(char)
			end
		end

		local function ApplyHideNameAndID(enabled)
			if enabled and isHiding and #hideConnections > 0 then
				return
			end
			isHiding = enabled
			if enabled then
				scanContainer(LocalPlayer:WaitForChild("PlayerGui"))
				scanContainer(workspace)
				pcall(function()
					scanContainer(game:GetService("CoreGui"))
				end)
				if LocalPlayer.Character then
					updateCharacterDisplay(LocalPlayer.Character)
				end
				local charConn = LocalPlayer.CharacterAdded:Connect(function(char)
					task.wait(0.5)
					if isHiding then
						updateCharacterDisplay(char)
					end
				end)
				table.insert(hideConnections, charConn)
			else
				for _, conn in ipairs(hideConnections) do
					pcall(function()
						conn:Disconnect()
					end)
				end
				table.clear(hideConnections)
				for obj, orig in pairs(originalTexts) do
					pcall(function()
						if obj and obj.Parent then
							obj.Text = orig
						end
					end)
				end
				table.clear(originalTexts)
				if LocalPlayer.Character then
					updateCharacterDisplay(LocalPlayer.Character)
				end
			end
		end

