end

RunService.Heartbeat:Connect(function()
    if not FishingGui or not FishingGui.Visible then return end

    local activeReel = Config.AutoReel or Config.AutoBoss or Config.AutoSecretBoss
    local activeFinal = Config.AutoFinalPhase or Config.AutoBoss or Config.AutoSecretBoss

    if activeReel and FishingBar then
        if math.abs(FishingBar.Position.X.Scale - 0.5) > 0.005 then
            local now = os.clock()
            if now - lastReelTween >= 0.25 then
                lastReelTween = now
                FishingBar:TweenPosition(UDim2.new(0.5, 0, 0.5, 0), Enum.EasingDirection.InOut, Enum.EasingStyle.Linear, 0, true)
            end
            FishingBar.Position = UDim2.new(0.5, 0, 0.5, 0)
        end
    end

    if activeFinal and RhythmGui and RhythmGui.Visible then
        local now = os.clock()
        if now - lastRhythmScan < 0.035 then return end
        lastRhythmScan = now

        for _, lane in ipairs(rhythmLanes) do
            if now - (lastRhythmLaneHit[lane] or 0) >= 0.06 then
                local laneFrame = RhythmGui:FindFirstChild("Progression" .. lane)
                if laneFrame then
                    local barFrame = laneFrame:FindFirstChild("BarFrame")
                    local targetY = barFrame and barFrame.Position.Y.Scale or 0.85
                    local shouldHit = false
                    for _, child in ipairs(laneFrame:GetChildren()) do
                        if child.Name == "Note_FX" and child:IsA("GuiObject") and child.Visible then
                            if math.abs(child.Position.Y.Scale - targetY) <= 0.16 then
                                shouldHit = true
                                break
                            end
                        end
                    end
                    if shouldHit then
                        lastRhythmLaneHit[lane] = now
                        local btn = laneFrame:FindFirstChild("Button")
                        if not TriggerGuiButton(btn) then
                            local kc = rhythmKeyMap[lane]
                            if kc then
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(true, kc, false, game)
                                    task.delay(0.02, function()
                                        VirtualInputManager:SendKeyEvent(false, kc, false, game)
                                    end)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

local function GetModelPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChild("Head")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function IsSecretBossEntity(obj)
    if not obj then return false end
    if obj:GetAttribute("Secret") == true or obj:GetAttribute("Rarity") == "Secret" then
        return true
    end
    local rawName = tostring(obj:GetAttribute("Name") or obj:GetAttribute("FishName") or obj.Name)
    local lowerName = string.lower(rawName)
    if string.find(lowerName, "secret") or string.find(lowerName, "long diaohai") or string.find(lowerName, "wuzhi") then
        return true
    end
    local inv = Info:FindFirstChild("Inventory")
    local mod = inv and inv:FindFirstChild(rawName)
    local data = GetModuleData(mod)
    if data and (data.Secret == true or data.Rarity == "Secret" or (data.Boss == true and (tonumber(data.Chance) or 100) <= 1)) then
        return true
    end
    return false
end

local function FindBossTarget(wantSecret)
    local npcFolder = workspace:FindFirstChild("NPC")
    local bossFolder = npcFolder and npcFolder:FindFirstChild("Boss")
    local fallbackTarget = nil

    if bossFolder then
        for _, boss in ipairs(bossFolder:GetChildren()) do
            local part = GetModelPart(boss)
            if part then
                local isSec = IsSecretBossEntity(boss)
                if wantSecret and isSec then
                    return boss, part
                elseif not wantSecret and not isSec then
                    return boss, part
                elseif not fallbackTarget then
                    fallbackTarget = { obj = boss, part = part }
                end
            end
        end
    end

    local wsBoss = workspace:FindFirstChild("Boss") or workspace:FindFirstChild("BossZone")
    if wsBoss then
        local part = GetModelPart(wsBoss)
        if part then
            return wsBoss, part
        end
    end

    if fallbackTarget then
        return fallbackTarget.obj, fallbackTarget.part
    end

    return nil, nil
end

