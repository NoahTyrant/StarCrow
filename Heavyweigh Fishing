		local fakeConns = {}
		local hookedLabels = setmetatable({}, { __mode = "k" })
		local origLabelTexts = setmetatable({}, { __mode = "k" })
		local lastFakeTexts = setmetatable({}, { __mode = "k" })
		local updatingLabels = setmetatable({}, { __mode = "k" })
		local hookedBars = setmetatable({}, { __mode = "k" })
		local origBarSizes = setmetatable({}, { __mode = "k" })
		local updatingBars = setmetatable({}, { __mode = "k" })

		local FAKE_RAW = "99999999"
		local FAKE_FORMATTED = "99,999,999"

		local function ComputeFakeTextForKind(kind, baseRealText)
			if kind == "Cash" or kind == "Gems" or kind == "Tickets" or kind == "Orbs" then
				return FAKE_FORMATTED
			elseif kind == "LevelBar" then
				local src = tostring(baseRealText or "")
				local replaced, count = string.gsub(src, "^(%s*[Ll]evel%s*:%s*)[%d,]+", "%1" .. FAKE_RAW, 1)
				replaced = string.gsub(replaced, "%[[%d,%s]+/[%d,%s]+%]", "[" .. FAKE_RAW .. "/" .. FAKE_RAW .. "]")
				replaced = string.gsub(replaced, "([%d,]+)%s*/%s*([%d,]+)", FAKE_RAW .. "/" .. FAKE_RAW)
				if count > 0 then
					return replaced
				end
				return "Level: " .. FAKE_RAW .. " [" .. FAKE_RAW .. "/" .. FAKE_RAW .. "]"
			elseif kind == "ExpOnly" then
				local src = tostring(baseRealText or "")
				local replaced, count = string.gsub(src, "[%d,]+%s*/%s*[%d,]+", FAKE_RAW .. "/" .. FAKE_RAW, 1)
				if count > 0 then
					return replaced
				end
				return FAKE_RAW .. "/" .. FAKE_RAW
			elseif kind == "LevelRaw" then
				return FAKE_RAW
			end
			return nil
		end

		local function IsInsidePopupMenu(inst, mainGui)
			local cur = inst.Parent
			while cur and cur ~= mainGui do
				local n = cur.Name
				if n == "Menu" or n == "Fishing" or n == "Dialogue" or n == "Shop" or n == "Quest" or n == "Index" then
					return true
				end
				cur = cur.Parent
			end
			return false
		end

		local function ClassifyStatLabel(lbl, mainGui)
			if not lbl or not lbl:IsA("TextLabel") then
				return nil
			end
			if IsInsidePopupMenu(lbl, mainGui) then
				return nil
			end

			local mainFrame = mainGui:FindFirstChild("Main")
			local statsFrame = (mainFrame and mainFrame:FindFirstChild("Stats")) or mainGui:FindFirstChild("Stats")
			if statsFrame and lbl:IsDescendantOf(statsFrame) then
				local cur = lbl
				while cur and cur.Parent ~= statsFrame do
					cur = cur.Parent
				end
				if cur then
					local entryLower = string.lower(cur.Name)
					if string.find(entryLower, "cash", 1, true) or string.find(entryLower, "money", 1, true) or string.find(entryLower, "coin", 1, true) then
						return "Cash"
					elseif string.find(entryLower, "crystal", 1, true) or string.find(entryLower, "gem", 1, true) or string.find(entryLower, "diamond", 1, true) then
						return "Gems"
					elseif string.find(entryLower, "ticket", 1, true) then
						return "Tickets"
					elseif string.find(entryLower, "orb", 1, true) or string.find(entryLower, "essence", 1, true) then
						return "Orbs"
					end
				end
			end

			local rawText = tostring(origLabelTexts[lbl] or lbl.Text or "")
			local lowerText = string.lower(rawText)
			if
				string.find(lowerText, "unlock", 1, true)
				or string.find(lowerText, "friend", 1, true)
				or string.find(lowerText, "boost", 1, true)
				or string.find(lowerText, "luck", 1, true)
			then
				return nil
			end

			if string.match(lowerText, "^%s*level%s*:%s*[%d,]+") then
				return "LevelBar"
			end

			local fullLower = string.lower(lbl:GetFullName())
			local isBottomLeftHud = lbl.AbsolutePosition.X <= 420
			local hasDigit = string.find(rawText, "%d") ~= nil

			if
				(string.find(fullLower, "level", 1, true) or string.find(fullLower, "exp", 1, true) or string.find(fullLower, "xp", 1, true))
				and string.match(lowerText, "^[%s%[]*[%d,]+%s*/%s*[%d,]+[%s%]]*$")
			then
				return "ExpOnly"
			end

			if ((mainFrame and lbl:IsDescendantOf(mainFrame)) or isBottomLeftHud) and hasDigit then
				if string.find(fullLower, "cash", 1, true) or string.find(fullLower, "money", 1, true) or string.find(fullLower, "coin", 1, true) then
					return "Cash"
				elseif string.find(fullLower, "crystal", 1, true) or string.find(fullLower, "gem", 1, true) or string.find(fullLower, "diamond", 1, true) then
					return "Gems"
				elseif string.find(fullLower, "ticket", 1, true) then
					return "Tickets"
				elseif string.find(fullLower, "essenceorb", 1, true) or string.find(fullLower, "essence", 1, true) or string.find(fullLower, ".orb", 1, true) then
					return "Orbs"
				elseif string.find(fullLower, ".level", 1, true) and not isBottomLeftHud then
					return "LevelRaw"
				end
			end

			return nil
		end

		local function HookExpFillBarNearLabel(lbl)
			local container = lbl and lbl.Parent
			if not container or not container:IsA("GuiObject") then
				return
			end
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Frame") then
					local cLower = string.lower(child.Name)
					local sz = child.Size
					local isNameMatch = string.find(cLower, "bar", 1, true)
						or string.find(cLower, "fill", 1, true)
						or string.find(cLower, "exp", 1, true)
						or string.find(cLower, "xp", 1, true)
						or string.find(cLower, "progress", 1, true)
					local isShapeMatch = child.BackgroundTransparency < 0.85
						and sz.X.Offset == 0
						and sz.X.Scale >= 0
						and sz.X.Scale <= 1
						and sz.Y.Scale >= 0.6
					if isNameMatch or isShapeMatch then
						if origBarSizes[child] == nil then
							origBarSizes[child] = sz
						end
						local baseSz = origBarSizes[child]
						local fullSz = UDim2.new(1, 0, baseSz.Y.Scale, baseSz.Y.Offset)
						if child.Size ~= fullSz then
							updatingBars[child] = true
							child.Size = fullSz
							updatingBars[child] = false
						end
						if not hookedBars[child] then
							hookedBars[child] = true
							local bConn = child:GetPropertyChangedSignal("Size"):Connect(function()
								if updatingBars[child] or not Config.FakeStats then
									return
								end
								local curSz = child.Size
								local targetSz = UDim2.new(1, 0, curSz.Y.Scale, curSz.Y.Offset)
								if curSz ~= targetSz then
									origBarSizes[child] = curSz
									updatingBars[child] = true
									child.Size = targetSz
									updatingBars[child] = false
								end
							end)
							table.insert(fakeConns, bConn)
						end
					end
				end
			end
		end

		local function ApplyFakeToSingleLabel(lbl, kind)
			if not lbl or not lbl.Parent or not kind then
				return
			end
			if kind == "LevelBar" or kind == "ExpOnly" then
				HookExpFillBarNearLabel(lbl)
			end
			if origLabelTexts[lbl] == nil then
				origLabelTexts[lbl] = lbl.Text
			end
			local newText = ComputeFakeTextForKind(kind, origLabelTexts[lbl])
			if newText and lbl.Text ~= newText then
				updatingLabels[lbl] = true
				lastFakeTexts[lbl] = newText
				lbl.Text = newText
				updatingLabels[lbl] = false
			elseif newText then
				lastFakeTexts[lbl] = newText
			end

			if not hookedLabels[lbl] then
				hookedLabels[lbl] = kind
				local conn = lbl:GetPropertyChangedSignal("Text"):Connect(function()
					if updatingLabels[lbl] or not Config.FakeStats then
						return
					end
					local curText = lbl.Text
					if curText ~= lastFakeTexts[lbl] then
						origLabelTexts[lbl] = curText
						local refreshed = ComputeFakeTextForKind(hookedLabels[lbl], origLabelTexts[lbl])
						if refreshed and lbl.Text ~= refreshed then
							updatingLabels[lbl] = true
							lastFakeTexts[lbl] = refreshed
							lbl.Text = refreshed
							updatingLabels[lbl] = false
						end
					end
				end)
				table.insert(fakeConns, conn)
			else
				hookedLabels[lbl] = kind
			end
		end

		local function RefreshAllFakeStats()
			if not Config.FakeStats then
				return
			end
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local mg = (pg and pg:FindFirstChild("MainGui")) or MainGui
			if not mg then
				return
			end
			for _, desc in ipairs(mg:GetDescendants()) do
				if desc:IsA("TextLabel") then
					local kind = hookedLabels[desc] or ClassifyStatLabel(desc, mg)
					if kind then
						ApplyFakeToSingleLabel(desc, kind)
					end
				end
			end
		end

		local function EnableFakeStats()
			for _, c in ipairs(fakeConns) do
				pcall(function()
					c:Disconnect()
				end)
			end
			table.clear(fakeConns)
			table.clear(hookedLabels)
			table.clear(hookedBars)

			RefreshAllFakeStats()

			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				local mg = pg:FindFirstChild("MainGui")
				if mg then
					local dConn = mg.DescendantAdded:Connect(function(desc)
						if not Config.FakeStats then
							return
						end
						if desc:IsA("TextLabel") then
							task.defer(function()
								if Config.FakeStats and desc and desc.Parent then
									local kind = ClassifyStatLabel(desc, mg)
									if kind then
										ApplyFakeToSingleLabel(desc, kind)
									end
								end
							end)
						end
					end)
					table.insert(fakeConns, dConn)
				end

				local pgConn = pg.ChildAdded:Connect(function(child)
					if Config.FakeStats and child.Name == "MainGui" then
						task.delay(0.3, function()
							if Config.FakeStats then
								EnableFakeStats()
							end
						end)
					end
				end)
				table.insert(fakeConns, pgConn)
			end
		end

		local function DisableFakeStats()
			for _, c in ipairs(fakeConns) do
				pcall(function()
					c:Disconnect()
				end)
			end
			table.clear(fakeConns)
			table.clear(hookedLabels)
			table.clear(hookedBars)

			for lbl, orig in pairs(origLabelTexts) do
				pcall(function()
					if lbl and lbl.Parent then
						updatingLabels[lbl] = true
						lbl.Text = orig
						updatingLabels[lbl] = false
					end
				end)
			end
			for bar, origSz in pairs(origBarSizes) do
				pcall(function()
					if bar and bar.Parent then
						updatingBars[bar] = true
						bar.Size = origSz
						updatingBars[bar] = false
					end
				end)
			end
			table.clear(origLabelTexts)
			table.clear(lastFakeTexts)
			table.clear(origBarSizes)
		end

