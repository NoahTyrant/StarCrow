	(function()
		local savedUltraProps = setmetatable({}, { __mode = "k" })
		local ultraConns = {}
		local ultraGeneration = 0
		local NIL_MARKER = {}

		local function RecordAndSet(inst, prop, newVal)
			if not inst then
				return
			end
			local bucket = savedUltraProps[inst]
			if not bucket then
				bucket = {}
				savedUltraProps[inst] = bucket
			end
			if bucket[prop] == nil then
				local ok, cur = pcall(function()
					return inst[prop]
				end)
				if ok then
					bucket[prop] = cur == nil and NIL_MARKER or cur
				end
			end
			pcall(function()
				inst[prop] = newVal
			end)
		end

		local function DisconnectUltraConns()
			for _, c in ipairs(ultraConns) do
				pcall(function()
					c:Disconnect()
				end)
			end
			table.clear(ultraConns)
		end

		local function IsStarCrowManaged(inst)
			local n = tostring(inst and inst.Name or "")
			return string.sub(n, 1, 8) == "StarCrow"
		end

		local function ApplyUltraToInstance(inst)
			if not inst or IsStarCrowManaged(inst) then
				return
			end
			if inst:IsA("BasePart") then
				RecordAndSet(inst, "Material", Enum.Material.SmoothPlastic)
				RecordAndSet(inst, "Reflectance", 0)
				RecordAndSet(inst, "CastShadow", false)
				RecordAndSet(inst, "MaterialVariant", "")
				if inst:IsA("MeshPart") then
					RecordAndSet(inst, "TextureID", "")
				end
			elseif inst:IsA("SpecialMesh") then
				RecordAndSet(inst, "TextureId", "")
				RecordAndSet(inst, "VertexColor", Vector3.new(1, 1, 1))
			elseif inst:IsA("Decal") or inst:IsA("Texture") then
				RecordAndSet(inst, "Transparency", 1)
				RecordAndSet(inst, "Texture", "")
			elseif inst:IsA("SurfaceAppearance") then
				RecordAndSet(inst, "Parent", nil)
			elseif inst:IsA("Sky") then
				RecordAndSet(inst, "SkyboxBk", "")
				RecordAndSet(inst, "SkyboxDn", "")
				RecordAndSet(inst, "SkyboxFt", "")
				RecordAndSet(inst, "SkyboxLf", "")
				RecordAndSet(inst, "SkyboxRt", "")
				RecordAndSet(inst, "SkyboxUp", "")
				RecordAndSet(inst, "CelestialBodiesShown", false)
			elseif
				inst:IsA("ParticleEmitter")
				or inst:IsA("Trail")
				or inst:IsA("Beam")
				or inst:IsA("Smoke")
				or inst:IsA("Fire")
				or inst:IsA("Sparkles")
				or inst:IsA("Highlight")
				or inst:IsA("Light")
				or inst:IsA("PostEffect")
			then
				RecordAndSet(inst, "Enabled", false)
			elseif inst:IsA("Atmosphere") or inst:IsA("Clouds") then
				RecordAndSet(inst, "Parent", nil)
			elseif inst:IsA("Explosion") then
				RecordAndSet(inst, "Visible", false)
			end
		end

		local function RestoreUltraFPSBoost()
			ultraGeneration = ultraGeneration + 1
			local myGen = ultraGeneration
			DisconnectUltraConns()
			task.spawn(function()
				local count = 0
				for inst, props in pairs(savedUltraProps) do
					if myGen ~= ultraGeneration then
						return
					end
					if inst then
						if props.Parent ~= nil then
							local pVal = props.Parent ~= NIL_MARKER and props.Parent or nil
							pcall(function()
								inst.Parent = pVal
							end)
						end
						for prop, orig in pairs(props) do
							if prop ~= "Parent" then
								local rVal = orig ~= NIL_MARKER and orig or nil
								pcall(function()
									inst[prop] = rVal
								end)
							end
						end
					end
					savedUltraProps[inst] = nil
					count = count + 1
					if count % 350 == 0 then
						task.wait()
					end
				end
				pcall(function()
					local s = settings()
					s.Rendering.QualityLevel = Enum.QualityLevel.Automatic
				end)
				if Config.FullBright or Config.NoFog then
					pcall(ApplyLightingSettings)
				end
			end)
		end

		local function EnableUltraFPSBoost()
			ultraGeneration = ultraGeneration + 1
			local myGen = ultraGeneration
			DisconnectUltraConns()
			task.spawn(function()
				pcall(function()
					if setfpscap then
						setfpscap(999)
					end
				end)
				pcall(function()
					local s = settings()
					s.Rendering.QualityLevel = Enum.QualityLevel.Level01
					s.Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
				end)
				RecordAndSet(Lighting, "GlobalShadows", false)
				RecordAndSet(Lighting, "FogEnd", 9e9)
				RecordAndSet(Lighting, "FogStart", 9e9)
				RecordAndSet(Lighting, "ShadowSoftness", 0)
				RecordAndSet(Lighting, "EnvironmentDiffuseScale", 0)
				RecordAndSet(Lighting, "EnvironmentSpecularScale", 0)

				local terrain = workspace:FindFirstChildOfClass("Terrain")
				if terrain then
					RecordAndSet(terrain, "Decoration", false)
					RecordAndSet(terrain, "WaterWaveSize", 0)
					RecordAndSet(terrain, "WaterWaveSpeed", 0)
					RecordAndSet(terrain, "WaterReflectance", 0)
					RecordAndSet(terrain, "WaterTransparency", 1)
					RecordAndSet(terrain, "WaterColor", Color3.fromRGB(245, 245, 245))
				end

				local function WatchContainer(container)
					table.insert(
						ultraConns,
						container.DescendantAdded:Connect(function(child)
							if Config.UltraFPSBoost and myGen == ultraGeneration then
								task.defer(function()
									if Config.UltraFPSBoost then
										pcall(ApplyUltraToInstance, child)
									end
								end)
							end
						end)
					)
				end

				WatchContainer(workspace)
				WatchContainer(Lighting)

				local count = 0
				for _, container in ipairs({ Lighting, workspace }) do
					for _, desc in ipairs(container:GetDescendants()) do
						if myGen ~= ultraGeneration or not Config.UltraFPSBoost then
							return
						end
						pcall(ApplyUltraToInstance, desc)
						count = count + 1
						if count % 300 == 0 then
							task.wait()
						end
					end
				end

				pcall(function()
					collectgarbage("collect")
				end)
			end)
		end

		Tabs.Player:AddToggle("UltraFPSBoostToggle", {
			Title = "Ultra FPS Boost",
			Default = Config.UltraFPSBoost,
			Callback = function(Value)
				Config.UltraFPSBoost = Value
				SaveConfig()
				if Value then
					EnableUltraFPSBoost()
				else
					RestoreUltraFPSBoost()
				end
			end,
		})

		if Config.UltraFPSBoost then
			EnableUltraFPSBoost()
		end
	end)()

