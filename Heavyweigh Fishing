local function GetBuyableBaits()
    local list = {}
    local seen = {}
    local baitFolder = Info:FindFirstChild("Bait")
    if baitFolder then
        for _, child in pairs(baitFolder:GetChildren()) do
            local ok, data = pcall(require, child)
            if ok and type(data) == "table" and not data.Ingredient then
                seen[child.Name] = true
                table.insert(list, child.Name)
            end
        end
    end
    local invFolder = Info:FindFirstChild("Inventory")
    if invFolder then
        for _, child in pairs(invFolder:GetChildren()) do
            if not seen[child.Name] then
                local ok, data = pcall(require, child)
                if ok and type(data) == "table" and data.Type == "Bait" and not data.Ingredient then
                    seen[child.Name] = true
                    table.insert(list, child.Name)
                end
            end
        end
    end
    local itemFolder = Info:FindFirstChild("Item")
    if itemFolder then
        for _, child in pairs(itemFolder:GetChildren()) do
            if not seen[child.Name] then
                local ok, data = pcall(require, child)
                if ok and type(data) == "table" and data.Type == "Bait" and not data.Ingredient then
                    seen[child.Name] = true
                    table.insert(list, child.Name)
                end
            end
        end
    end
    table.sort(list)
    return list
end

