local function FindSpecialEntities()
	local candidatesMaoshan = {}
	local candidatesTaoist = {}

	local function checkCandidate(desc, folderName)
		if not desc or desc:IsA("Folder") then
			return
		end
		if not (desc:IsA("Model") or desc:IsA("BasePart")) then
			return
		end
		local dName = tostring(desc.Name or "")
		local aName = tostring(desc:GetAttribute("Name") or "")
		if dName == "God" or dName == "Lamp" or (dName == "" and aName == "") then
			return
		end
		local part = GetModelPart(desc)
		local pos = nil
		local cf = nil
		if part and part:IsDescendantOf(workspace) then
			pos = part.Position
			cf = part.CFrame
		elseif desc:IsA("PVInstance") then
			local ok, pcf = pcall(function()
				return desc:GetPivot()
			end)
			if ok and pcf and pcf.Position.Magnitude > 1 then
				pos = pcf.Position
				cf = pcf
			end
		end
		if not pos then
			return
		end

		local dLower = string.lower(string.gsub(dName, "%s+", ""))
		local aLower = string.lower(string.gsub(aName, "%s+", ""))

		local isMao = string.find(dLower, "maoshan", 1, true)
			or string.find(dLower, "maosan", 1, true)
			or string.find(aLower, "maoshan", 1, true)
			or string.find(aLower, "maosan", 1, true)

		local isTao = string.find(dLower, "taoist", 1, true)
			or string.find(dLower, "taosi", 1, true)
			or string.find(aLower, "taoist", 1, true)
			or string.find(aLower, "taosi", 1, true)

		if not isMao and not isTao then
			for _, attrVal in pairs(desc:GetAttributes()) do
				local valLower = string.lower(string.gsub(tostring(attrVal), "%s+", ""))
				if string.find(valLower, "maoshan", 1, true) or string.find(valLower, "maosan", 1, true) then
					isMao = true
					break
				elseif string.find(valLower, "taoist", 1, true) or string.find(valLower, "taosi", 1, true) then
					isTao = true
					break
				end
			end
		end

		if isMao then
			table.insert(candidatesMaoshan, { part = part, pos = pos, cf = cf, folder = folderName, obj = desc })
		elseif isTao then
			table.insert(candidatesTaoist, { part = part, pos = pos, cf = cf, folder = folderName, obj = desc })
		end
	end

	local wsNPC = workspace:FindFirstChild("NPC")
	if wsNPC then
		for _, desc in ipairs(wsNPC:GetDescendants()) do
			checkCandidate(desc, "NPC")
		end
	end

	local finalMaoshan = candidatesMaoshan[1] or nil
	local finalTaoist = candidatesTaoist[1] or nil

	local godSpirits = FindAllGodSpirits()
	return finalMaoshan, finalTaoist, godSpirits
end

local ActiveEntityESPs = {}

local function destroyEntityESPEntry(entry)
	if not entry then
		return
	end
	if type(entry) == "userdata" then
		pcall(function()
			entry:Destroy()
		end)
		return
	end
	if entry.gui then
		pcall(function()
			entry.gui:Destroy()
		end)
		entry.gui = nil
	end
	if entry.hl then
		pcall(function()
			entry.hl:Destroy()
		end)
		entry.hl = nil
	end
	if entry.att then
		pcall(function()
			entry.att:Destroy()
		end)
		entry.att = nil
	end
end

local function applyEntityESP(targetInfo, tag, title)
	if not targetInfo or not targetInfo.pos then
		return
	end
	local purpleFill = Color3.fromRGB(170, 50, 255)
	local purpleOutline = Color3.fromRGB(225, 165, 255)
	local purpleText = Color3.fromRGB(195, 100, 255)
	local part = targetInfo.part
	local obj = targetInfo.obj or part
	local pos = targetInfo.pos

	local entry = ActiveEntityESPs[tag]
	if not entry or type(entry) ~= "table" then
		if entry then
			destroyEntityESPEntry(entry)
		end
		entry = {}
		ActiveEntityESPs[tag] = entry
	end

	local adornee = nil
	if part and part:IsDescendantOf(workspace) then
		adornee = part
		if entry.att then
			pcall(function()
				entry.att:Destroy()
			end)
			entry.att = nil
		end
	else
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			if not (entry.att and entry.att.Parent == terrain) then
				local att = Instance.new("Attachment")
				att.Name = "StarCrowEntityAtt_" .. tag
				att.Parent = terrain
				entry.att = att
			end
			entry.att.WorldPosition = pos
			adornee = entry.att
		end
	end

	if obj and part and part:IsDescendantOf(workspace) then
		if not (entry.hl and entry.hl.Parent == obj) then
			if entry.hl then
				pcall(function()
					entry.hl:Destroy()
				end)
			end
			local hl = Instance.new("Highlight")
			hl.Name = "StarCrowEntityHL_" .. tag
			hl.Adornee = obj
			hl.FillColor = purpleFill
			hl.OutlineColor = purpleOutline
			hl.FillTransparency = 0.35
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = obj
			entry.hl = hl
		else
			entry.hl.FillColor = purpleFill
			entry.hl.OutlineColor = purpleOutline
			entry.hl.Enabled = true
		end
	elseif entry.hl then
		pcall(function()
			entry.hl:Destroy()
		end)
		entry.hl = nil
	end

	if adornee then
		if not (entry.gui and entry.gui.Parent) then
			local esp = Instance.new("BillboardGui")
			esp.Name = "StarCrowEntityESP"
			esp.Size = UDim2.new(0, 220, 0, 26)
			esp.StudsOffset = Vector3.new(0, 3.5, 0)
			esp.AlwaysOnTop = true
			esp.MaxDistance = math.huge
			local text = Instance.new("TextLabel")
			text.Name = "NameText"
			text.Parent = esp
			text.Size = UDim2.new(1, 0, 1, 0)
			text.BackgroundTransparency = 1
			text.TextScaled = false
			text.TextSize = 13
			text.Font = Enum.Font.GothamBold
			text.TextColor3 = purpleText
			text.TextStrokeTransparency = 0
			text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			text.TextXAlignment = Enum.TextXAlignment.Center
			entry.gui = esp
		end
		entry.gui.Adornee = adornee
		if entry.gui.Parent ~= adornee then
			entry.gui.Parent = adornee
		end
		local nameLabel = entry.gui:FindFirstChild("NameText")
		if nameLabel then
			nameLabel.TextColor3 = purpleText
			nameLabel.Text = title
		end
	end
end

local function clearEntityESP(tag)
	if tag then
		if tag == "GodSpirit" then
			for k, entry in pairs(ActiveEntityESPs) do
				if string.find(k, "GodSpirit_") then
					destroyEntityESPEntry(entry)
					ActiveEntityESPs[k] = nil
				end
			end
		else
			if ActiveEntityESPs[tag] then
				destroyEntityESPEntry(ActiveEntityESPs[tag])
				ActiveEntityESPs[tag] = nil
			end
		end
	else
		for k, entry in pairs(ActiveEntityESPs) do
			destroyEntityESPEntry(entry)
			ActiveEntityESPs[k] = nil
		end
	end
end

local function updateEntityESP(finalMaoshan, finalTaoist, godSpirits)
	if Config.ESPMaoshan and finalMaoshan then
		applyEntityESP(finalMaoshan, "Maoshan", "Maoshan")
	else
		clearEntityESP("Maoshan")
	end

	if Config.ESPTaoist and finalTaoist then
		applyEntityESP(finalTaoist, "Taoist", "Taoist")
	else
		clearEntityESP("Taoist")
	end

	if Config.ESPGodSpirit and #godSpirits > 0 then
		local currentKeys = {}
		for _, g in ipairs(godSpirits) do
			local tag = "GodSpirit_" .. g.lower
			currentKeys[tag] = true
			local dispName = g.lower == "yellow" and "Yellow"
				or (g.lower == "green" and "Green" or (g.lower == "blue" and "Blue" or (string.upper(string.sub(g.lower, 1, 1)) .. string.sub(g.lower, 2))))
			applyEntityESP(g, tag, dispName)
		end
		for k, _ in pairs(ActiveEntityESPs) do
			if string.find(k, "GodSpirit_") and not currentKeys[k] then
				clearEntityESP(k)
			end
		end
	else
		for k, _ in pairs(ActiveEntityESPs) do
			if string.find(k, "GodSpirit_") then
				clearEntityESP(k)
			end
		end
	end
end

