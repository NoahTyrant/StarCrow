local flyConnection = nil
local jumpStateConnection = nil

local function startFly()
	local char = LocalPlayer.Character
	if not char then
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if not hrp or not humanoid then
		return
	end

	humanoid.PlatformStand = true

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Velocity = Vector3.zero
	bv.Parent = hrp

	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.P = 1e7
	bg.D = 12000
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	jumpStateConnection = humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall then
			humanoid.PlatformStand = true
		end
	end)

	flyConnection = RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		local move = Vector3.zero
		local md = humanoid.MoveDirection

		if md.Magnitude > 0 then
			local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)

			if flatLook.Magnitude > 0.01 and flatRight.Magnitude > 0.01 then
				local fwdAmt = md:Dot(flatLook.Unit)
				local rightAmt = md:Dot(flatRight.Unit)

				move += cam.CFrame.LookVector * fwdAmt
				move += cam.CFrame.RightVector * rightAmt
			end
		end

		if move.Magnitude > 0 then
			move = move.Unit
		end
		bv.Velocity = move * Config.FlySpeed * 50
		local look = cam.CFrame.LookVector
		bg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + look, Vector3.new(0, 1, 0))
	end)
end

local function stopFly()
	local char = LocalPlayer.Character
	if not char then
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.PlatformStand = false
	end
	if jumpStateConnection then
		jumpStateConnection:Disconnect()
		jumpStateConnection = nil
	end
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if hrp then
		for _, v in pairs(hrp:GetChildren()) do
			if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
				v:Destroy()
			end
		end
	end
end

local IsBuyingSecretRod = false
local SetSkyFarm, SetSkyFarmHeight

do
	local SKY_PLATFORM_NAME = "StarCrow_MainSkyFarmPlatform"
	local skyPlatform = nil
	local skyHeartbeatConn = nil
	local skySavedY = nil
	local skyAnchorX = nil
	local skyAnchorZ = nil
	local skyAnchorRot = nil

	local function DestroySkyPlatform()
		if skyHeartbeatConn then
			pcall(function()
				skyHeartbeatConn:Disconnect()
			end)
			skyHeartbeatConn = nil
		end
		if skyPlatform then
			pcall(function()
				skyPlatform:Destroy()
			end)
			skyPlatform = nil
		end
		local leftover = workspace:FindFirstChild(SKY_PLATFORM_NAME)
		if leftover then
			pcall(function()
				leftover:Destroy()
			end)
		end
	end

	local function EnsureSkyFarmPlatform(x, h, z)
		if not (skyPlatform and skyPlatform.Parent == workspace) then
			local old = workspace:FindFirstChild(SKY_PLATFORM_NAME)
			if old then
				pcall(function()
					old:Destroy()
				end)
			end
			local p = Instance.new("Part")
			p.Name = SKY_PLATFORM_NAME
			p.Anchored = true
			p.CanCollide = true
			p.CanTouch = false
			p.CanQuery = false
			p.Transparency = 1
			p.CastShadow = false
			p.Size = Vector3.new(320, 1, 320)
			p.CFrame = CFrame.new(x, h - 3.5, z)
			p.Parent = workspace
			skyPlatform = p
		else
			skyPlatform.CFrame = CFrame.new(x, h - 3.5, z)
		end
		return skyPlatform
	end

	local function SnapCharacterToSky(h, useSavedAnchor)
		local c = LocalPlayer.Character or cachedChar
		local hrp = (c and c:FindFirstChild("HumanoidRootPart")) or cachedHrp
		if not hrp then
			return
		end
		local targetX = (useSavedAnchor and skyAnchorX) or hrp.Position.X
		local targetZ = (useSavedAnchor and skyAnchorZ) or hrp.Position.Z
		local rot = (useSavedAnchor and skyAnchorRot) or hrp.CFrame.Rotation
		skyAnchorX = targetX
		skyAnchorZ = targetZ
		skyAnchorRot = rot
		EnsureSkyFarmPlatform(targetX, h, targetZ)
		pcall(function()
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
		hrp.CFrame = CFrame.new(targetX, h, targetZ) * rot
	end

	SetSkyFarm = function(enabled, restoreAnchor)
		Config.SkyFarm = enabled == true
		if not Config.SkyFarm then
			DestroySkyPlatform()
			local prevY = skySavedY
			local prevX = skyAnchorX
			local prevZ = skyAnchorZ
			skySavedY = nil
			skyAnchorX = nil
			skyAnchorZ = nil
			skyAnchorRot = nil
			local c = LocalPlayer.Character or cachedChar
			local hrp = (c and c:FindFirstChild("HumanoidRootPart")) or cachedHrp
			if hrp and prevY then
				pcall(function()
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end)
				hrp.CFrame = CFrame.new(prevX or hrp.Position.X, prevY, prevZ or hrp.Position.Z) * hrp.CFrame.Rotation
			end
			return
		end

		local h = math.clamp(math.floor(tonumber(Config.SkyFarmHeight) or 609), 100, 1000)
		Config.SkyFarmHeight = h
		local c = LocalPlayer.Character or cachedChar
		local hrp = (c and c:FindFirstChild("HumanoidRootPart")) or cachedHrp
		if hrp and not skySavedY then
			skySavedY = hrp.Position.Y
			skyAnchorX = hrp.Position.X
			skyAnchorZ = hrp.Position.Z
			skyAnchorRot = hrp.CFrame.Rotation
		end
		SnapCharacterToSky(h, restoreAnchor == true)

		if not skyHeartbeatConn then
			skyHeartbeatConn = RunService.Heartbeat:Connect(function()
				if not Config.SkyFarm then
					task.defer(DestroySkyPlatform)
					return
				end
				if IsCheckingSacredBeast or IsBuyingSecretRod or Config.AutoBoss or Config.AutoSecretBoss then
					return
				end
				local curChar = LocalPlayer.Character or cachedChar
				local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
				if not curHrp then
					return
				end
				local curH = math.clamp(math.floor(tonumber(Config.SkyFarmHeight) or 609), 100, 1000)
				skyAnchorX = curHrp.Position.X
				skyAnchorZ = curHrp.Position.Z
				skyAnchorRot = curHrp.CFrame.Rotation
				EnsureSkyFarmPlatform(curHrp.Position.X, curH, curHrp.Position.Z)
				if math.abs(curHrp.Position.Y - curH) > 15 then
					pcall(function()
						curHrp.AssemblyLinearVelocity = Vector3.zero
					end)
					curHrp.CFrame = CFrame.new(curHrp.Position.X, curH, curHrp.Position.Z) * curHrp.CFrame.Rotation
				end
			end)
		end
	end

	SetSkyFarmHeight = function(val)
		local h = math.clamp(math.floor(tonumber(val) or 609), 100, 1000)
		Config.SkyFarmHeight = h
		if Config.SkyFarm and not (IsCheckingSacredBeast or IsBuyingSecretRod or Config.AutoBoss or Config.AutoSecretBoss) then
			SnapCharacterToSky(h, false)
		end
	end

	DestroySkyPlatform()
end

