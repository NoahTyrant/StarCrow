			local pb = b.price or math.huge
			if pa ~= pb then
				return pa < pb
			end
			return a.name < b.name
		end)
		local options = {}
		for _, item in ipairs(entries) do
			local meta = {
				kind = "secret",
				name = item.name,
				price = item.price,
				label = item.name,
			}
			RodChoiceLookup[item.name] = meta
			table.insert(options, item.name)
		end
		return options
	end

	DoBuyRodByChoice = function(choiceStr, fallbackKind)
		local raw = tostring(choiceStr or "")
		if raw == "" then
			return
		end
		if next(RodChoiceLookup) == nil then
			GetNormalBuyRodOptions()
			GetSecretBuyRodOptions()
		end
		local strippedName = string.match(raw, "^(.-)%s+%-%s+") or raw
		local meta = RodChoiceLookup[raw] or RodChoiceLookup[strippedName]
		if not meta then
			meta = {
				kind = fallbackKind or "normal",
				name = strippedName,
			}
		end

		task.spawn(function()
			local boughtOk = false
			local failMsg = nil

			local ok, err = pcall(function()
				local buyEv = Events:FindFirstChild("BuyFishingRod") or Events:WaitForChild("BuyFishingRod", 3)
				if buyEv then
					if buyEv:IsA("RemoteEvent") then
						buyEv:FireServer(meta.name)
					elseif buyEv:IsA("RemoteFunction") then
						buyEv:InvokeServer(meta.name)
					end
					boughtOk = true
				else
					failMsg = "Remote BuyFishingRod not found"
				end
			end)

			if ok and boughtOk then
				Fluent:Notify({
					Title = "Buy Rod",
					Content = SanitizeUIText("Bought " .. meta.name),
					Duration = 2.5,
				})
			else
				Fluent:Notify({
					Title = "Buy Rod",
					Content = SanitizeUIText(failMsg or tostring(err)),
					Duration = 3,
				})
			end
		end)
	end

