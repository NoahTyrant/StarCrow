local function FindAllGodSpirits()
	local results = {}
	local seen = {}

	local function resolveEntityTarget(desc)
		local part = GetModelPart(desc)
		if part and part:IsDescendantOf(workspace) then
			return part.Position, part.CFrame, part, desc
		end
		if desc:IsA("PVInstance") then
			local ok, cf = pcall(function()
				return desc:GetPivot()
			end)
			if ok and cf and cf.Position.Magnitude > 1 then
				return cf.Position, cf, nil, desc
			end
		end
		return nil, nil, nil, nil
	end

	local function checkObj(desc)
		if not desc or desc:IsA("Folder") then
			return
		end
		if not (desc:IsA("Model") or desc:IsA("BasePart")) then
			return
		end
		local dName = tostring(desc.Name or "")
		local aName = tostring(desc:GetAttribute("Name") or "")
		if dName == "God" or dName == "Lamp" or aName == "God" or aName == "Lamp" then
			return
		end
		local dLower = string.lower(string.gsub(dName, "%s+", ""))
		local aLower = string.lower(string.gsub(aName, "%s+", ""))

		local col = nil
		if string.find(dLower, "yellow", 1, true) or string.find(aLower, "yellow", 1, true) then
			col = "yellow"
		elseif string.find(dLower, "green", 1, true) or string.find(aLower, "green", 1, true) then
			col = "green"
		elseif string.find(dLower, "blue", 1, true) or string.find(aLower, "blue", 1, true) then
			col = "blue"
		end

		local isInsideGod = false
		local p = desc.Parent
		while p and p ~= workspace do
			if p.Name == "God" then
				isInsideGod = true
				break
			end
			p = p.Parent
		end

		if not col and isInsideGod then
			col = dLower ~= "" and dLower or "yellow"
		end

		if col and not seen[col] then
			local pos, cf, part, obj = resolveEntityTarget(desc)
			if pos then
				seen[col] = true
				table.insert(results, {
					name = (dName ~= "" and dName ~= "God") and dName or col,
					part = part,
					obj = obj,
					pos = pos,
					cf = cf,
					lower = col,
				})
			end
		end
	end

	local npcGod = workspace:FindFirstChild("NPC") and workspace.NPC:FindFirstChild("God")
	if npcGod then
		for _, child in ipairs(npcGod:GetChildren()) do
			checkObj(child)
		end
		if #results > 0 then
			return results
		end
	end

	local godFolder = workspace:FindFirstChild("God")
	if godFolder then
		for _, child in ipairs(godFolder:GetChildren()) do
			checkObj(child)
		end
		if #results > 0 then
			return results
		end
	end

	local gsFolder = workspace:FindFirstChild("GodSpirit")
	if gsFolder then
		for _, child in ipairs(gsFolder:GetChildren()) do
			checkObj(child)
		end
		if #results > 0 then
			return results
		end
	end

	return results
end

