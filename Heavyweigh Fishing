local function SendDiscordWebhook(rawUrl, title, description, customColor, extraFields)
	local url = tostring(rawUrl or ""):gsub("%s+", "")
	if url == "" then
		return false
	end
	if not (string.find(url, "discord.com/api/webhooks") or string.find(url, "discordapp.com/api/webhooks") or string.find(url, "webhook")) then
		return false
	end
	local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	if not req then
		return false
	end
	local fields = {}
	if type(extraFields) == "table" then
		for _, f in ipairs(extraFields) do
			table.insert(fields, f)
		end
	end
	table.insert(fields, {
		name = "Server JobId",
		value = tostring(game.JobId),
		inline = false,
	})
	local payload = {
		embeds = {
			{
				title = title,
				description = description,
				color = customColor or 65280,
				fields = fields,
				footer = {
					text = "StarCrow Hub",
				},
				timestamp = DateTime.now():ToIsoDate(),
			},
		},
	}
	local ok, res = pcall(function()
		return req({
			Url = url,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode(payload),
		})
	end)
	if ok and res then
		local sc = res.StatusCode or res.status_code or res.Status
		if sc and tonumber(sc) and tonumber(sc) >= 200 and tonumber(sc) < 300 then
			return true
		end
		if not sc then
			return true
		end
	end
	return false
end

