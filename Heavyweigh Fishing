local lastSellTime = 0

local function DoBuyBait(baitName, amount)
    if not baitName or baitName == "" then return end
    local amt = math.max(1, math.floor(tonumber(amount) or 1))
    local buyEvent = Events:FindFirstChild("BuyBait") or Events:FindFirstChild("Bait") or Events:FindFirstChild("PurchaseBait") or Events:FindFirstChild("BaitShop") or Events:FindFirstChild("BuyItem")
    pcall(function()
        if buyEvent then
            if buyEvent:IsA("RemoteEvent") then
                buyEvent:FireServer(baitName, amt)
            elseif buyEvent:IsA("RemoteFunction") then
                buyEvent:InvokeServer(baitName, amt)
            end
        else
            CraftBaitEvent:FireServer(baitName, amt)
        end
    end)
end

