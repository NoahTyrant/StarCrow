	local function MatchSacredBossKind(inst)
		if not inst or not (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")) then
			return nil
		end
		if inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) then
			return nil
		end
		local candidates = {
			inst.Name,
			inst:GetAttribute("FishName"),
			inst:GetAttribute("Name"),
		}
		local fnVal = inst:FindFirstChild("FishName")
		if fnVal and fnVal:IsA("StringValue") then
			table.insert(candidates, fnVal.Value)
		end
		for _, raw in ipairs(candidates) do
			if raw and raw ~= "" then
				local norm = string.lower(tostring(raw)):gsub("[_%-]+", " "):gsub("%s+", " ")
				if string.find(norm, "black tortoise", 1, true) then
					return "BlackTortoise"
				elseif
					string.find(norm, "vermilion", 1, true)
					or string.find(norm, "vermillion", 1, true)
					or string.find(norm, "birdblood", 1, true)
				then
					return "Vermilion"
				elseif
					string.find(norm, "nameless octoparasite", 1, true)
					or string.find(norm, "octoparasite", 1, true)
				then
					return "Nameless"
				end
			end
		end
		return nil
	end

	local function FindSacredBossTargets()
		local foundBT = nil
		local foundVermi = nil
		local foundNameless = nil
		local ocean = workspace:FindFirstChild("Ocean")
		local npcFolder = workspace:FindFirstChild("NPC")
		local containers = {
			workspace:FindFirstChild("WorldBoss"),
			workspace:FindFirstChild("Boss"),
			workspace:FindFirstChild("BossSetUp"),
			ocean and ocean:FindFirstChild("Boss"),
			npcFolder and npcFolder:FindFirstChild("Boss"),
			workspace:FindFirstChild("Fishes"),
		}

		local function normalizeBossNode(node)
			if not node then
				return nil
			end
			if node:IsA("Model") or node:IsA("BasePart") then
				return node
			end
			if node:IsA("Folder") then
				local m = node:FindFirstChildWhichIsA("Model")
				if m then
					return m
				end
				return node
			end
			if node.Parent and (node.Parent:IsA("Model") or node.Parent:IsA("BasePart")) then
				return node.Parent
			end
			return nil
		end

		local function inspectNode(node)
			local kind = MatchSacredBossKind(node)
			if not kind then
				return
			end
			local resolved = normalizeBossNode(node)
			if not resolved then
				return
			end
			if kind == "BlackTortoise" and not foundBT then
				foundBT = resolved
			elseif kind == "Vermilion" and not foundVermi then
				foundVermi = resolved
			elseif kind == "Nameless" and not foundNameless then
				foundNameless = resolved
			end
		end

		for _, c in ipairs(containers) do
			if c then
				inspectNode(c)
				for _, desc in ipairs(c:GetDescendants()) do
					inspectNode(desc)
					if foundBT and foundVermi and foundNameless then
						return foundBT, foundVermi, foundNameless
					end
				end
			end
		end

		if ocean and not (foundBT and foundVermi and foundNameless) then
			if not foundNameless then
				local directNl = ocean:FindFirstChild("Nameless Octoparasite", true)
				if directNl then
					foundNameless = normalizeBossNode(directNl)
				end
			end
			if not foundBT then
				local directBt = ocean:FindFirstChild("Black Tortoise Bloodline", true)
				if directBt then
					foundBT = normalizeBossNode(directBt)
				end
			end
			if not foundVermi then
				local directVm = ocean:FindFirstChild("Vermilion Birdblood", true)
				if directVm then
					foundVermi = normalizeBossNode(directVm)
				end
			end
			if not (foundBT and foundVermi and foundNameless) then
				for _, child in ipairs(ocean:GetChildren()) do
					if child.Name ~= "Water" and child.Name ~= "Boss" then
						inspectNode(child)
						for _, desc in ipairs(child:GetDescendants()) do
							inspectNode(desc)
							if foundBT and foundVermi and foundNameless then
								return foundBT, foundVermi, foundNameless
							end
						end
					end
				end
			end
		end

		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Model") then
				inspectNode(child)
				if foundBT and foundVermi and foundNameless then
					break
				end
			end
		end

		return foundBT, foundVermi, foundNameless
	end

