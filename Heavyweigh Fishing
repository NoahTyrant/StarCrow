		local VISITED_FILE = SAVE_FOLDER .. "/VisitedServers.json"
		local VISITED_EXPIRE_SEC = 300

		local function LoadVisitedServers()
			local visited = {}
			local now = os.time()
			pcall(function()
				if isfile(VISITED_FILE) then
					local decoded = HttpService:JSONDecode(readfile(VISITED_FILE))
					if type(decoded) == "table" then
						for jobId, ts in pairs(decoded) do
							if type(jobId) == "string" and tonumber(ts) and (now - tonumber(ts)) < VISITED_EXPIRE_SEC then
								visited[jobId] = tonumber(ts)
							end
						end
					end
				end
			end)
			if game.JobId and game.JobId ~= "" then
				visited[tostring(game.JobId)] = now
			end
			return visited
		end

		local function SaveVisitedServers(visited)
			pcall(function()
				if not isfolder(SAVE_FOLDER) then
					makefolder(SAVE_FOLDER)
				end
				writefile(VISITED_FILE, HttpService:JSONEncode(visited))
			end)
