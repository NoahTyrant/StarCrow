local function IsSpecialWeather(wName)
	local lower = string.lower(tostring(wName or ""))
	if lower == "" or lower == "clear" or lower == "sun" or lower == "sunny" or lower == "normal" then
		return false
	end
	if string.find(lower, "rain", 1, true)
		or string.find(lower, "thunder", 1, true)
		or string.find(lower, "storm", 1, true)
		or string.find(lower, "snow", 1, true)
		or string.find(lower, "frost", 1, true)
		or string.find(lower, "fog", 1, true)
		or string.find(lower, "mist", 1, true)
		or string.find(lower, "wind", 1, true)
		or string.find(lower, "eclipse", 1, true)
	then
		return true
	end
	return false
end

