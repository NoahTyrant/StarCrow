do
    local function HopLowServer()
        task.spawn(function()
            local placeId = game.PlaceId
            local curJobId = game.JobId
            local requestFn = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
            local targetServer = nil

            pcall(function()
                Fluent:Notify({
                    Title = "Server Hop",
                    Content = "Searching for low player server...",
                    Duration = 4
                })
            end)

            local cursor = ""
            local attempts = 0
            while attempts < 5 and not targetServer do
                attempts = attempts + 1
                local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end

                local raw = nil
                if requestFn then
                    local res = requestFn({ Url = url, Method = "GET" })
                    if res and res.Body then
                        raw = res.Body
                    end
                else
                    local ok, res = pcall(game.HttpGet, game, url)
                    if ok then raw = res end
                end

                if raw then
                    local data = nil
                    pcall(function() data = HttpService:JSONDecode(raw) end)
                    if data and data.data then
                        local servers = {}
                        for _, s in ipairs(data.data) do
                            if type(s) == "table" and s.id and s.id ~= curJobId then
                                local playing = tonumber(s.playing) or 0
                                local maxP = tonumber(s.maxPlayers) or 1
                                if playing < maxP and playing > 0 then
                                    table.insert(servers, s)
                                end
                            end
                        end
                        table.sort(servers, function(a, b)
                            return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
                        end)
                        if #servers > 0 then
                            targetServer = servers[1]
                            break
                        end
                        if data.nextPageCursor and data.nextPageCursor ~= "" then
                            cursor = data.nextPageCursor
                        else
                            break
                        end
                    else
                        break
                    end
                else
                    break
                end
                task.wait(0.5)
            end

            if targetServer and targetServer.id then
                pcall(function()
                    Fluent:Notify({
                        Title = "Server Hop",
                        Content = "Found server with " .. tostring(targetServer.playing) .. " players! Teleporting...",
                        Duration = 4
                    })
                end)
                task.wait(0.5)
                TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
            else
                pcall(function()
                    Fluent:Notify({
                        Title = "Server Hop",
                        Content = "Couldn't find low player server. Teleporting to random server...",
                        Duration = 4
                    })
                end)
                task.wait(0.5)
                TeleportService:Teleport(placeId, LocalPlayer)
            end
        end)
    end

    Tabs.Server:AddSection("Server")

    Tabs.Server:AddButton({
        Title = "Rejoin",
        Callback = function()
            pcall(function()
                Fluent:Notify({
                    Title = "Rejoin",
                    Content = "Rejoining current server...",
                    Duration = 3
                })
            end)
            task.wait(0.3)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end
    })

    Tabs.Server:AddButton({
        Title = "Server Hop Low Players",
        Callback = function()
            HopLowServer()
        end
    })

    Tabs.Server:AddSection("JobId")

    local targetJobId = ""

    Tabs.Server:AddInput("JobIdInput", {
        Title = "JobId",
        Default = "",
        Placeholder = "Enter JobId...",
        Finished = false,
        Callback = function(Value)
            targetJobId = tostring(Value or ""):gsub("%s+", "")
        end
    })

    Tabs.Server:AddButton({
        Title = "Join JobId",
        Callback = function()
            if targetJobId == "" then
                pcall(function()
                    Fluent:Notify({
                        Title = "Join JobId",
                        Content = "Please enter a valid JobId",
                        Duration = 3
                    })
                end)
                return
            end
            pcall(function()
                Fluent:Notify({
                    Title = "Join JobId",
                    Content = "Teleporting to " .. targetJobId .. "...",
                    Duration = 3
                })
            end)
            task.wait(0.3)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
        end
    })

    Tabs.Server:AddButton({
        Title = "Copy Current JobId",
        Callback = function()
            local currentJobId = tostring(game.JobId or "")
            local copied = false
            pcall(function()
                if setclipboard then
                    setclipboard(currentJobId)
                    copied = true
                elseif toclipboard then
                    toclipboard(currentJobId)
                    copied = true
                elseif syn and syn.write_clipboard then
                    syn.write_clipboard(currentJobId)
                    copied = true
                end
            end)
            pcall(function()
                Fluent:Notify({
                    Title = "Copy JobId",
                    Content = copied and ("Copied: " .. currentJobId) or ("JobId: " .. currentJobId),
                    Duration = 4
                })
            end)
        end
    })
end

