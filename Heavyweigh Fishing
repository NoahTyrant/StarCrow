local function SaveConfig()
	pcall(function()
		if not isfolder(SAVE_FOLDER) then
			makefolder(SAVE_FOLDER)
		end
		writefile(SAVE_FILE, HttpService:JSONEncode(Config))
	end)
end

local function LoadConfig()
	pcall(function()
		if isfile(SAVE_FILE) then
			local decoded = HttpService:JSONDecode(readfile(SAVE_FILE))
			for k, v in pairs(decoded) do
				if Config[k] ~= nil then
					Config[k] = v
				end
			end
			if not decoded.HideNameDefaultV2 then
				Config.HideNameAndID = true
				Config.HideNameDefaultV2 = true
			end
			if type(decoded.WebhookUrl) == "string" and decoded.WebhookUrl ~= "" then
				Config.WebhookUrl = decoded.WebhookUrl
			elseif type(decoded.BossWebhookUrl) == "string" and decoded.BossWebhookUrl ~= "" then
				Config.WebhookUrl = decoded.BossWebhookUrl
			elseif type(decoded.WeatherWebhookUrl) == "string" and decoded.WeatherWebhookUrl ~= "" then
				Config.WebhookUrl = decoded.WeatherWebhookUrl
			end
			Config.BossWebhookUrl = Config.WebhookUrl
			Config.WeatherWebhookUrl = Config.WebhookUrl
		end
	end)
end

