local function GetIslandFarmCFrame(islandKey)
	local key = islandKey or Config.SelectedFarmIsland or ""
	if IslandFarmPositions[key] then
		return IslandFarmPositions[key]
	end
	local cleanKey = tostring(key):gsub("%s*|%s*%d+", ""):gsub("^%s+", ""):gsub("%s+$", "")
	if IslandFarmPositions[cleanKey] then
		return IslandFarmPositions[cleanKey]
	end
	local lowerClean = string.lower(cleanKey)
	for name, cf in pairs(IslandFarmPositions) do
		local lName = string.lower(name)
		if
			lowerClean == lName
			or string.find(lowerClean, lName, 1, true)
			or string.find(lName, lowerClean, 1, true)
		then
			return cf
		end
	end
	return nil
end

local function GetWeatherIcon(weatherName)
	local lower = string.lower(tostring(weatherName or ""))
	if string.find(lower, "thunder") or string.find(lower, "storm") or string.find(lower, "lightning") then
		return "⛈️"
	elseif string.find(lower, "rain") then
		return "🌧️"
	elseif string.find(lower, "snow") or string.find(lower, "frost") or string.find(lower, "blizzard") then
		return "❄️"
	elseif string.find(lower, "fog") or string.find(lower, "mist") then
		return "🌫️"
	elseif string.find(lower, "wind") or string.find(lower, "tornado") or string.find(lower, "sand") then
		return "🌪️"
	elseif string.find(lower, "sun") or string.find(lower, "clear") then
		return "☀️"
	end
	return "🌤️"
end

