local lastSellTime = 0
local lastBuyBaitTime = 0
local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")

local function FindRemote(name)
	return Events:FindFirstChild(name) or (RemotesFolder and RemotesFolder:FindFirstChild(name))
end

local function FireOrInvokeEvent(ev, ...)
	if not ev then
		return false
	end
	local args = { ... }
	local ok = pcall(function()
		if ev:IsA("RemoteEvent") then
			ev:FireServer(unpack(args))
		elseif ev:IsA("RemoteFunction") then
			ev:InvokeServer(unpack(args))
		end
	end)
	return ok
end

local function DoBuyBait(baitName, amount)
	if not baitName or baitName == "" then
		return
	end
	local amt = math.max(1, math.floor(tonumber(amount) or 1))
	local buyEvent = FindRemote("BuyBait")
		or FindRemote("Bait")
		or FindRemote("PurchaseBait")
		or FindRemote("BaitShop")
		or FindRemote("BuyItem")
	if buyEvent then
		FireOrInvokeEvent(buyEvent, baitName, amt)
	else
		pcall(function()
			CraftBaitEvent:FireServer(baitName, amt)
		end)
	end
end

local function IsInventoryFull()
	local pData = PlayerData or (DataFolder and DataFolder:FindFirstChild(tostring(LocalPlayer.UserId)))
	if pData then
		local inv = pData:FindFirstChild("Inventory")
		local limitObj = pData:FindFirstChild("InventoryLimit")
			or pData:FindFirstChild("MaxInventory")
			or pData:FindFirstChild("BagLimit")
			or pData:FindFirstChild("MaxCapacity")
		local limit = limitObj and tonumber(limitObj.Value)
			or tonumber(pData:GetAttribute("InventoryLimit"))
			or tonumber(pData:GetAttribute("MaxInventory"))
		if inv and limit and limit > 0 then
			if #inv:GetChildren() >= limit then
				return true
			end
		end
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		local mg = pg:FindFirstChild("MainGui") or pg:FindFirstChild("ScreenGui") or pg:FindFirstChild("GameGui")
		if mg then
			for _, desc in ipairs(mg:GetDescendants()) do
				if desc:IsA("TextLabel") and desc.Visible then
					local cur, maxC = string.match(desc.Text, "(%d+)%s*/%s*(%d+)")
					if cur and maxC then
						local cNum = tonumber(cur)
						local mNum = tonumber(maxC)
						if cNum and mNum and mNum >= 10 and cNum >= mNum then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

