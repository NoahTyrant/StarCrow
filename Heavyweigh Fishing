		function DoServerHop(mode)
			if isHoppingServer then
				return
			end
			isHoppingServer = true
			task.spawn(function()
				local placeId = game.PlaceId
				local curJobId = tostring(game.JobId or "")
				local requestFn = (syn and syn.request)
					or (http and http.request)
					or http_request
					or (fluxus and fluxus.request)
					or request
				local targetServer = nil

				local isLow
				if mode == "random" then
					isLow = (math.random(1, 2) == 1)
				else
					isLow = (mode == "low")
				end
				local visited = LoadVisitedServers()
				SaveVisitedServers(visited)

				pcall(function()
					local desc = "Searching for a server..."
					if mode == "low" or (mode == "random" and isLow) then
						desc = "Searching for low player server..."
					elseif mode == "normal" or (mode == "random" and not isLow) then
						desc = "Searching for crowded server..."
					end
					Fluent:Notify({
						Title = "Server Hop",
						Content = desc,
						Duration = 4,
					})
				end)

				local cursor = ""
				local attempts = 0
				local maxAttempts = isLow and 10 or 5
				local sortOrder = isLow and "Asc" or "Desc"
				local allValidServers = {}

				while attempts < maxAttempts and not targetServer do
					attempts = attempts + 1
					local url = "https://games.roblox.com/v1/games/"
						.. tostring(placeId)
						.. "/servers/Public?sortOrder="
						.. sortOrder
						.. "&limit=100"
					if cursor ~= "" then
						url = url .. "&cursor=" .. cursor
					end

					local raw = nil
					if requestFn then
						local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
						if ok and res and res.Body then
							raw = res.Body
						end
					else
						local ok, res = pcall(game.HttpGet, game, url)
						if ok then
							raw = res
						end
					end

					if raw then
						local data = nil
						pcall(function()
							data = HttpService:JSONDecode(raw)
						end)
						if data and type(data.data) == "table" then
							local unvisitedServers = {}
							for _, s in ipairs(data.data) do
								if type(s) == "table" and s.id and tostring(s.id) ~= curJobId then
									local playing = tonumber(s.playing) or 0
									local maxP = tonumber(s.maxPlayers) or 1
									if playing < maxP and playing > 0 then
										table.insert(allValidServers, s)
										if not visited[tostring(s.id)] then
											table.insert(unvisitedServers, s)
										end
									end
								end
							end
							if isLow then
								if #unvisitedServers > 0 then
									table.sort(unvisitedServers, function(a, b)
										return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
									end)
									targetServer = unvisitedServers[1]
									break
								end
							else
								if #unvisitedServers > 0 then
									table.sort(unvisitedServers, function(a, b)
										return (tonumber(a.playing) or 0) > (tonumber(b.playing) or 0)
									end)
									local topCount = math.min(#unvisitedServers, 5)
									targetServer = unvisitedServers[math.random(1, topCount)]
									break
								end
							end
							if data.nextPageCursor and data.nextPageCursor ~= "" then
								cursor = data.nextPageCursor
							else
								break
							end
						else
							break
						end
					else
						break
					end
					task.wait(0.25)
				end

				if not targetServer and #allValidServers > 0 then
					visited = {}
					if curJobId ~= "" then
						visited[curJobId] = os.time()
					end
					SaveVisitedServers(visited)
					if isLow then
						table.sort(allValidServers, function(a, b)
							return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
						end)
						targetServer = allValidServers[1]
					else
						table.sort(allValidServers, function(a, b)
							return (tonumber(a.playing) or 0) > (tonumber(b.playing) or 0)
						end)
						local topCount = math.min(#allValidServers, 5)
						targetServer = allValidServers[math.random(1, topCount)]
					end
				end

				if targetServer and targetServer.id then
					visited[tostring(targetServer.id)] = os.time()
					SaveVisitedServers(visited)
					QueueReExecute()
					pcall(function()
						Fluent:Notify({
							Title = "Server Hop",
							Content = "Found server with "
								.. tostring(targetServer.playing)
								.. " players! Teleporting...",
							Duration = 4,
						})
					end)
					task.wait(0.3)
					pcall(function()
						TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
					end)
					task.wait(5)
					isHoppingServer = false
					if Config.AutoHopSacredBeast or Config.AutoHopWeather then
						DoServerHop(mode)
					end
				else
					QueueReExecute()
					pcall(function()
						Fluent:Notify({
							Title = "Server Hop",
							Content = "Teleporting to random server...",
							Duration = 4,
						})
					end)
					task.wait(0.3)
					pcall(function()
						TeleportService:Teleport(placeId, LocalPlayer)
					end)
					task.wait(5)
					isHoppingServer = false
				end
			end)
		end

