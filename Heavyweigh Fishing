local function ReadChuDialogueFromGui()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local mg = pg and pg:FindFirstChild("MainGui")
	local menu = mg and mg:FindFirstChild("Menu")
	local dialogue = menu and menu:FindFirstChild("Dialogue")
	if dialogue and dialogue.Visible then
		for _, desc in ipairs(dialogue:GetDescendants()) do
			if desc:IsA("TextLabel") and desc.Visible then
				local txt = tostring(desc.Text or ""):gsub("^%s*(.-)%s*$", "%1")
				if
					#txt > 3
					and not string.find(txt, "Close")
					and not string.find(txt, "Main Quest")
					and txt ~= "???"
					and not string.find(txt, "Chu Tianjiao")
				then
					return txt
				end
			end
		end
	end
	return nil
end

local function CheckChuTianjiaoDialogue(timeoutSec)
	local char = LocalPlayer.Character or cachedChar
	local hrp = (char and char:FindFirstChild("HumanoidRootPart")) or cachedHrp
	if hrp then
		hrp.CFrame = CFrame.new(-2569.92, 15.74, -1405.49, 0.28, -0.00, 0.96, 0.00, 1.00, 0.00, -0.96, 0.00, 0.28)
	end
	task.wait(0.2)
	local startWait = os.clock()
	local limit = timeoutSec or 3.5
	local resultText = ""
	local lastText = ""
	local stableCount = 0
	while (os.clock() - startWait) < limit do
		local guiText = ReadChuDialogueFromGui()
		if not guiText or guiText == "" then
			local prompt = GetChuPrompt()
			if prompt then
				TriggerChuPrompt(prompt)
			end
		else
			resultText = guiText
			local lower = string.lower(guiText)
			if
				string.find(lower, "isle!", 1, true)
				or string.find(lower, "approaching", 1, true)
				or string.find(lower, "don't have any quests", 1, true)
				or string.find(lower, "maybe you'll find", 1, true)
			then
				break
			end
			if guiText == lastText and #guiText > 10 then
				stableCount = stableCount + 1
				if stableCount >= 3 then
					break
				end
			else
				lastText = guiText
				stableCount = 0
			end
		end
		task.wait(0.1)
	end
	return (resultText ~= ""), resultText
end

local function GetSacredBeastIslandCFrame(dialogueText)
	if not dialogueText or dialogueText == "" then
		return nil, "Unknown"
	end
	local lower = string.lower(dialogueText)
	for name, cf in pairs(IslandFarmPositions) do
		local cleanName = tostring(name):gsub("%s*|%s*%d+", ""):gsub("^%s+", ""):gsub("%s+$", "")
		if string.find(lower, string.lower(cleanName), 1, true) then
			return cf, cleanName
		end
	end
	local sp = workspace:FindFirstChild("Spawnpoint")
	if sp then
		for _, child in ipairs(sp:GetChildren()) do
			if string.find(lower, string.lower(child.Name), 1, true) then
				if IslandFarmPositions[child.Name] then
					return IslandFarmPositions[child.Name], child.Name
				end
				local p = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart", true)
				if p then
					return p.CFrame + Vector3.new(0, 5, 0), child.Name
				end
			end
		end
	end
	for name, cf in pairs(IslandFarmPositions) do
		local cleanName = tostring(name):gsub("%s*|%s*%d+", ""):gsub("^%s+", ""):gsub("%s+$", "")
		local prefix = cleanName:gsub("%s+[Ii]sle$", "")
		if #prefix >= 4 and string.find(lower, string.lower(prefix), 1, true) and string.find(lower, "isle", 1, true) then
			return cf, cleanName
		end
	end
	local matchedIsle = string.match(dialogueText, "([%u][%w%s]-%s+[Ii]sle)%s*!")
		or string.match(dialogueText, "([%w]+%s+[Ii]sle)")
	if matchedIsle then
		return nil, matchedIsle
	end
	return nil, "Unknown"
end

local function IsSacredBeastAppeared(dialogueText)
	local lower = string.lower(dialogueText or "")
	if lower == "" then
		return false
	end
	if
		string.find(lower, "i can feel it", 1, true)
		or string.find(lower, "approaching", 1, true)
		or string.find(lower, "don't have any quests", 1, true)
		or string.find(lower, "maybe you'll find", 1, true)
	then
		return false
	end
	if not string.find(lower, "hurry", 1, true) then
		return false
	end
	local _, islandName = GetSacredBeastIslandCFrame(dialogueText)
	if islandName and islandName ~= "Unknown" then
		return true
	end
	return string.find(lower, "isle!", 1, true) ~= nil
end

