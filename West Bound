local function getDynamiteTarget()
    local cam = workspace.CurrentCamera
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local ray = Ray.new(cam.CFrame.Position, cam.CFrame.LookVector * 1000)
    local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, workspace.CurrentCamera})
    
    local targetPlr = nil
    
    if hit and hit.Parent and hit.Parent:FindFirstChild("Humanoid") then
        local p = Players:GetPlayerFromCharacter(hit.Parent)
        if p and p ~= LocalPlayer and p.Team and p.Team.Name ~= "Civilians" then
            if not (S.Config.DynamiteTeamCheck and LocalPlayer.Team and p.Team == LocalPlayer.Team) and
               not (S.Config.DynamiteFriendCheck and isFriend(p)) then
                targetPlr = p
            end
        end
    end

    if not targetPlr then
        local closestDist = math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Team and plr.Team.Name ~= "Civilians" then
                if S.Config.DynamiteTeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
                if S.Config.DynamiteFriendCheck and isFriend(plr) then continue end
                
                local enemyRoot = plr.Character.HumanoidRootPart
                local screenPos, onScreen = cam:WorldToViewportPoint(enemyRoot.Position)
                
                if onScreen then
                    local mouseDist = (Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if mouseDist < closestDist then
                        closestDist = mouseDist
                        targetPlr = plr
                    end
                end
            end
        end
    end
    
    if not targetPlr then
        local closestMag = math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Team and plr.Team.Name ~= "Civilians" then
                if S.Config.DynamiteTeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
                if S.Config.DynamiteFriendCheck and isFriend(plr) then continue end
                local mag = (root.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if mag < closestMag then
                    closestMag = mag
                    targetPlr = plr
                end
            end
        end
    end

    return targetPlr
end

workspace.ChildAdded:Connect(function(v)
    if v.Name == "DynamitePart" then
        task.wait()
        if not S.Config.DynamiteTargetEnabled then return end
        local target = getDynamiteTarget()
        if not target then return end
        local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        v.CanCollide = false
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = v
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 999999
        bg.Parent = v

        local startPos = v.Position
        local timeElapsed = 0

        
        
        

        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            timeElapsed = timeElapsed + dt
            if not S.Config.DynamiteTargetEnabled then
                if conn then conn:Disconnect() end
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
                return
            end
            if v and v.Parent and hrp and hrp.Parent then
                local dist = (hrp.Position - v.Position).Magnitude
                local timeToTarget = math.clamp(dist / 250, 0, 1)
                local targetPos = hrp.Position + Vector3.new(0, 1, 0) + (hrp.AssemblyLinearVelocity * timeToTarget)
                
                local dir = (targetPos - v.Position)
                bv.Velocity = dir.Unit * math.clamp(dir.Magnitude * 15, 100, 500)
                bg.CFrame = CFrame.new(v.Position, hrp.Position)
            else
                if conn then conn:Disconnect() end
            end
        end)
        
        v.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if conn then conn:Disconnect() end
                
            end
        end)
        
        task.delay(10, function()
            if conn and conn.Connected then
                conn:Disconnect()
            end
            
        end)
    end
end)

