local FastHealEnabled = S.Config.FastHealEnabled
local fastHealConnection

Tabs.Westbound:AddToggle("FastHeal", {
    Title = "Fast Heal", Default = S.Config.FastHealEnabled,
    Callback = function(v)
        FastHealEnabled = v
        S.Config.FastHealEnabled = v
        SaveConfig()
        if fastHealConnection then fastHealConnection:Disconnect() fastHealConnection = nil end
        
        local function updatePotions(state)
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, p in pairs(bp:GetChildren()) do
                    if p.Name == "Health Potion" and p:IsA("Tool") then p.ManualActivationOnly = state end
                end
            end
            local char = LocalPlayer.Character
            if char then
                for _, p in pairs(char:GetChildren()) do
                    if p.Name == "Health Potion" and p:IsA("Tool") then p.ManualActivationOnly = state end
                end
            end
        end

        if v then
            task.spawn(function()
                while FastHealEnabled do
                    task.wait(0.2)
                    updatePotions(true)
                end
            end)
            local canDrink = true
            fastHealConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local char = LocalPlayer.Character
                    if char then
                        local potion = char:FindFirstChild("Health Potion")
                        if potion then
                            local drinkRemote = potion:FindFirstChild("DrinkPotion")
                            if drinkRemote and canDrink then
                                canDrink = false
                                pcall(function() drinkRemote:InvokeServer() end)
                                
                                local hum = char:FindFirstChildOfClass("Humanoid")
                                local animator = hum and hum:FindFirstChildOfClass("Animator")
                                if animator then
                                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                        if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                                    end
                                    local animConn = animator.AnimationPlayed:Connect(function(track)
                                        if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                                    end)
                                    task.delay(0.5, function() animConn:Disconnect() end)
                                end

                                task.wait(1)
                                canDrink = true
                            end
                        end
                    end
                end
            end)
        else
            updatePotions(false)
        end
    end
})

