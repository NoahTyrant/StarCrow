Tabs.GunMod:AddButton({
    Title = "Gun Mods",
    Callback = function()
        local function shouldPatch(stat)
            local t = rawget(stat, "GunType")
            return t == "Pistol" or t == "Rifle"
        end

        local function isSniper(stat)
            return rawget(stat, "GunType") == "Sniper"
        end

        local function patchAll(stat)
            if type(stat) ~= "table" then return end
            pcall(function()
                if setreadonly then pcall(setreadonly, stat, false) end

                stat.FullReload = true
                stat.ReloadSpeed = 0.01
                stat.ReloadAnimationSpeed = 10

                stat.prepTime   = 0.04
                stat.equipTime  = 0.2
                stat.EquipDelay = 0.1

                if stat.FireRate   ~= nil then stat.FireRate   = 0.3 end
                if stat.fireRate   ~= nil then stat.fireRate   = 0.3 end
                if stat.FireDelay  ~= nil then stat.FireDelay  = 0.3 end
                if stat.RateOfFire ~= nil then stat.RateOfFire = 0.3 end

                stat.Spread = 0
                stat.HipFireAccuracy = 0
                stat.ZoomAccuracy = 0

                for key, value in pairs(stat) do
                    local lk = string.lower(key)
                    if lk ~= "camshakeresist" and (lk:find("recoil") or lk:find("kick") or lk:find("sway") or lk:find("shake")) then
                        if type(value) == "number" then stat[key] = 0
                        elseif type(value) == "boolean" then stat[key] = false end
                    end
                end

                stat.camShakeResist = math.huge
            end)
        end

        local function patchSniper(stat)
            if type(stat) ~= "table" then return end
            pcall(function()
                if setreadonly then pcall(setreadonly, stat, false) end

                stat.EquipDelay = 0.1
                stat.equipTime  = 0.2
                stat.ReloadSpeed = 1.2
                stat.ReloadAnimationSpeed = 2.4

                stat.ZoomAccuracy    = 0
                stat.HipFireAccuracy = 0

                for key, value in pairs(stat) do
                    local lk = string.lower(key)
                    if lk ~= "camshakeresist" and (lk:find("recoil") or lk:find("kick") or lk:find("sway") or lk:find("shake")) then
                        if type(value) == "number" then stat[key] = 0
                        elseif type(value) == "boolean" then stat[key] = false end
                    end
                end

                stat.camShakeResist = math.huge
            end)
        end

        pcall(function()
            local GunStats = require(ReplicatedStorage:WaitForChild("GunScripts"):WaitForChild("GunStats"))
            if GunStats.FanFirePrepTime ~= nil then
                if setreadonly then pcall(setreadonly, GunStats, false) end
                GunStats.FanFirePrepTime = 0.06
                if setreadonly then pcall(setreadonly, GunStats, true) end
            end
            for _, stat in pairs(GunStats) do
                if type(stat) == "table" then
                    if shouldPatch(stat) then
                        patchAll(stat)
                    elseif isSniper(stat) then
                        patchSniper(stat)
                    end
                end
            end
        end)

        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                if shouldPatch(v) then
                    patchAll(v)
                elseif isSniper(v) then
                    patchSniper(v)
                end
            end
        end

        Fluent:Notify({ Title = "Gun Mods", Content = "No Recoil  |  Fast Fire  |  Fast Reload  |  Fast Equip", Duration = 6 })
    end
})

