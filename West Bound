local iiHookedTables = {}

local function applyInstantInteractHook()
    for _, val in pairs(getgc(true)) do
        if type(val) == "table"
            and rawget(val, "ContextHoldFunc")
            and rawget(val, "SetUpContextHoldGui")
            and rawget(val, "ResetContextHoldGui")
            and not iiHookedTables[val]
        then
            if not rawget(val, "__OrigContextHold") then
                val.__OrigContextHold = val.ContextHoldFunc
            end
            local orig = val.__OrigContextHold
            val.ContextHoldFunc = function(self, p2, p3, p4, p5, p6, p7, p8, p9)
                if not S.Config.InstantInteract then
                    return orig(self, p2, p3, p4, p5, p6, p7, p8, p9)
                end
                return orig(self, p2, p3, p4, p5, (not p7) and 0.05 or p6, p7, p8, p9)
            end
            iiHookedTables[val] = true
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    table.clear(iiHookedTables)
    if S.Config.InstantInteract then applyInstantInteractHook() end
end)

