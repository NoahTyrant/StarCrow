do
    local itemsFolder = workspace:WaitForChild("Items", 9e9):WaitForChild("Items", 9e9)
    local itemConfig = { MaxDistance = 5000, FillTransparency = 0.8, OutlineTransparency = 0.2, DefaultColor = Color3.fromRGB(255, 255, 255) }
    local itemHighlights = {}
    local cleanupTick = tick()

    local function getItemColor(item)
        if not item then return itemConfig.DefaultColor end
        if item:IsA("BasePart") then return item.Color end
        if not item:IsA("Model") then return itemConfig.DefaultColor end
        if item.PrimaryPart and item.PrimaryPart.Transparency < 0.8 then
            local primaryName = item.PrimaryPart.Name:lower()
            if not primaryName:find("part") and not primaryName:find("handle") then return item.PrimaryPart.Color end
        end
        local bestPart = nil
        local bestScore = 0
        for _, obj in ipairs(item:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < 0.8 and obj.Size.Magnitude > 0.05 then
                local score = obj.Size.X * obj.Size.Y * obj.Size.Z
                local lowerName = obj.Name:lower()
                if lowerName:find("mesh") then score = score * 2 end
                if not lowerName:find("part") and not lowerName:find("handle") then score = score * 3 end
                if score > bestScore then
                    bestScore = score
                    bestPart = obj
                end
            end
        end
        return bestPart and bestPart.Color or itemConfig.DefaultColor
    end

    local function removeItemHighlight(item)
        if itemHighlights[item] then itemHighlights[item]:Destroy() itemHighlights[item] = nil end
    end

    local function createItemHighlight(item)
        if itemHighlights[item] then return end
        local oldH = item:FindFirstChild("ItemMansionESP")
        if oldH then oldH:Destroy() end
        local highlight = Instance.new("Highlight")
        local color = getItemColor(item)
        highlight.Name = "ItemMansionESP"
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = itemConfig.FillTransparency
        highlight.OutlineTransparency = itemConfig.OutlineTransparency
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = S.Config.ItemMansionESP
        if pcall(function() highlight.Parent = item end) then itemHighlights[item] = highlight end
    end

    local function updateItemHighlights()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not S.Config.ItemMansionESP then
            for _, highlight in pairs(itemHighlights) do highlight.Enabled = false end
            return
        end
        local rootPos = root.Position
        local maxDist = itemConfig.MaxDistance
        local candidates = {}
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if item.Parent then
                local pivot = item:GetPivot().Position
                local dist = (rootPos - pivot).Magnitude
                if dist <= maxDist then
                    table.insert(candidates, { item = item, dist = dist })
                end
            end
        end
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
        local activeSet = {}
        local count = math.min(#candidates, 60)
        for i = 1, count do
            local item = candidates[i].item
            activeSet[item] = true
            if not itemHighlights[item] then
                createItemHighlight(item)
            end
            if itemHighlights[item] then
                itemHighlights[item].Enabled = true
            end
        end
        for item, highlight in pairs(itemHighlights) do
            if not activeSet[item] then
                highlight.Enabled = false
            end
            if not item.Parent then
                removeItemHighlight(item)
            end
        end
        if tick() > cleanupTick then
            for item in pairs(itemHighlights) do if not item.Parent then itemHighlights[item] = nil end end
            cleanupTick = tick() + 5
        end
    end

    itemsFolder.ChildAdded:Connect(function(item)
        if S.Config.ItemMansionESP then
            task.wait(0.3)
            updateItemHighlights()
        end
    end)

    task.spawn(function()
        while true do
            if S.Config.ItemMansionESP then
                updateItemHighlights()
                task.wait(0.35)
            else
                task.wait(0.5)
            end
        end
    end)

    Tabs.ESP:AddToggle("ItemMansionESP", {
        Title = "ESP Jewelry",
        Default = S.Config.ItemMansionESP,
        Callback = function(v)
            S.Config.ItemMansionESP = v
            if not v then
                for _, highlight in pairs(itemHighlights) do highlight.Enabled = false end
            else
                task.spawn(updateItemHighlights)
            end
            SaveConfig()
        end
    })
end

