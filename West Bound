function InitSilentAimHook()
    if isSilentAimHooked then return end
    isSilentAimHooked = true

    local ok, CreateShotModule = pcall(function()
        return require(
            game:GetService("ReplicatedStorage")
                :WaitForChild("GunScripts")
                :WaitForChild("CreateShot")
        )
    end)
    if not ok then return end

    local origCreateShot = CreateShotModule.CreateShot
    CreateShotModule.CreateShot = function(data)
        if (S.Config.AimPlayer or S.Config.AimNPC) and currentTarget and data and data.cframe then
            local handlePos = data.cframe.Position
            local targetPos = currentTarget.Position
            local dir = (targetPos - handlePos).Unit
            data.cframe = CFrame.new(handlePos, handlePos + dir)
        end
        return origCreateShot(data)
    end
end

