local function CreateFloatButton(name, text, defaultPos, configKey)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, S.Config.FloatButtonSize, 0, S.Config.FloatButtonSize)

    local savedPos = S.Config[configKey]
    if type(savedPos) == "table" and #savedPos == 4 then
        btn.Position = UDim2.new(savedPos[1], savedPos[2], savedPos[3], savedPos[4])
    else
        btn.Position = defaultPos
    end

    btn.BackgroundColor3 = Color3.fromRGB(62, 62, 62)
    btn.BackgroundTransparency = 1
    btn.AutoButtonColor = false
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextScaled = true
    btn.TextWrapped = true
    btn.Visible = false
    btn.Parent = FloatGui

    local sizeConstraint = Instance.new("UITextSizeConstraint", btn)
    sizeConstraint.MaxTextSize = 16
    sizeConstraint.MinTextSize = 8

    local pad = Instance.new("UIPadding", btn)
    pad.PaddingTop = UDim.new(0.2, 0)
    pad.PaddingBottom = UDim.new(0.2, 0)
    pad.PaddingLeft = UDim.new(0.12, 0)
    pad.PaddingRight = UDim.new(0.12, 0)

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0.25, 0)
    local stroke = Instance.new("UIStroke", btn)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local dragging, moved, dragStart, startPos = false, false, nil, nil

    btn.InputBegan:Connect(function(input)
        if dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if moved then
                    S.Config[configKey] = {btn.Position.X.Scale, btn.Position.X.Offset, btn.Position.Y.Scale, btn.Position.Y.Offset}
                    SaveConfig()
                end
            end
        end
    end)

    local function checkMoved() return moved end
    local function resetMoved() moved = false end

    return btn, stroke, checkMoved, resetMoved
end

