local function IsTargetVisible(targetPart, myChar)
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {myChar, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction, params)
    return not (result and result.Instance and not result.Instance:IsDescendantOf(targetPart.Parent))
end

local function isFriend(player)
    if not S.Config.FriendCheck then return false end
    local userId = player.UserId
    if FriendCache[userId] ~= nil then return FriendCache[userId] end
    local success, result = pcall(function() return LocalPlayer:IsFriendsWith(userId) end)
    if success then FriendCache[userId] = result return result end
    return false
end

task.spawn(function()
    while task.wait(0.05) do
        local char = LocalPlayer.Character
        isHoldingGun = char and char:FindFirstChildOfClass("Tool") ~= nil

        if not (S.Config.AimPlayer or S.Config.AimNPC or S.Config.AimLasso) then currentTarget = nil continue end
        if not char or not char:FindFirstChild("HumanoidRootPart") then currentTarget = nil continue end
        if not isHoldingGun then currentTarget = nil continue end

        local tool = char:FindFirstChildOfClass("Tool")
        local isLasso = tool and (tool.Name:find("Lasso") or tool.Name:find("Throw"))

        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local bestTarget = nil
        local shortest = math.huge

        local function process(obj, isPlayer, isLassoReq)
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local targetPartName = "Head"
            if S.Config.AimPart == "Body" then targetPartName = "HumanoidRootPart" end
            local part = obj:FindFirstChild(targetPartName) or obj:FindFirstChild("Torso") or obj:FindFirstChild("LowerTorso") or obj:FindFirstChild("Head")
            if not hum or hum.Health <= 0 or not part then return end
            if isPlayer then
                local plr = Players:GetPlayerFromCharacter(obj)
                if not plr or plr == LocalPlayer then return end
                if S.Config.TeamCheck and plr.Team == LocalPlayer.Team then return end
                if S.Config.FriendCheck and isFriend(plr) then return end
                if not S.Config.AimCivilians and plr.Team and string.match(string.lower(plr.Team.Name), "civilian") then return end
            end
            if S.Config.WallCheck and not IsTargetVisible(part, char) then return end

            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then return end
            
            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if S.Config.FOVMode == "No FOV" or dist < S.Config.FOVRadius then
                if dist < shortest then
                    shortest = dist
                    bestTarget = part
                end
            end
        end

        if S.Config.AimPlayer or (S.Config.AimLasso and isLasso) then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then process(p.Character, true, isLasso) end
            end
        end

        if S.Config.AimNPC then
            local animalsFolder = workspace:FindFirstChild("Animals")
            if animalsFolder then
                for _, animal in ipairs(animalsFolder:GetChildren()) do process(animal, false, isLasso) end
            end
        end

        currentTarget = bestTarget
    end
end)

local function IsBagFull()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, desc in ipairs(playerGui:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Visible and string.find(desc.Text, "Bag:") then
                local current, max = string.match(desc.Text, "%$?(%d+)%s*/%s*%$?(%d+)")
                if current and max then
                    return tonumber(current) >= tonumber(max)
                end
            end
        end
    end
    return false
end

local function TriggerRob()
    local robRemote = ReplicatedStorage:WaitForChild("GeneralEvents", 9e9):WaitForChild("Rob", 9e9)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for i = 1, 10 do
        if not getgenv().StarCrowAutoBank then break end
        if IsBagFull() then break end
        local myPos = root.Position
        local targets = GetRobTargets()
        for _, target in ipairs(targets) do
            if target.part and target.part.Parent and (myPos - target.part.Position).Magnitude <= 30 then
                pcall(function()
                    if target.isSafe then
                        local r = target.obj:FindFirstChild("OpenSafe")
                        if r and r:IsA("RemoteEvent") then r:FireServer("Complete") end
                        robRemote:FireServer("Safe", target.obj)
                    else
                        robRemote:FireServer("Register", target.obj)
                    end
                end)
            end
        end
        task.wait(0.1)
    end
end

local function SpawnAndTP(spawnName, arg2, tpPos1, tpPos2)
    if not getgenv().StarCrowAutoBank then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum and hum.Health <= 0 then
        task.wait(math.max(0, getgenv().StarCrowSpawnDelay or 3))
    end

    local oldChar = LocalPlayer.Character
    local spawnArgs = {
        [1] = spawnName,
        [2] = arg2,
        [3] = false
    }

    ReplicatedStorage:WaitForChild("GeneralEvents", 9e9):WaitForChild("Spawn", 9e9):InvokeServer(unpack(spawnArgs))

    if oldChar then
        repeat task.wait(0.05)
        until (LocalPlayer.Character ~= oldChar and LocalPlayer.Character ~= nil) or not getgenv().StarCrowAutoBank
    end

    if not getgenv().StarCrowAutoBank then return end

    char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 9e9)
    hum = char:WaitForChild("Humanoid", 9e9)

    if root and hum then
        task.wait(1.5)

        if tpPos1 then
            if not getgenv().StarCrowAutoBank then return end
            char:PivotTo(CFrame.new(tpPos1))
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            TriggerRob()
        end

        if tpPos2 then
            if not getgenv().StarCrowAutoBank then return end
            if IsBagFull() then return end
            char:PivotTo(CFrame.new(tpPos2))
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            TriggerRob()
        end
    end
end

local function GetPlayerMoneyStat()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local bestStat = leaderstats:FindFirstChild("Cash")
                      or leaderstats:FindFirstChild("Money")
                      or leaderstats:FindFirstChild("Coins")
                      or leaderstats:FindFirstChild("Bounty")
                      or leaderstats:FindFirstChild("$$")
        if not bestStat then
            for _, stat in ipairs(leaderstats:GetChildren()) do
                if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                    bestStat = stat
                    break
                end
            end
        end
        return bestStat
    end
    return nil
end

