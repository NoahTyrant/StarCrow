local function ApplyLassoHook(lasso)
    if not lasso then return end
    local throwMod = lasso:FindFirstChild("ThrowLasso", true)
    if throwMod and throwMod:IsA("ModuleScript") then
        local t = require(throwMod)
        if type(t) == "table" and not t._scHooked then
            if t.LassoTouched then
                local orig = t.LassoTouched
                t.LassoTouched = function(p1, p2)
                    local victimPlr = game:GetService("Players"):GetPlayerFromCharacter(p2.Parent)
                    local isCiv = false
                    if S.Config.LassoTrollCivilians and victimPlr and victimPlr.Team == Civilians then
                        isCiv = true
                        victimPlr.Team = nil
                    end
                    local ret = orig(p1, p2)
                    if isCiv then
                        victimPlr.Team = Civilians
                    end
                    return ret
                end
            end
            if t.Throw then
                local origThrow = t.Throw
                t.Throw = function(p1, p2, ...)
                    if S.Config.AimLasso and currentTarget then
                        p2 = currentTarget.Position
                        task.spawn(function()
                            task.wait(0.15)
                            if t.LassoTouched then pcall(function() t.LassoTouched(p1, currentTarget) end) end
                        end)
                    end
                    return origThrow(p1, p2, ...)
                end
            end
            t._scHooked = true
        end
    end
end

