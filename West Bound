local AutoHealEnabled = S.Config.AutoHealEnabled
local function runAutoHeal()
    task.spawn(function()
        while AutoHealEnabled do
            task.wait(0.2)
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum.MaxHealth > 0 then
                local hpPercent = (hum.Health / hum.MaxHealth) * 100
                if hpPercent <= S.Config.AutoHealHealth then
                    local potion = char:FindFirstChild("Health Potion")
                    local prevTool = nil
                    if not potion then
                        for _, item in ipairs(char:GetChildren()) do
                            if item:IsA("Tool") and item.Name ~= "Health Potion" then
                                prevTool = item
                                break
                            end
                        end
                        local bp = LocalPlayer:FindFirstChild("Backpack")
                        local bpPotion = bp and bp:FindFirstChild("Health Potion")
                        if bpPotion then
                            hum:EquipTool(bpPotion)
                            task.wait(0.15)
                            potion = char:FindFirstChild("Health Potion")
                        end
                    end
                    if potion then
                        local drinkRemote = potion:FindFirstChild("DrinkPotion")
                        if drinkRemote then
                            task.spawn(function()
                                pcall(function() drinkRemote:InvokeServer() end)
                            end)
                            local animator = hum:FindFirstChildOfClass("Animator")
                            if animator then
                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                                end
                                local animConn = animator.AnimationPlayed:Connect(function(track)
                                    if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                                end)
                                task.delay(0.5, function() animConn:Disconnect() end)
                            end
                            task.wait(0.6)
                            if prevTool and prevTool.Parent == LocalPlayer:FindFirstChild("Backpack") and hum.Health > 0 then
                                hum:EquipTool(prevTool)
                            end
                            task.wait(0.2)
                        end
                    end
                end
            end
        end
    end)
end

if AutoHealEnabled then runAutoHeal() end

