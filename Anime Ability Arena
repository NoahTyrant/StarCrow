local function getPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

local function isWhitelisted(name)
    if not Config.Whitelist then return false end
    return Config.Whitelist[name] == true
end

local function getAutoKillTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or isInsideLobby(hrp) then return nil end
    if not LocalPlayer:GetAttribute("InGame") then return nil end

    local bestTarget = nil
    local bestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player:GetAttribute("InGame") and not isWhitelisted(player.Name) then
            local tChar = player.Character
            local lobbyModel = workspace:FindFirstChild("Lobby")
            if tChar and (not lobbyModel or not tChar:IsDescendantOf(lobbyModel)) then
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                if tHum and tHrp and tHum.Health > 0 and tHrp.Position.Y >= 350 and not isInsideLobby(tHrp) then
                    local dist = (tHrp.Position - hrp.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarget = tChar
                    end
                end
            end
        end
    end
    return bestTarget
end

local function executeAttackBehind(target)
    if not target then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and hrp and hum and hum.Health > 0) then return end

    local tHum = target:FindFirstChildOfClass("Humanoid")
    local tHrp = target:FindFirstChild("HumanoidRootPart")
    if tHum and tHrp and tHum.Health > 0 and tHrp.Position.Y >= 350 and not isInsideLobby(tHrp) then
        local targetPos = tHrp.Position
        local behindPos = targetPos - (tHrp.CFrame.LookVector * 2.2)
        hrp.CFrame = CFrame.lookAt(behindPos, targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local aid = getPrimaryAbilityId()
        if aid and AbilityControllerMod then
            pcall(function()
                if CasterBusyMod then CasterBusyMod.Release() end
                AbilityControllerMod.Activate(aid)
            end)
        end
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not Config.ClickKillPlayer then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mouse = LocalPlayer:GetMouse()
        local target = mouse and mouse.Target
        if target then
            local model = target:FindFirstAncestorOfClass("Model")
            if model and model ~= LocalPlayer.Character then
                local player = Players:GetPlayerFromCharacter(model)
                if player and not isWhitelisted(player.Name) then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 and not isInsideLobby(hrp) then
                        singleTargetChar = model
                    end
                end
            end
        end
    end
end)

task.spawn(function()
